import "../control/host.flex";
import "../control/progress-guard.flex";
fn main(argc,argv) {
    vc_init(argc,argv);let state=alloc(72);
    vc_require(!vg_init(state,0,0,3,2),"zero idle limit accepted");
    vc_require(vg_init(state,0,5,3,2),"guard init failed");
    vc_require(!vg_step(state,4,0,1,0),"recovery started before idle limit");
    vc_require(vg_step(state,5,0,1,0)==1,"idle guard did not request recovery");
    vc_require(vg_step(state,7,0,1,0)==2,"recovery deadline ended early");
    vc_require(vg_step(state,8,0,1,0)==3 && load64(state+32)==4,"timeout did not stop active recovery");
    vg_init(state,0,5,3,2);vc_require(vg_step(state,5,0,1,0)==1,"recovery absent");
    vc_require(!vg_step(state,7,0,1,2),"acknowledged failed recovery did not return to observation");
    vc_require(vg_step(state,12,0,1,0)==1,"second recovery was not requested");
    vc_require(vg_step(state,13,0,1,2)==3 && load64(state+32)==2,"exhausted recovery did not stop and report");
    vc_require(vg_step(state,14,1,1,0)==3,"stopped guard was silently reset");
    vg_init(state,0,5,3,2);vc_require(vg_step(state,5,0,1,0)==1,"recovery absent");
    vc_require(!vg_step(state,6,0,1,1) && load64(state+16)==1 && load64(state+64)==0,"recovery completion counted as task progress");
    vc_require(!vg_step(state,7,1,1,0) && !load64(state+16) && load64(state+64)==7,"pickup did not reset recovery budget");
    vc_require(vg_step(state,8,0,0,0)==3 && load64(state+32)==1,"sensor fault did not stop and report");
    vg_init(state,10,5,3,2);vc_require(vg_step(state,9,0,1,0)==3 && load64(state+32)==3,"backward clock accepted");
    vg_init(state,0,5,3,2);vc_require(vg_step(state,1,0,1,1)==3 && load64(state+32)==3,"unexpected recovery result accepted");
    vg_init(state,0,5,3,1);vc_require(vg_step(state,5,0,1,0)==1,"single recovery was not requested");
    vc_require(vg_step(state,8,0,1,0)==3 && load64(state+32)==4,"last recovery timeout did not stop");
    vg_init(state,0,5,3,2);vc_require(vg_step(state,5,0,1,0)==1,"sensor test recovery absent");
    vc_require(vg_step(state,6,0,0,0)==3 && load64(state+32)==1,"sensor fault during recovery did not stop");
    vg_init(state,0,5,3,2);vc_require(vg_step(state,5,0,1,0)==1,"progress test recovery absent");
    vc_require(vg_step(state,6,1,1,0)==3 && load64(state+32)==5,"unacknowledged recovery was abandoned on progress");
    vg_init(state,0,5,3,2);vc_require(vg_step(state,5,0,1,0)==1,"acknowledgement test recovery absent");
    vc_require(!vg_step(state,6,1,1,1) && !load64(state+16) && load64(state+64)==6,"acknowledged progress did not reset guard");
    vg_init(state,0,5,3,2);vc_require(vg_step(state,5,0,1,0)==1,"deadline test recovery absent");
    vc_require(vg_step(state,8,1,1,1)==3 && load64(state+32)==4,"late acknowledgement bypassed recovery timeout");
    vg_init(state,0,5,3,1);vc_require(vg_step(state,5,0,1,0)==1,"last recovery absent");
    vc_require(!vg_step(state,6,0,1,1) && load64(state+16)==1 && !load64(state+64),"completed recovery counted as task progress");
    vc_require(!vg_step(state,10,0,1,0),"observation interval ended early");
    vc_require(vg_step(state,11,0,1,0)==3 && load64(state+32)==2,"exhausted guard started another recovery");
    vg_init(state,0,5,3,1);vc_require(vg_step(state,5,0,1,0)==1,"progress after recovery test absent");
    vc_require(!vg_step(state,6,0,1,1) && !vg_step(state,7,1,1,0) && !load64(state+16),"verified progress did not reset the exhausted budget");
    pl_print(1,"Progress guard state machine checks passed.\n");return 0;
}

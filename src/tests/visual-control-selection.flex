// Real optimizer steps must retain the initial warm checkpoint when validation worsens.
import "../control/host.flex";
fn vs_data(path,opposed) {
    let size=32+2*21224;let data=alloc(size);vc_copy(data,"PVDATA03",8);store64(data+8,2);store64(data+16,1);store64(data+24,1);let episode=0;
    while episode<2 {let row=data+32+episode*21224+21168;pb_put32(row+32,0x3f800000);pb_put32(row+36,0x3f800000);pb_put32(row+40,0x3f800000);pb_put32(row+44,0x3f800000);pb_put32(row+52,0x3f800000);if episode && opposed {pb_put32(row+32,0xbf800000);pb_put32(row+36,0);pb_put32(row+52,0xbf800000);}episode=episode+1;}
    vc_write(path,data,size);syscall(11,data,size,0,0,0,0);return 0;
}
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==4,"visual-control-selection TRAINER KERNELS NEW_OUTPUT");let trainer=vc_absolute(load64(argv+8));let kernels=vc_absolute(load64(argv+16));let output=vc_absolute(load64(argv+24));vc_mkdir(output);let seed=alloc(32);vc_copy(seed,"PUPV0001",8);store64(seed+16,32);let seed_path=vc_path(output,"seed.bin");vc_write(seed_path,seed,32);let previous_update=0;let previous_gradient=0;let variant=0;
    while variant<2 {let name="improves";if variant {name="regresses";}let directory=vc_path(output,name);vc_mkdir(directory);let path=vc_path(directory,"data.bin");vs_data(path,variant);let args=vc_args();vc_add(args,trainer);vc_add(args,seed_path);vc_add(args,vc_file_sha(seed_path));vc_add(args,kernels);vc_add(args,path);vc_add(args,directory);vc_add(args,"1");vc_add(args,"1");vc_add(args,"1000");vc_add(args,"7");if !variant {vc_add(args,"--random");}vc_add(args,"--categorical");vc_add(args,"--checkpoint-every");vc_add(args,"1");vc_finish(vc_spawn(args,vc_path(directory,"training.log"),0,0),30000);
        let text=vc_text_file(vc_path(directory,"curves.jsonl"));let n=pl_size(text);let split=0;while split<n && load8(text+split)!=10 {split=split+1;}let first=pj_parse(text,split);vc_require(first && vc_json_int(first,"epoch",0)==0 && pj_boolean(first,"selected"),"initial checkpoint is not a validation candidate");let initial_loss=pj_real(first,"validationLoss");let next=split+1;let end=next;while end<n && load8(text+end)!=10 {end=end+1;}let last=pj_parse(text+next,end-next);vc_require(last && end+1==n && vc_json_int(last,"epoch",0)==1,"selection fixture did not finish one optimizer epoch");let later_loss=pj_real(last,"validationLoss");let selected=pj_boolean(last,"selected");
        let initial=vc_file_sha(vc_path(directory,"initial.bin"));let weights=vc_file_sha(vc_path(directory,"weights.bin"));let update=vc_file_sha(vc_path(directory,"first-after.bin"));let gradient=vc_file_sha(vc_path(directory,"first-gradients.bin"));vc_require(!pl_equal(initial,update) && pl_equal(update,vc_file_sha(vc_path(directory,"last.bin"))) && pl_equal(update,vc_file_sha(vc_path(directory,"epoch-1.bin"))),"optimizer progress or periodic checkpoints changed");
        if !variant {vc_require(f64_lt(later_loss,initial_loss) && selected && pl_equal(weights,update),"improved checkpoint was not selected");previous_update=update;previous_gradient=gradient;seed_path=vc_path(directory,"initial.bin");}
        else {vc_require(f64_gt(later_loss,initial_loss) && !selected && pl_equal(weights,initial),"worse warm-start checkpoint replaced the initial model");vc_require(pl_equal(update,previous_update) && pl_equal(gradient,previous_gradient),"validation labels affected the optimizer update");}
        variant=variant+1;
    }
    vc_save_text(vc_path(output,"result.json"),"{\"passed\":true,\"runtime\":\"Flexscript/Pup CUDA\",\"pythonRequired\":false,\"initialCheckpointParticipatesInSelection\":true,\"improvedCheckpointSelected\":true,\"regressingWarmStartRetainsInitialWeights\":true,\"optimizerAndPeriodicCheckpointsUnaffected\":true,\"validationLabelsDoNotAffectGradients\":true}\n");return 0;
}

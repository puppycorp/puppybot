// Compare an existing 84x84 policy binary with a rebuilt protocol service.
import "../control/verify.flex";
fn pv_spawn(binary,weights,sha,kernels,log) {
    let args=vc_args();vc_add(args,binary);vc_add(args,weights);vc_add(args,sha);vc_add(args,kernels);vc_add(args,"3");vc_add(args,"--raw");let process=vc_spawn(args,log,0,1);let magic=alloc(8);vc_io(1,load64(process+8),magic,8);vc_require(load64(magic)==load64("VCPRAW01"),"84x84 raw handshake changed");return process;
}
fn main(argc,argv) {
    vc_init(argc,argv);vc_pixels_init();vc_require(argc==5,"protocol-parity OLD_POLICY NEW_BINARY RECORDED_RUN NEW_OUTPUT");let policy=vc_absolute(load64(argv+8));let binary=vc_absolute(load64(argv+16));let run=vc_absolute(load64(argv+24));let output=vc_absolute(load64(argv+32));vc_mkdir(output);let meta=vc_json_file(vc_path(policy,"receipt.json"));let sha=vc_string(pj_string_field(meta,"weightsSHA256"));let weights=vc_path(policy,"weights.bin");let kernels=vc_path(policy,"kernels");vc_require(pl_equal(vc_file_sha(weights),sha) && pl_equal(vc_file_sha(vc_path(policy,"policy")),pj_string_field(meta,"binarySHA256")) && !pj_boolean(meta,"taskFeedback"),"existing policy receipt mismatch");let old=pv_spawn(vc_path(policy,"policy"),weights,sha,kernels,vc_path(output,"old.log"));let next=pv_spawn(binary,weights,sha,kernels,vc_path(output,"new.log"));let compare=ffi_symbol(ffi_open("libc.so.6"),"memcmp");vc_require(compare,"memcmp unavailable");let input=alloc((21168+7+128)*4);let a=alloc(135*4);let b=alloc(135*4);let hidden=alloc(512);pb_zero(hidden,512);let initial=vc_json_file(vc_path(run,"initial.json"));let frame=vc_json_int(initial,"totalSteps",0);va_lines(vc_path(run,"decisions.jsonl"));let row=va_next();let t=0;
    while row && t<20 {let rgb=vc_map(vc_path(run,vc_concat("actor-",vc_concat(vc_int(frame),".rgb"))));vc_require(vc_size==21168,"invalid recorded RGB");let own=vc_map(vc_path(run,vc_concat("actor-",vc_concat(vc_int(frame),".feedback"))));vc_require(vc_size==28 && !pb_u32(own+24),"invalid recorded feedback");vc_policy_input(rgb,own,hidden,input,0);vc_io(0,load64(old+8),input,(21168+7+128)*4);vc_io(1,load64(old+8),a,135*4);vc_io(0,load64(next+8),input,(21168+7+128)*4);vc_io(1,load64(next+8),b,135*4);vc_require(!ffi_call(compare,a,b,135*4,0,0,0),"rebuilt 84x84 protocol output differs");vc_copy(hidden,a+28,512);syscall(11,rgb,21168,0,0,0,0);syscall(11,own,28,0,0,0,0);frame=vc_json_int(row,"step",0);t=t+1;row=va_next();}
    vc_require(t==20,"recorded history too short");vc_finish(old,15000);vc_finish(next,15000);let text=alloc(1024);let builder=alloc(32);pl_builder(builder,text,1024);pl_text(builder,"{\"passed\":true,\"frames\":20,\"weightsSHA256\":");pj_text(builder,sha);pl_text(builder,",\"newBinarySHA256\":");pj_text(builder,vc_file_sha(binary));pl_text(builder,",\"rawHandshakeUnchanged\":true,\"logitsAndMemoryBitIdentical\":true,\"taskEventHintAbsent\":true}\n");vc_require(!load64(builder+24),"protocol parity report overflow");vc_write(vc_path(output,"result.json"),text,load64(builder+8));return 0;
}

// A batch with no visible-target candidates must seed no auxiliary gradient.
import "../control/host.flex";
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==2 || (argc==3 && (pl_equal(load64(argv+16),"--heat") || pl_equal(load64(argv+16),"--merge"))),"target-zero CHECKPOINT [--heat|--merge]");let heat=argc==3 && pl_equal(load64(argv+16),"--heat");let merge=argc==3 && pl_equal(load64(argv+16),"--merge");let data=vc_map(vc_absolute(load64(argv+8)));let bytes=vc_size;vc_require(bytes>=32 && load64(data)==load64("PUPV0001") && load64(data+16)==32+load64(data+8)*256 && load64(data+16)<=bytes,"invalid gradient checkpoint");let found=0;let i=0;while i<load64(data+8) {let row=data+32+i*256;let match=pl_equal(row,"critic.target.weight_T") || pl_equal(row,"critic.target.bias");if heat {match=pl_equal(row,"critic.heat.weight") || pl_equal(row,"critic.heat.bias");}if merge {match=pl_equal(row,"visual.merge.weight_T") || pl_equal(row,"visual.merge.bias");}if match {let count=load64(row+200);let offset=load64(row+208);vc_require(count>0 && offset>=0 && offset+count*4<=bytes-load64(data+16),"invalid target gradient tensor");let j=0;while j<count {let value=pb_read_float(data+load64(data+16)+offset+j*4);vc_require(f64_is_finite(value) && !f64_magnitude(value),"selected checkpoint tensor is nonzero");j=j+1;}found=found+1;}i=i+1;}vc_require(found==2,"target gradient tensors missing");return 0;
}

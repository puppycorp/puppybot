// Test burn-in semantics with real native packing and optimizer steps.
import "../control/dataset.flex";
global vdt_phase_from_valid=0;
fn vdt_data(path,variant) {
    let length=5;let row_bytes=48;let format="PVDATA02";if variant>=3 {row_bytes=56;format="PVDATA03";}let size=32+2*length*(21168+row_bytes);let data=alloc(size);vc_copy(data,format,8);store64(data+8,2);store64(data+16,1);store64(data+24,length);let episode=0;
    while episode<2 {let base=data+32+episode*length*(21168+row_bytes);let t=0;while t<3 {let i=0;while i<21168 {let value=(i*17+t*31+episode*7)%251;if variant==2 && !episode && !t {value=255-value;}store8(base+t*21168+i,value);i=i+1;}
            let row=base+length*21168+t*row_bytes;pb_put32(row,pb_f64_to_f32(vc_number(t,10)));pb_put32(row+28,0x3e4ccccd);pb_put32(row+32,0x3f19999a);if t {pb_put32(row+40,0x3f800000);}pb_put32(row+44,0x3f800000);
            if variant>=3 {pb_put32(row+48,0xbf000000);pb_put32(row+52,0xbf400000);}if variant==4 && t==1 {pb_put32(row+28,0xbf19999a);}
            if variant==1 && !t {pb_put32(row+28,0xbf4ccccd);pb_put32(row+32,0xbf19999a);if !vdt_phase_from_valid {pb_put32(row+36,0x3f800000);}}if variant==5 && !t {pb_put32(row+36,0x3f800000);}t=t+1;
        }episode=episode+1;}
    vc_write(path,data,size);syscall(11,data,size,0,0,0,0);return 0;
}
fn vdt_contains(text,part) {let i=0;while load8(text+i) {if pl_starts(text+i,part) {return 1;}i=i+1;}return 0;}
fn vdt_audit_guards(control,run,path,output) {
    control=vc_absolute(control);run=vc_absolute(run);output=vc_absolute(output);vc_mkdir(output);let source=vc_map(path);let bytes=vc_size;vc_require(vd_row_bytes(source)==56,"audit guards require separate oracle and executed actions");let data=alloc(bytes);vc_copy(data,source,bytes);syscall(11,source,bytes,0,0,0,0);let first=32+load64(data+24)*21168;let variant=0;
    while variant<2 {let name="target";let offset=first+28;let message="supervised correction differs from the oracle label";if variant {name="executed";offset=first+48;message="dataset executed actions differ from the recorded commands";}
        pb_put32(data+offset,pb_u32(data+offset)^1);let candidate=vc_path(output,vc_concat(name,".bin"));vc_write(candidate,data,bytes);pb_put32(data+offset,pb_u32(data+offset)^1);let audit=vc_path(output,vc_concat(name,"-audit"));let log=vc_path(output,vc_concat(name,".log"));let args=vc_args();vc_add(args,control);vc_add(args,"verify-data");vc_add(args,"--run");vc_add(args,run);vc_add(args,"--data");vc_add(args,candidate);vc_add(args,"--output");vc_add(args,audit);let process=vc_spawn(args,log,0,0);let status=vc_reap(process,60000);
        vc_require(status>0 && vdt_contains(vc_text_file(log),message),"tampered oracle/executed action was not independently rejected");vc_require(syscall(21,vc_path(audit,"result.json"),4,0,0,0,0),"tampered data published an audit success receipt");variant=variant+1;
    }
    vc_save_text(vc_path(output,"result.json"),"{\"passed\":true,\"runtime\":\"Flexscript\",\"pythonRequired\":false,\"tamperedOracleTargetRejected\":true,\"tamperedExecutedActionRejected\":true}\n");pl_print(1,"Native oracle target and executed-action audit guards passed.\n");return 0;
}
fn main(argc,argv) {
    vc_init(argc,argv);if argc==6 && pl_equal(load64(argv+8),"--audit-recording") {return vdt_audit_guards(load64(argv+16),load64(argv+24),load64(argv+32),load64(argv+40));}
    vc_require(argc==5 || (argc==6 && (pl_equal(load64(argv+40),"--event-aux") || pl_equal(load64(argv+40),"--phase-from-valid"))),"visual-control-data CONTROL TRAINER KERNELS OUTPUT [--event-aux|--phase-from-valid], or --audit-recording CONTROL RUN DATA OUTPUT");let event_aux=argc==6 && pl_equal(load64(argv+40),"--event-aux");if argc==6 {vdt_phase_from_valid=pl_equal(load64(argv+40),"--phase-from-valid");}let control=vc_absolute(load64(argv+8));let trainer=vc_absolute(load64(argv+16));let kernels=vc_absolute(load64(argv+24));let output=vc_absolute(load64(argv+32));vc_mkdir(output);
    let seed=alloc(32);vc_copy(seed,"PUPV0001",8);store64(seed+16,32);let seed_path=vc_path(output,"seed.bin");vc_write(seed_path,seed,32);let sha=vc_file_sha(seed_path);let weights=0;let gradients=0;let variant=0;
    while variant<5+vdt_phase_from_valid {let name=vc_int(variant);let source=vc_path(output,vc_concat("source-",vc_concat(name,".bin")));vdt_data(source,variant);let packed=vc_path(output,vc_concat("packed-",name));let args=vc_args();vc_add(args,control);vc_add(args,"pack-data");vc_add(args,"--data");vc_add(args,source);vc_add(args,"--output");vc_add(args,packed);vc_finish(vc_spawn(args,vc_path(output,vc_concat("pack-",vc_concat(name,".log"))),0,0),30000);
        let data=vc_map(vc_path(packed,"data.bin"));let row_bytes=48;if variant>=3 {row_bytes=56;}vc_require(load64(data+24)==3 && vd_row_bytes(data)==row_bytes && load8(data+32)==255*(variant==2) && pb_u32(data+32+3*21168+40)==0 && pb_u32(data+32+3*21168+44)==0x3f800000,"packing changed the burn-in input or its masks");if variant>=3 {vc_require(pb_u32(data+32+3*21168+48)==0xbf000000 && pb_u32(data+32+3*21168+52)==0xbf400000,"packing lost the separately executed action");}syscall(11,data,vc_size,0,0,0,0);
        let trained=vc_path(output,vc_concat("trained-",name));vc_mkdir(trained);args=vc_args();vc_add(args,trainer);vc_add(args,seed_path);vc_add(args,sha);vc_add(args,kernels);vc_add(args,vc_path(packed,"data.bin"));vc_add(args,trained);vc_add(args,"1");vc_add(args,vc_int(1+vdt_phase_from_valid));vc_add(args,"100");vc_add(args,"7");vc_add(args,"--random");if event_aux {vc_add(args,"--event-aux");}if vdt_phase_from_valid {vc_add(args,"--phase-from-valid");}if !variant {vc_add(args,"--checkpoint-every");vc_add(args,"1");}vc_finish(vc_spawn(args,vc_path(trained,"training.log"),0,0),30000);
        let checkpoint=vc_file_sha(vc_path(trained,"first-after.bin"));let gradient=vc_file_sha(vc_path(trained,"first-gradients.bin"));if !variant {weights=checkpoint;gradients=gradient;vc_require(pl_equal(checkpoint,vc_file_sha(vc_path(trained,"epoch-1.bin"))) && pl_equal(checkpoint,vc_file_sha(vc_path(trained,"last.bin"))),"periodic epoch snapshot differs from the completed optimizer state");}if variant==1 {vc_require(pl_equal(weights,checkpoint) && pl_equal(gradients,gradient),"unsupervised student labels changed the optimizer update");}if variant==2 {vc_require(!pl_equal(gradients,gradient),"burn-in image did not influence future supervised gradients");}if variant==3 {vc_require(pl_equal(weights,checkpoint) && pl_equal(gradients,gradient),"separately recorded executed actions changed training inputs or targets");}if variant==5 {vc_require(!pl_equal(gradients,gradient),"valid burn-in phase label did not influence auxiliary gradients");}if variant==4 {vc_require(!pl_equal(gradients,gradient),"dense oracle target did not influence supervised gradients");}variant=variant+1;
    }
    if vdt_phase_from_valid {vc_save_text(vc_path(output,"result.json"),"{\"passed\":true,\"runtime\":\"Flexscript/Pup CUDA\",\"pythonRequired\":false,\"phaseFromValidFrames\":true,\"maskedControlTargetsDoNotChangeGradientsOrWeights\":true,\"validBurninPhaseTargetsAffectGradients\":true,\"burninImagesInfluenceFutureSupervisedGradients\":true,\"separatelyExecutedCommandsAreNotTrainingInputs\":true,\"denseOracleTargetsAffectGradients\":true}\n");}else {vc_save_text(vc_path(output,"result.json"),"{\"passed\":true,\"runtime\":\"Flexscript/Pup CUDA\",\"pythonRequired\":false,\"burninPreservedByPacking\":true,\"unsupervisedLabelsDoNotChangeGradientsOrWeights\":true,\"burninImagesInfluenceFutureSupervisedGradients\":true,\"separatelyExecutedCommandsAreNotTrainingInputs\":true,\"denseOracleTargetsAffectGradients\":true}\n");}pl_print(1,"Native burn-in data and optimizer contracts passed.\n");return 0;
}

// Compare the 128x128 policy service with CPU Pup execution on recorded RGB.
import "../control/host.flex";
import "../ml/runtime.flex";
import "../../build/flex/pixel-control-categorical-heat-128-model.flex";
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==6,"highres-infer-tests POLICY WEIGHTS KERNELS DATA OUTPUT");let policy=vc_absolute(load64(argv+8));let weights=vc_absolute(load64(argv+16));let kernels=vc_absolute(load64(argv+24));let data=vc_map(vc_absolute(load64(argv+32)));let bytes=vc_size;let n=load64(data+8);let fit=load64(data+16);let length=load64(data+24);vc_require(load64(data)==load64("PVDAT128") && n>=2 && fit>=1 && fit<n && length>=1 && length<=512 && bytes==32+n*length*(49152+56),"invalid high-resolution data");let values=data+32+length*49152;vc_require(pb_u32(values+44)==0x3f800000 && !pb_u32(values+24),"invalid first observation");let output=vc_absolute(load64(argv+40));vc_mkdir(output);let sha=vc_file_sha(weights);let args=vc_args();vc_add(args,policy);vc_add(args,weights);vc_add(args,sha);vc_add(args,kernels);vc_add(args,"3");vc_add(args,"--raw");let process=vc_spawn(args,vc_path(output,"policy.log"),0,1);let magic=alloc(8);vc_io(1,load64(process+8),magic,8);vc_require(load64(magic)==load64("VCR12801"),"high-resolution policy handshake mismatch");
    vp_init(kernels,0,0);vp_checkpoint_open(weights,sha);pup_build_model();vc_require(load64(vp_inputs)==3 && load64(vp_outputs)==2 && vp_dim(vp_input,2)==128 && vp_dim(vp_input,3)==128 && load64(vp_at(vp_outputs,0)+8)==7 && load64(vp_at(vp_outputs,1)+8)==128,"unexpected CPU graph shape");let input=alloc((49152+7+128)*4);let gpu=alloc(135*4);let cpu=alloc(135*4);let first=alloc(135*4);let compare=ffi_symbol(ffi_open("libc.so.6"),"memcmp");vc_require(compare,"memcmp unavailable");let maximum=0;let camera=0;let pass=0;
    while pass<3 {let i=0;while i<49152 {let value=0;if pass!=1 {value=load8(data+32+i);}pb_put32(input+i*4,pb_f64_to_f32(vc_number(value,255)));i=i+1;}vc_copy(input+49152*4,values,28);pb_zero(input+(49152+7)*4,128*4);vc_io(0,load64(process+8),input,(49152+7+128)*4);vc_io(1,load64(process+8),gpu,135*4);let offset=0;i=0;while i<3 {let tensor=vp_at(vp_at(vp_inputs,i),1);let size=load64(tensor+8)*4;vc_copy(load64(tensor),input+offset,size);offset=offset+size;i=i+1;}vp_execute();vp_read_tensor(vp_at(vp_outputs,0),cpu);vp_read_tensor(vp_at(vp_outputs,1),cpu+28);i=0;while i<135 {let a=pb_read_float(gpu+i*4);let b=pb_read_float(cpu+i*4);let error=f64_magnitude(f64_sub(a,b));vc_require(f64_is_finite(a) && f64_is_finite(b) && f64_lt(error,vc_number(1,10000)),"128x128 GPU output differs from CPU reference");maximum=pb_fmax(maximum,error);if pass==1 && i<7 {camera=pb_fmax(camera,f64_magnitude(f64_sub(a,pb_read_float(first+i*4))));}i=i+1;}if !pass {vc_copy(first,gpu,135*4);}if pass==2 {vc_require(!ffi_call(compare,first,gpu,135*4,0,0,0),"128x128 policy reset is not bit-identical");}pass=pass+1;}
    vc_require(f64_gt(camera,vc_number(1,1000000000)),"128x128 policy output ignores image pixels");vc_finish(process,15000);let text=alloc(1024);let b=alloc(32);pl_builder(b,text,1024);pl_text(b,"{\"passed\":true,\"runtime\":\"Flexscript/Pup CUDA\",\"imageWidth\":128,\"rawHandshakeDistinct\":true,\"cpuReferenceMaxAbsError\":");pl_float(b,maximum);pl_text(b,",\"cameraLogitMaxDelta\":");pl_float(b,camera);pl_text(b,",\"resetBitIdentical\":true,\"taskEventHintAbsent\":true,\"episodePerformanceNotTested\":true}\n");vc_require(!load64(b+24),"high-resolution inference report overflow");vc_write(vc_path(output,"result.json"),text,load64(b+8));return 0;
}

// Check generated room geometry against the simulator's actual box records.
import "../control/scene.flex";
global dg_wide_heading=0;
fn dg_close(a,b) {return f64_lt(f64_magnitude(f64_sub(a,b)),vc_number(1,100000000));}
fn dg_record(data,count,name) {let i=0;while i<count {let r=data+256+i*128;if pl_equal(r,name) {return r;}i=i+1;}vc_require(0,vc_concat("missing environment solid ",name));return 0;}
fn dg_vec(array,out,count) {vc_require(pj_kind(array)==3 && pj_count(array)==count,"invalid geometry vector");let i=0;while i<count {let value=pj_real_node(pj_index(array,i));vc_require(!pj_error && f64_is_finite(value),"nonfinite geometry");store64(out+i*8,value);i=i+1;}return out;}
fn dg_check(root,layout,fit) {
    let metadata=vc_json_file(vc_path(root,"layout.json"));vc_require(pl_equal(pj_string_field(metadata,"generator"),"diverse-v1") && vc_json_int(metadata,"layoutId",0)==layout && pj_boolean(metadata,"fit")==fit && vc_json_int(metadata,"startRoom",0)==0,"wrong layout identity or role");let rooms=pj_get(metadata,"rooms");let hidden=layout%2;vc_require(pj_kind(rooms)==3 && pj_count(rooms)==1+hidden,"wrong room count");let a=alloc(32);let b=alloc(32);let start=alloc(24);let obstacle=alloc(32);let door=alloc(24);dg_vec(pj_index(rooms,0),a,4);if hidden {dg_vec(pj_index(rooms,1),b,4);dg_vec(pj_get(metadata,"door"),door,3);}else {vc_require(pj_kind(pj_get(metadata,"door"))==0,"open room has a doorway");}dg_vec(pj_get(metadata,"startPose"),start,3);let obstacles=pj_get(metadata,"obstacles");vc_require(pj_kind(obstacles)==3 && pj_count(obstacles)==1,"wrong obstacle count");dg_vec(pj_index(obstacles,0),obstacle,4);
    let hx=load64(a+16);if hidden {hx=load64(b+16);vc_require(dg_close(load64(a+16),load64(b)) && dg_close(load64(a+8),load64(b+8)) && dg_close(load64(a+24),load64(b+24)) && dg_close(load64(door),load64(b)),"partition metadata is inconsistent");}let hy=load64(a+24);vc_require(f64_gt(hx,vc_number(3,1)) && f64_gt(hy,vc_number(2,1)) && dg_close(load64(a),pb_neg(hx)) && dg_close(load64(a+8),pb_neg(hy)),"room bounds differ");let heading_limit=vc_number(41,100);if dg_wide_heading {heading_limit=f64_add(PB_PI,vc_number(1,100000000));}vc_require(pj_boolean(metadata,"wideHeading")==dg_wide_heading && f64_lt(f64_magnitude(load64(start)),vc_number(11,100)) && f64_lt(f64_magnitude(load64(start+8)),vc_number(11,100)) && f64_lt(f64_magnitude(load64(start+16)),heading_limit),"invalid initial pose or heading mode");
    let env=vc_map(vc_path(root,"environment.bin"));let bytes=vc_size;let count=load64(env+8);let vertices=load64(env+16);vc_require(load64(env)==load64("PBENV001") && count==5+hidden*2 && vertices==36*(count+1) && load64(env+24)==vertices && bytes==256+count*128+vertices*72,"invalid environment dimensions");vc_require(dg_close(load64(env+64),load64(a)) && dg_close(load64(env+72),load64(a+8)) && dg_close(load64(env+80),hx) && dg_close(load64(env+88),hy) && dg_close(load64(env+96),load64(start)) && dg_close(load64(env+104),load64(start+8)) && dg_close(load64(env+112),load64(start+16)),"environment bounds or start pose differ from metadata");
    let west=dg_record(env,count,"Wall.west");let east=dg_record(env,count,"Wall.east");let south=dg_record(env,count,"Wall.south");let north=dg_record(env,count,"Wall.north");vc_require(!load64(west+96) && !load64(east+96) && !load64(south+96) && !load64(north+96) && dg_close(load64(west+48),pb_neg(hx)) && dg_close(load64(east+48),hx) && dg_close(load64(south+56),pb_neg(hy)) && dg_close(load64(north+56),hy),"boundary walls differ");
    if hidden {let low=dg_record(env,count,"Wall.partition-a");let high=dg_record(env,count,"Wall.partition-b");vc_require(!load64(low+96) && !load64(high+96) && dg_close(load64(low+48),load64(door)) && dg_close(load64(high+48),load64(door)) && dg_close(f64_add(load64(low+56),load64(low+80)),f64_sub(load64(door+8),load64(door+16))) && dg_close(f64_sub(load64(high+56),load64(high+80)),f64_add(load64(door+8),load64(door+16))) && f64_ge(load64(door+16),vc_number(7,10)),"physical doorway does not match metadata");}
    let solid=dg_record(env,count,"Obstacle");vc_require(!load64(solid+96) && dg_close(load64(solid+48),load64(obstacle)) && dg_close(load64(solid+56),load64(obstacle+8)) && dg_close(load64(solid+72),load64(obstacle+16)) && dg_close(load64(solid+80),load64(obstacle+24)),"obstacle differs from metadata");vc_require(f64_gt(f64_sub(load64(obstacle),load64(obstacle+16)),f64_add(load64(a),vc_number(3,10))) && f64_lt(f64_add(load64(obstacle),load64(obstacle+16)),vc_number(-8,10)) && f64_gt(f64_sub(load64(obstacle+8),load64(obstacle+24)),f64_add(load64(a+8),vc_number(3,10))) && f64_lt(f64_add(load64(obstacle+8),load64(obstacle+24)),f64_sub(hy,vc_number(3,10))),"obstacle collides with a boundary or start area");syscall(11,env,bytes,0,0,0,0);
    let hashes=alloc(16*8);let scene=0;while scene<16 {let directory=vc_path(root,vc_int(scene));let casefile=vc_path(directory,"case.json");let source=vc_json_file(casefile);let object=pj_index(pj_get(source,"objects"),0);let position=alloc(24);let box=alloc(24);dg_vec(pj_get(object,"position"),position,3);dg_vec(pj_get(pj_get(source,"container"),"position"),box,3);let room=a;if hidden {room=b;}vc_require(f64_gt(load64(position),f64_add(load64(room),vc_number(6,10))) && f64_lt(load64(position),f64_sub(load64(room+16),vc_number(6,10))) && f64_gt(load64(position+8),f64_add(load64(room+8),vc_number(6,10))) && f64_lt(load64(position+8),f64_sub(load64(room+24),vc_number(6,10))),"target is outside its intended room or too near a wall");vc_require(f64_gt(f64_hypot(f64_sub(load64(position),load64(start)),f64_sub(load64(position+8),load64(start+8))),vc_number(35,100)) && f64_gt(f64_hypot(f64_sub(load64(position),load64(box)),f64_sub(load64(position+8),load64(box+8))),vc_number(35,100)),"target is too close to the starting robot or box");let digest=vc_file_sha(casefile);let i=0;while i<scene {vc_require(!pl_equal(digest,load64(hashes+i*8)),"duplicate generated case");i=i+1;}store64(hashes+scene*8,digest);vc_require(pl_equal(vc_file_sha(vc_path(directory,"environment.bin")),vc_file_sha(vc_path(root,"environment.bin"))) && pl_equal(vc_file_sha(vc_path(directory,"layout.json")),vc_file_sha(vc_path(root,"layout.json"))),"scene links do not match its layout");scene=scene+1;}
    return 0;
}
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==5 || argc==6,"visual-control-diverse-scenes ROOT FIRST END fit|validation [--wide-heading]");if argc==6 {vc_require(pl_equal(load64(argv+40),"--wide-heading"),"invalid heading option");dg_wide_heading=1;}let root=vc_absolute(load64(argv+8));let first=pl_integer(load64(argv+16),pl_size(load64(argv+16)));vc_require(!pl_bad_number,"invalid first layout");let end=pl_integer(load64(argv+24),pl_size(load64(argv+24)));vc_require(!pl_bad_number && end>first,"invalid layout range");let role=load64(argv+32);let fit=pl_equal(role,"fit");vc_require(fit || pl_equal(role,"validation"),"invalid role");vc_require((fit && first>=26 && end<=126) || (!fit && first>=126 && end<=226),"layout role range overlaps");let i=first;while i<end {dg_check(vc_path(root,vc_int(i)),i,fit);i=i+1;}pl_print(1,"Diverse scene geometry contracts passed; reachability is not established.\n");return 0;
}

// Compare two exported policies on identical images, own feedback and
// independently maintained recurrent state, including every raw output bit.
import "../control/verify.flex";
import "../control/actions.flex";
fn ip_open(policy,log) {
    let receipt=vc_json_file(vc_path(policy,"receipt.json"));let sha=vc_string(pj_string_field(receipt,"weightsSHA256"));vc_require(pl_equal(vc_file_sha(vc_path(policy,"weights.bin")),sha) && pl_equal(vc_file_sha(vc_path(policy,"policy")),pj_string_field(receipt,"binarySHA256")),"initial parity policy hash mismatch");let args=vc_args();vc_add(args,vc_path(policy,"policy"));vc_add(args,vc_path(policy,"weights.bin"));vc_add(args,sha);vc_add(args,vc_path(policy,"kernels"));vc_add(args,"3");vc_add(args,"--raw");let process=vc_spawn(args,log,0,1);let magic=alloc(8);vc_io(1,load64(process+8),magic,8);vc_require(load64(magic)==load64("VCPRAW01"),"initial parity handshake mismatch");return process;
}
fn main(argc,argv) {
    vc_init(argc,argv);vc_pixels_init();vc_require(argc==5,"initial-parity ORIGINAL NEW DATA OUTPUT");let original=vc_absolute(load64(argv+8));let new_policy=vc_absolute(load64(argv+16));let data=vc_map(vc_absolute(load64(argv+24)));let bytes=vc_size;let row_bytes=vd_row_bytes(data);let n=load64(data+8);let fit=load64(data+16);let length=load64(data+24);vc_require(row_bytes && n>=2 && fit>=1 && fit<n && bytes==32+n*length*(21168+row_bytes),"invalid initial parity dataset");let output=vc_absolute(load64(argv+32));vc_mkdir(output);let a=ip_open(original,vc_path(output,"original.log"));let b=ip_open(new_policy,vc_path(output,"candidate.log"));let hidden_a=alloc(512);let hidden_b=alloc(512);let input=alloc((21168+7+128)*4);let response_a=alloc(135*4);let response_b=alloc(135*4);let checked=0;let group=0;
    while group<2 {let episode=0;if group {episode=fit;}let base=data+32+episode*length*(21168+row_bytes);pb_zero(hidden_a,512);pb_zero(hidden_b,512);let t=0;while t<length {let rgb=base+t*21168;let own=base+length*21168+t*row_bytes;vc_policy_input(rgb,own,hidden_a,input,0);vc_io(0,load64(a+8),input,(21168+7+128)*4);vc_io(1,load64(a+8),response_a,135*4);vc_policy_input(rgb,own,hidden_b,input,0);vc_io(0,load64(b+8),input,(21168+7+128)*4);vc_io(1,load64(b+8),response_b,135*4);let i=0;while i<135*4 {vc_require(load8(response_a+i)==load8(response_b+i),"zero-initialized visual connection changed raw policy output");i=i+1;}vc_copy(hidden_a,response_a+28,512);vc_copy(hidden_b,response_b+28,512);checked=checked+1;t=t+1;}group=group+1;}
    vc_finish(a,15000);vc_finish(b,15000);let text=alloc(1024);let builder=alloc(32);pl_builder(builder,text,1024);pl_text(builder,"{\"passed\":true,\"rawActorAndMemoryBitIdentical\":true,\"framesCompared\":");pl_int(builder,checked);pl_text(builder,",\"pythonRequired\":false}\n");vc_write(vc_path(output,"result.json"),text,load64(builder+8));return 0;
}

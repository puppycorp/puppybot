// Exercise the actual simulator's oracle boundary without opening a renderer.
import "../../build/flex/control/sim-test-library.flex";
import "../control/host.flex";
fn oc_snapshot(request,reply) {vc_require(ps_agent_oracle_snapshot(request),"oracle geometry snapshot failed");return ps_oracle_cache_read(reply);}
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==2,"visual-control-oracle NEW_OUTPUT");let output=vc_absolute(load64(argv+8));vc_mkdir(output);
    ps_case_index=-1;ps_discovery_enabled=1;ps_environment=alloc(256);ps_environment_size=256;store64(ps_environment+64,vc_number(-2,1));store64(ps_environment+72,vc_number(-2,1));store64(ps_environment+80,vc_number(2,1));store64(ps_environment+88,vc_number(2,1));
    ps_physics=ph_world(16,16,8,0);ps_wheel_shape=9;store64(ph_shape(ps_physics,8),8);ps_wheel_local=alloc(192);ps_arm_collider_count=1;ps_arm_colliders=alloc(56);ps_world_matrices=alloc(128);ps_gripper_frame=alloc(128);ps_gripper_targets=alloc(72);
    let request=alloc(64);let reply=alloc(64);store64(reply+16,1);store64(reply+24,600);store64(reply+32,-1000);vc_require(!oc_snapshot(request,reply),"empty oracle cache hit");ps_oracle_cache_save(reply);vc_require(oc_snapshot(request,reply) && load64(reply+24)==600 && load64(reply+32)== -1000,"identical geometry did not reuse the exact label");
    let pointers=alloc(13*8);store64(pointers,request+16);store64(pointers+8,ps_environment+64);store64(pointers+16,ps_body_shape(4)+72);store64(pointers+24,ps_wheel_local);store64(pointers+32,ps_arm_colliders+32);store64(pointers+40,ps_world_matrices);store64(pointers+48,ps_gripper_frame);store64(pointers+56,ps_gripper_targets);store64(pointers+64,ph_shape(ps_physics,5)+72);store64(pointers+72,ph_shape(ps_physics,8)+72);store64(pointers+80,ph_body(ps_physics,8)+8);store64(pointers+88,ph_body(ps_physics,8));store64(pointers+96,request+32);
    let i=0;while i<13 {let p=load64(pointers+i*8);let original=load64(p);store64(p,original^1);vc_require(!oc_snapshot(request,reply),"changed collision geometry reused a stale oracle label");store64(p,original);vc_require(oc_snapshot(request,reply),"restored geometry did not match");i=i+1;}
    ps_x=vc_number(1,1000000);vc_require(!oc_snapshot(request,reply),"sub-cell true-pose change reused a stale label");ps_x=0;vc_require(oc_snapshot(request,reply),"restored true pose did not match");
    ps_nav_escape=1;vc_require(!ps_agent_oracle_snapshot(request) && !ps_oracle_cache_read(reply),"escape planning reused an ordinary-goal label");ps_nav_escape=0;ps_nav_parking_goal=1;vc_require(!ps_agent_oracle_snapshot(request) && !ps_oracle_cache_read(reply),"parking planning reused an ordinary-goal label");ps_nav_parking_goal=0;ps_discovery_enabled=0;vc_require(!ps_agent_oracle_snapshot(request) && !ps_oracle_cache_read(reply),"non-discovery planning reused a mapless label");ps_discovery_enabled=1;vc_require(oc_snapshot(request,reply),"restored planner mode did not match");
    let bytes=ps_oracle_key_bytes;i=0;while i<bytes {store8(ps_oracle_key+i,load8(ps_oracle_key+i)^1);vc_require(!ps_oracle_cache_read(reply),"oracle key comparison missed a changed byte");store8(ps_oracle_key+i,load8(ps_oracle_key+i)^1);i=i+1;}
    ps_oracle_key_begin();vc_require(!ps_oracle_key_add(request,65537) && ps_oracle_key_bytes<0 && !ps_oracle_cache_read(reply) && !ps_oracle_cache_save(reply),"oversized oracle key did not disable reuse");ps_oracle_cache_reset();vc_require(!oc_snapshot(request,reply),"reset reused a preceding episode's label");
    ps_nav_contacts=alloc(640);ps_nav_contact_count=1;store64(ps_nav_contacts+24,1);ps_discovery_enabled=0;ps_seek_enabled=0;ps_nav_training_oracle=0;
    vc_require(!ps_nav_contact_clear(vc_number(2,100),0,0,0,0,0),"normal navigation forgot a recorded failed command");ps_nav_training_oracle=1;vc_require(ps_nav_contact_clear(vc_number(2,100),0,0,0,0,0),"true-pose oracle used estimated-coordinate contact memory");vc_require(!ps_nav_clear(vc_number(3,1),0,0),"oracle bypassed the physical-world boundary");ps_nav_training_oracle=0;
    vc_save_text(vc_path(output,"result.json"),"{\"passed\":true,\"runtime\":\"Flexscript\",\"exactKeyBytesChecked\":true,\"collisionInputsInvalidated\":13,\"subCellPoseInvalidates\":true,\"resetInvalidates\":true,\"overflowDisablesReuse\":true,\"normalContactGuardPreserved\":true,\"oracleExcludesEstimatedContacts\":true,\"oracleRetainsPhysicalBounds\":true}\n");pl_print(1,"Native physical-oracle isolation and exact memoization checks passed.\n");return 0;
}

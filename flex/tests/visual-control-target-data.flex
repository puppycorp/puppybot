// Synthetic target-position sidecars for training isolation and mask checks.
import "../control/host.flex";
fn td_targets(directory,data_sha,variant,mirror) {
    vc_mkdir(directory);let bytes=32+2*4*12;let data=alloc(bytes);vc_copy(data,"PVVIS001",8);store64(data+8,2);store64(data+16,1);store64(data+24,4);let episode=0;while episode<2 {let t=0;while t<2 {let row=data+32+(episode*4+t)*12;let x=vc_number(t+1,4);let y=vc_number(2-t,4);if (variant==1 && !episode) || (variant==2 && episode) {x=pb_neg(x);}pb_put32(row,pb_f64_to_f32(x));pb_put32(row+4,pb_f64_to_f32(y));pb_put32(row+8,0x3f800000);if mirror && !episode {pb_put32(row,pb_u32(row)^0x80000000);}t=t+1;}episode=episode+1;}
    if variant==3 {pb_put32(data+32+2*12+8,0x3f800000);}if variant==6 {pb_put32(data+32+3*12,0x3f800000);}if variant==7 {pb_put32(data+32,0x40000000);}let sha=vc_digest(data,bytes);if variant==4 {pb_put32(data+32,pb_u32(data+32)^1);}vc_write(vc_path(directory,"targets.bin"),data,bytes);if variant==5 {data_sha="wrong";}
    let text=alloc(2048);let b=alloc(32);pl_builder(b,text,2048);pl_text(b,"{\"passed\":true,\"projectionAndPixelsIndependentlyRechecked\":true,\"visibilityHeuristicNotProvenSegmentation\":true,\"actorInputsUnchanged\":true,\"syntheticUnitFixture\":true,\"episodes\":2,\"fittingHistories\":1,\"validationHistories\":1,\"sequenceLength\":4,\"fittingCandidates\":2,\"validationCandidates\":2,\"sourceDataSHA256\":");pj_text(b,data_sha);pl_text(b,",\"targetsSHA256\":");pj_text(b,sha);pl_text(b,"}\n");vc_require(!load64(b+24),"synthetic target receipt overflow");vc_write(vc_path(directory,"receipt.json"),text,load64(b+8));return 0;
}
fn td_empty_batch(directory,source) {
    vc_mkdir(directory);let input=vc_map(source);let bytes=vc_size;let stride=4*21224;vc_require(bytes==32+2*stride && load64(input)==load64("PVDATA03"),"unexpected source fixture");let expanded=alloc(32+3*stride);vc_copy(expanded,"PVDATA03",8);store64(expanded+8,3);store64(expanded+16,2);store64(expanded+24,4);vc_copy(expanded+32,input+32,stride);vc_copy(expanded+32+stride,input+32,stride);vc_copy(expanded+32+2*stride,input+32+stride,stride);vc_write(vc_path(directory,"data.bin"),expanded,32+3*stride);let data_sha=vc_digest(expanded,32+3*stride);
    let labels=alloc(32+3*4*12);vc_copy(labels,"PVVIS001",8);store64(labels+8,3);store64(labels+16,2);store64(labels+24,4);let e=0;while e<3 {if e!=1 {let t=0;while t<2 {let row=labels+32+(e*4+t)*12;pb_put32(row,pb_f64_to_f32(vc_number(t+1,4)));pb_put32(row+4,pb_f64_to_f32(vc_number(2-t,4)));pb_put32(row+8,0x3f800000);t=t+1;}}e=e+1;}let sha=vc_digest(labels,32+3*4*12);vc_write(vc_path(directory,"targets.bin"),labels,32+3*4*12);
    let text=alloc(2048);let b=alloc(32);pl_builder(b,text,2048);pl_text(b,"{\"passed\":true,\"projectionAndPixelsIndependentlyRechecked\":true,\"visibilityHeuristicNotProvenSegmentation\":true,\"actorInputsUnchanged\":true,\"syntheticUnitFixture\":true,\"episodes\":3,\"fittingHistories\":2,\"validationHistories\":1,\"sequenceLength\":4,\"fittingCandidates\":2,\"validationCandidates\":2,\"sourceDataSHA256\":");pj_text(b,data_sha);pl_text(b,",\"targetsSHA256\":");pj_text(b,sha);pl_text(b,"}\n");vc_require(!load64(b+24),"empty-batch receipt overflow");vc_write(vc_path(directory,"receipt.json"),text,load64(b+8));return 0;
}
fn td_absence_data(path,source) {
    let input=vc_map(source);let bytes=vc_size;let stride=4*21224;vc_require(bytes==32+2*stride && load64(input)==load64("PVDATA03"),"unexpected source fixture");let copy=alloc(bytes);vc_copy(copy,input,bytes);let episode=0;while episode<2 {let base=copy+32+episode*stride;vc_copy(base+3*21168,base+2*21168,21168);vc_copy(base+4*21168+3*56,base+4*21168+2*56,56);episode=episode+1;}vc_write(path,copy,bytes);return vc_digest(copy,bytes);
}
fn td_absence_validation(directory,source) {
    vc_mkdir(directory);let input=vc_map(source);let bytes=vc_size;let stride=4*21224;vc_require(bytes==32+2*stride && load64(input)==load64("PVDATA03"),"unexpected source fixture");let copy=alloc(bytes);vc_copy(copy,input,bytes);let validation=copy+32+stride;pb_put32(validation+4*21168+2*56+36,0);vc_write(vc_path(directory,"data.bin"),copy,bytes);td_targets(vc_path(directory,"targets"),vc_digest(copy,bytes),0,0);return 0;
}
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==4,"target-fixtures DATA MIRRORED_DATA NEW_OUTPUT");let source_path=vc_absolute(load64(argv+8));let mirror_path=vc_absolute(load64(argv+16));let source=vc_file_sha(source_path);let mirrored=vc_file_sha(mirror_path);let output=vc_absolute(load64(argv+24));vc_mkdir(output);let variant=0;while variant<8 {td_targets(vc_path(output,vc_concat("target-",vc_int(variant))),source,variant,0);variant=variant+1;}td_targets(vc_path(output,"target-mirrored"),mirrored,0,1);td_empty_batch(vc_path(output,"target-empty-batch"),source_path);
    let absent_path=vc_path(output,"absence-data.bin");let absent=td_absence_data(absent_path,source_path);let absent_mirrored=td_absence_data(vc_path(output,"absence-mirrored-data.bin"),mirror_path);variant=0;while variant<8 {td_targets(vc_path(output,vc_concat("absence-target-",vc_int(variant))),absent,variant,0);variant=variant+1;}td_targets(vc_path(output,"absence-target-mirrored"),absent_mirrored,0,1);td_empty_batch(vc_path(output,"absence-empty-batch"),absent_path);td_absence_validation(vc_path(output,"absence-validation"),absent_path);return 0;
}

// Compare batched training graphs with exported single-frame recurrent inference.
import "../control/training.flex";
import "../control/workflow.flex";
fn vf_raw_open(policy,output,width) {
    let meta=vc_json_file(vc_path(policy,"receipt.json"));let sha=vc_string(pj_string_field(meta,"weightsSHA256"));vc_require(pl_equal(vc_file_sha(vc_path(policy,"weights.bin")),sha) && pl_equal(vc_file_sha(vc_path(policy,"policy")),pj_string_field(meta,"binarySHA256")),"forward test policy hash mismatch");
    let args=vc_args();vc_add(args,vc_path(policy,"policy"));vc_add(args,vc_path(policy,"weights.bin"));vc_add(args,sha);vc_add(args,vc_path(policy,"kernels"));vc_add(args,"3");vc_add(args,"--raw");let process=vc_spawn(args,vc_path(output,"policy.log"),0,1);let magic=alloc(8);vc_io(1,load64(process+8),magic,8);vc_require(load64(magic)==load64("VCPRAW01"),"raw recurrent policy handshake mismatch");return process;
}
fn main(argc,argv) {
    vc_init(argc,argv);vc_pixels_init();vc_require(argc==4,"visual-control-forward POLICY DATA OUTPUT");let policy=vc_absolute(load64(argv+8));let data=vc_map(load64(argv+16));let bytes=vc_size;let row_bytes=vd_row_bytes(data);let length=load64(data+24);let episodes=load64(data+8);let fit=load64(data+16);vc_require(row_bytes && episodes>=2 && fit>=1 && fit<episodes && length>=1 && length<=512 && bytes==32+episodes*length*(21168+row_bytes),"invalid parity dataset");
    let output=vc_absolute(load64(argv+24));vc_mkdir(output);let mode=vw_actor_mode(vc_path(policy,"weights.bin"));pt_action_width=2;if mode!=2 {pt_action_width=7;}pt_phase_gate=mode==14;pt_heat_actor=vw_has_heat_actor(vc_path(policy,"weights.bin"));if pt_heat_actor {pt_heat_aux=1;}let process=vf_raw_open(policy,output,pt_action_width);let meta=vc_json_file(vc_path(policy,"receipt.json"));let sha=vc_string(pj_string_field(meta,"weightsSHA256"));
    vp_graph_limit=65536;vp_init(vc_path(policy,"kernels"),2,0);vp_checkpoint_open(vc_path(policy,"weights.bin"),sha);pt_model(2,length);let images=alloc(length*2*21168*4);let proprio=alloc(length*2*28);let b=0;
    while b<2 {let episode=0;if b {episode=fit;}let base=data+32+episode*length*(21168+row_bytes);let t=0;while t<length {let i=0;while i<21168 {pb_put32(images+((t*2+b)*21168+i)*4,pb_f64_to_f32(vc_number(load8(base+t*21168+i),255)));i=i+1;}vc_copy(proprio+(t*2+b)*28,base+length*21168+t*row_bytes,28);t=t+1;}b=b+1;}
    pt_upload(load64(pt_images),images,length*2*21168*4);pt_upload(load64(pt_proprio),proprio,length*2*28);vp_execute();let predictions=alloc(length*2*pt_action_width*4);let memories=alloc(length*2*128*4);let t=0;
    while t<length {vp_read_tensor(vp_at(pt_actions,t),predictions+t*2*pt_action_width*4);vp_read_tensor(vp_at(pt_memories,t),memories+t*2*128*4);t=t+1;}
    let hidden=alloc(512);let input=alloc((21168+7+128)*4);let response=alloc((pt_action_width+128)*4);let maximum=0;let memory_maximum=0;b=0;
    while b<2 {pb_zero(hidden,512);let episode=0;if b {episode=fit;}let base=data+32+episode*length*(21168+row_bytes);t=0;while t<length {vc_policy_input(base+t*21168,base+length*21168+t*row_bytes,hidden,input,0);vc_io(0,load64(process+8),input,(21168+7+128)*4);vc_io(1,load64(process+8),response,(pt_action_width+128)*4);let i=0;
            while i<pt_action_width {maximum=pb_fmax(maximum,f64_magnitude(f64_sub(pb_read_float(response+i*4),pb_read_float(predictions+((t*2+b)*pt_action_width+i)*4))));i=i+1;}
            i=0;while i<128 {memory_maximum=pb_fmax(memory_maximum,f64_magnitude(f64_sub(pb_read_float(response+(pt_action_width+i)*4),pb_read_float(memories+((t*2+b)*128+i)*4))));i=i+1;}vc_copy(hidden,response+pt_action_width*4,512);t=t+1;
        }b=b+1;}
    vc_require(f64_lt(maximum,vc_number(1,100000)) && f64_lt(memory_maximum,vc_number(1,100000)),"training and exported recurrent inference differ");
    pb_zero(hidden,512);let rgb=alloc(21168);let own=alloc(28);let first=alloc((pt_action_width+128)*4);let pixel=0;let pass=0;
    while pass<3 {let i=0;while i<21168 {store8(rgb+i,255*(pass==1));i=i+1;}vc_policy_input(rgb,own,hidden,input,0);vc_io(0,load64(process+8),input,(21168+7+128)*4);vc_io(1,load64(process+8),response,(pt_action_width+128)*4);
        if !pass {vc_copy(first,response,(pt_action_width+128)*4);}if pass==1 {i=0;while i<pt_action_width {pixel=pb_fmax(pixel,f64_magnitude(f64_sub(pb_read_float(first+i*4),pb_read_float(response+i*4))));i=i+1;}}if pass==2 {i=0;while i<(pt_action_width+128)*4 {vc_require(load8(first+i)==load8(response+i),"raw policy memory reset is not bit-identical");i=i+1;}}pass=pass+1;
    }
    vc_require(f64_gt(pixel,vc_number(1,1000000000)),"exported policy logits ignore camera pixels");vc_finish(process,15000);let text=alloc(2048);let builder=alloc(32);pl_builder(builder,text,2048);pl_text(builder,"{\"passed\":true,\"runtime\":\"Flexscript/Pup CUDA\",\"pythonRequired\":false,\"framesCompared\":");pl_int(builder,length*2);pl_text(builder,",\"actorOutputs\":");pl_int(builder,pt_action_width);pl_text(builder,",\"logitMaxAbsError\":");pl_float(builder,maximum);pl_text(builder,",\"memoryMaxAbsError\":");pl_float(builder,memory_maximum);pl_text(builder,",\"pixelLogitMaxDelta\":");pl_float(builder,pixel);pl_text(builder,",\"resetBitIdentical\":true}\n");vc_write(vc_path(output,"result.json"),text,load64(builder+8));pl_write(1,text,load64(builder+8));return 0;
}

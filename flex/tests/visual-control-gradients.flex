// Independent native finite-difference and first-Adam checks. The oracle is
// forward evaluations at perturbed weights, not another autodiff framework.
import "../control/training.flex";
import "../control/host.flex";
import "../control/loss.flex";
import "../control/augmentation.flex";
global vg_heat_absence=0;
global vg_phase_consistency=0;
global vg_phase_balance=0;
global vg_return_weight=0;
global vg_contact_weight=0;
global vg_feedback_dropout=0;
fn vg_negative_log(probability) {
    let exponent=0;while f64_lt(probability,vc_number(1,2)) {probability=f64_mul(probability,f64_from_i64(2));exponent=exponent+1;}
    let y=f64_div(f64_sub(PB_ONE,probability),f64_add(PB_ONE,probability));let square=f64_mul(y,y);let power=y;let sum=0;let i=1;
    while i<=31 {sum=f64_add(sum,f64_div(power,f64_from_i64(i)));power=f64_mul(power,square);i=i+2;}return f64_add(f64_mul(f64_from_i64(2),sum),f64_mul(f64_from_i64(exponent),0x3fe62e42fefa39ef));
}
fn vg_loss(seeds) {
    vp_execute();let out=alloc(56);let categorical_seed=alloc(56);let categorical_target=alloc(8);let phase_values=alloc(24);let phase_seeds=alloc(24);let loss=0;let t=0;
    while t<3 {
        let action=vp_at(pt_actions,t);vp_read_tensor(action,out);let i=0;
        if pt_action_width==7 {let batch=0;while batch<2 {let kind=(t*3+batch*2)%7;let scale=vc_number((t+1)*(batch+1),13);if vg_return_weight && t==2 {scale=pt_return_control_weight(scale,PB_ONE,1,2000);}if vg_contact_weight && t==1 && !batch {scale=pt_contact_control_weight(scale,PB_ONE,1,2000);}let sum=0;i=0;while i<7 {sum=f64_add(sum,f64_exp(pb_read_float(out+(batch*7+i)*4)));i=i+1;}
                let probability=f64_div(f64_exp(pb_read_float(out+(batch*7+kind)*4)),sum);let independent=f64_mul(scale,vg_negative_log(probability));loss=f64_add(loss,independent);
                if seeds {pb_put32(categorical_target,ca_steering_bits(kind));pb_put32(categorical_target+4,ca_speed_bits(kind));let native=pt_categorical_loss(out+batch*28,categorical_target,PB_ONE,scale,categorical_seed+batch*28);vc_require(f64_lt(f64_magnitude(f64_sub(native,independent)),vc_number(1,1000000000)),"categorical loss differs from independent log-probability oracle");}batch=batch+1;
            }if seeds {pt_upload(pt_gradient(action),categorical_seed,56);}
        }else {while i<4 {let batch=i/2;let weight=8;if t==1 && !batch {weight=1;}if t==2 {weight=40;if batch {weight=5;}}let axis=1;if !(i&1) {axis=8;}let scale=vc_number(weight*axis,70);
            let target=vc_number(batch*2-1,5);if i&1 {target=vc_number(6,10);if t==1 && batch {target=pb_neg(target);}if t==2 {target=0;}}
            let delta=f64_sub(pb_read_float(out+i*4),target);loss=f64_add(loss,f64_mul(f64_mul(delta,delta),scale));if seeds {pb_put32(out+i*4,pb_f64_to_f32(f64_mul(f64_from_i64(2),f64_mul(delta,scale))));}i=i+1;}
        if seeds {pt_upload(pt_gradient(action),out,16);}}
        let phase=vp_at(pt_phases,t);vp_read_tensor(phase,out);i=0;
        while i<2 {if vg_phase_balance {let label=0;if t==2 && i==1 {label=PB_ONE;}let logit=pb_read_float(out+i*4);let scale=pt_phase_scale(PB_ONE,label,f64_from_i64(6),PB_ONE,f64_from_i64(5),1);let probability=f64_div(PB_ONE,f64_add(PB_ONE,f64_exp(pb_neg(logit))));if !label {probability=f64_sub(PB_ONE,probability);}let independent=f64_mul(scale,vg_negative_log(probability));loss=f64_add(loss,independent);
                if seeds {let native=pt_binary_loss(logit,label,scale,phase_seeds+(t*2+i)*4);vc_require(f64_lt(f64_magnitude(f64_sub(native,independent)),vc_number(1,1000000000)),"balanced phase BCE differs from independent probability oracle");}
            }else {let scale=vc_number((t+1)*(i+1),11);if vg_phase_consistency {pb_put32(phase_values+(t*2+i)*4,pb_u32(out+i*4));}loss=f64_add(loss,f64_mul(pb_read_float(out+i*4),scale));if seeds {if vg_phase_consistency {pb_put32(phase_seeds+(t*2+i)*4,pb_f64_to_f32(scale));}else {pb_put32(out+i*4,pb_f64_to_f32(scale));}}}i=i+1;}
        if seeds && vg_phase_balance {pt_upload(pt_gradient(phase),phase_seeds+t*8,8);}else if seeds && !vg_phase_consistency {pt_upload(pt_gradient(phase),out,8);}t=t+1;
        if pt_event_aux {let event=vp_at(pt_events,t-1);vp_read_tensor(event,out);i=0;while i<2 {let logit=pb_read_float(out+i*4);let label=(t+i)%2;let scale=vc_number(t*(i+1),7);let probability=f64_div(PB_ONE,f64_add(PB_ONE,f64_exp(pb_neg(logit))));if !label {probability=f64_sub(PB_ONE,probability);}let independent=f64_mul(scale,vg_negative_log(probability));loss=f64_add(loss,independent);
                if seeds {let native=pt_binary_loss(logit,f64_from_i64(label),scale,categorical_seed+i*4);vc_require(f64_lt(f64_magnitude(f64_sub(native,independent)),vc_number(1,1000000000)),"event loss differs from independent probability oracle");}i=i+1;}if seeds {pt_upload(pt_gradient(event),categorical_seed,8);}}
        if pt_pose_aux {let pose=vp_at(pt_poses,t-1);vp_read_tensor(pose,out);let batch=0;while batch<2 {let target=alloc(16);let scale=vc_number(t*(batch+1),17);let independent=0;i=0;while i<4 {pb_put32(target+i*4,pb_f64_to_f32(vc_number(((t*4+batch*3+i*2)%11)-5,5)));let delta=f64_sub(pb_read_float(out+(batch*4+i)*4),pb_read_float(target+i*4));independent=f64_add(independent,f64_mul(scale,f64_mul(delta,delta)));i=i+1;}loss=f64_add(loss,independent);if seeds {let native=pt_pose_loss(out+batch*16,target,scale,categorical_seed+batch*16);vc_require(f64_lt(f64_magnitude(f64_sub(native,independent)),vc_number(1,1000000000)),"memory-pose loss differs from independent squared-error oracle");}syscall(11,target,16,0,0,0,0);batch=batch+1;}if seeds {pt_upload(pt_gradient(pose),categorical_seed,32);}}
        if pt_target_aux {let target_head=vp_at(pt_target_predictions,t-1);vp_read_tensor(target_head,out);let batch=0;while batch<2 {let target=alloc(8);let scale=vc_number(t*(batch+1),19);let independent=0;i=0;while i<2 {pb_put32(target+i*4,pb_f64_to_f32(vc_number(((t*3+batch*2+i)%9)-4,4)));let delta=f64_sub(pb_read_float(out+(batch*2+i)*4),pb_read_float(target+i*4));independent=f64_add(independent,f64_mul(scale,f64_mul(delta,delta)));i=i+1;}loss=f64_add(loss,independent);if seeds {let native=pt_target_loss(out+batch*8,target,scale,categorical_seed+batch*8);vc_require(f64_lt(f64_magnitude(f64_sub(native,independent)),vc_number(1,1000000000)),"target-position loss differs from independent squared-error oracle");}syscall(11,target,8,0,0,0,0);batch=batch+1;}if seeds {pt_upload(pt_gradient(target_head),categorical_seed,16);}}
        if pt_heat_aux {let heat=vp_at(pt_target_predictions,t-1);let values=alloc(3200);let gradients=alloc(3200);vp_read_tensor(heat,values);let batch=0;while batch<2 {let target=alloc(8);pb_put32(target,pb_f64_to_f32(vc_number(t+batch-2,4)));pb_put32(target+4,pb_f64_to_f32(vc_number(t-batch-1,4)));let scale=vc_number(t*(batch+1),19);if vg_heat_absence && batch {loss=f64_add(loss,pt_heat_absence_loss(values+batch*1600,t*2+batch,scale,gradients+batch*1600));}else {loss=f64_add(loss,pt_heat_loss(values+batch*1600,target,scale,gradients+batch*1600));}syscall(11,target,8,0,0,0,0);batch=batch+1;}if seeds {pt_upload(pt_gradient(heat),gradients,3200);}syscall(11,values,3200,0,0,0,0);syscall(11,gradients,3200,0,0,0,0);}
    }
    if vg_phase_consistency {let batch=0;while batch<2 {let a=pb_read_float(phase_values+batch*4);let b=pb_read_float(phase_values+(2+batch)*4);let pa=f64_div(PB_ONE,f64_add(PB_ONE,f64_exp(pb_neg(a))));let pb=f64_div(PB_ONE,f64_add(PB_ONE,f64_exp(pb_neg(b))));let delta=f64_sub(pa,pb);let independent=f64_mul(vc_number(1,3),f64_mul(delta,delta));loss=f64_add(loss,independent);
        if seeds {let native=pt_phase_consistency_loss(a,b,vc_number(1,3),phase_seeds+batch*4,phase_seeds+(2+batch)*4);vc_require(f64_lt(f64_magnitude(f64_sub(native,independent)),vc_number(1,1000000000)),"phase consistency differs from independent probability loss");}batch=batch+1;}
        if seeds {t=0;while t<3 {pt_upload(pt_gradient(vp_at(pt_phases,t)),phase_seeds+t*8,8);t=t+1;}}
    }
    syscall(11,phase_values,24,0,0,0,0);syscall(11,phase_seeds,24,0,0,0,0);syscall(11,out,56,0,0,0,0);syscall(11,categorical_seed,56,0,0,0,0);syscall(11,categorical_target,8,0,0,0,0);return loss;
}
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc>=3 && argc<=14,"visual-control-gradients KERNEL_DIRECTORY NEW_OUTPUT_DIRECTORY [--categorical|--phase-gated] [--event-aux] [--pose-aux] [--target-aux|--heat-aux] [--heat-actor] [--absence-loss] [--large-model] [--phase-consistency] [--phase-balance] [--return-weight] [--contact-weight] [--feedback-drop]");let option=3;while option<argc {let flag=load64(argv+option*8);if pl_equal(flag,"--large-model") {vc_require(pt_memory_width==128,"duplicate large model option");pt_memory_width=256;}else if pl_equal(flag,"--event-aux") {pt_event_aux=1;}else if pl_equal(flag,"--pose-aux") {pt_pose_aux=1;}else if pl_equal(flag,"--target-aux") {pt_target_aux=1;}else if pl_equal(flag,"--heat-aux") {pt_heat_aux=1;}else if pl_equal(flag,"--heat-actor") {pt_heat_actor=1;}else if pl_equal(flag,"--absence-loss") {vg_heat_absence=1;}else if pl_equal(flag,"--phase-consistency") {vg_phase_consistency=1;}else if pl_equal(flag,"--phase-balance") {vg_phase_balance=1;}else if pl_equal(flag,"--return-weight") {vg_return_weight=1;}else if pl_equal(flag,"--contact-weight") {vg_contact_weight=1;}else if pl_equal(flag,"--feedback-drop") {vg_feedback_dropout=1;}else {vc_require(pl_equal(flag,"--categorical") || pl_equal(flag,"--phase-gated"),"unknown gradient test option");pt_action_width=7;pt_phase_gate=pl_equal(flag,"--phase-gated");}option=option+1;}vc_require((!pt_target_aux || !pt_heat_aux) && (!pt_heat_actor || (pt_heat_aux && pt_action_width==7 && (!pt_phase_gate || pt_memory_width==256))) && (!vg_heat_absence || pt_heat_aux) && (!vg_phase_consistency || pt_phase_gate) && (!vg_phase_balance || (pt_phase_gate && !vg_phase_consistency)) && (!vg_return_weight || pt_action_width==7) && (!vg_contact_weight || pt_action_width==7),"invalid target or heat-actor test options");let output=vc_absolute(load64(argv+16));vc_mkdir(output);
    let speed=vc_number(6,10);vc_require(f64_eq(pt_control_weight(PB_ONE,speed,0),f64_from_i64(8)) && f64_eq(pt_control_weight(PB_ONE,speed,speed),PB_ONE) && f64_eq(pt_control_weight(PB_ONE,pb_neg(speed),speed),f64_from_i64(8)),"start/cruise/reverse loss weights");
    vc_require(f64_eq(pt_control_weight(PB_ONE,0,pb_neg(speed)),f64_from_i64(40)) && f64_eq(pt_control_weight(PB_ONE,0,0),f64_from_i64(5)) && !pt_control_weight(0,0,pb_neg(speed)),"stop/padding loss weights");
    if pt_heat_aux {let logits=alloc(1600);let target=alloc(8);let seed=alloc(1600);let loss=pt_heat_loss(logits,target,PB_ONE,seed);vc_require(f64_lt(f64_magnitude(f64_sub(loss,0x3fe62e42fefa39ef)),vc_number(1,1000000000)),"uniform heatmap loss differs from log two");let negative=0;let positive=0;let j=0;while j<400 {let value=pb_read_float(seed+j*4);if f64_eq(value,pb_neg(vc_number(1,4))) {positive=positive+1;}else if f64_eq(value,vc_number(1,64)) {negative=negative+1;}else {vc_require(!f64_magnitude(value),"unexpected heatmap seed");}j=j+1;}vc_require(positive==1 && negative==16,"heatmap candidate sample weights differ");pb_zero(seed,1600);vc_require(!pt_heat_loss(logits,target,0,seed),"masked heatmap has loss");j=0;while j<400 {vc_require(!pb_u32(seed+j*4),"masked heatmap produced a seed");j=j+1;}loss=pt_heat_absence_loss(logits,7,PB_ONE,seed);vc_require(f64_lt(f64_magnitude(f64_sub(loss,0x3fe62e42fefa39ef)),vc_number(1,1000000000)),"uniform absence loss differs from log two");negative=0;j=0;while j<400 {let value=pb_read_float(seed+j*4);if f64_eq(value,vc_number(1,32)) {negative=negative+1;}else {vc_require(!f64_magnitude(value),"unexpected absence seed");}j=j+1;}vc_require(negative==16,"absence sample weights differ");}
    vp_init(load64(argv+8),2,0);vp_checkpoint=alloc(32);vp_bytes=32;pt_scratch_init=1;pt_rng=7;pt_model(2,3);let count=pt_prepare(load64(argv+8));
    if pt_heat_actor {let p=0;let i=0;while i<load64(pt_parameters) {let item=vp_at(pt_parameters,i);if pl_equal(load64(item),"visual.merge.weight_T") {p=load64(item+8);}i=i+1;}vc_require(p,"visual merge test parameter missing");let n=load64(p+8);let values=alloc(n*4);i=0;while i<n {pb_put32(values+i*4,pb_f64_to_f32(vc_number(i%7-3,1000)));i=i+1;}pt_upload(load64(p),values,n*4);syscall(11,values,n*4,0,0,0,0);}
    let images=alloc(6*21168*4);let i=0;while i<6*21168 {pb_put32(images+i*4,pb_f64_to_f32(vc_number((i*17+11)%251,255)));i=i+1;}pt_upload(load64(pt_images),images,6*21168*4);
    let feedback=alloc(6*7*4);i=0;while i<6 {pb_put32(feedback+(i*7)*4,pb_f64_to_f32(vc_number(i-2,10)));if vg_feedback_dropout && i==1 {pb_put32(feedback+(i*7+5)*4,0x3f800000);pf_neutral_drive(feedback+i*28);vc_require(pb_u32(feedback+(i*7+5)*4)==0x3f800000,"feedback dropout lost contact");}i=i+1;}pt_upload(load64(pt_proprio),feedback,6*7*4);
    pt_zero_grad();let original_loss=vg_loss(1);vp_check(device_graph_launch(pt_backward,vp_stream));vp_check(device_stream_wait(vp_stream));
    let maxima=alloc(load64(pt_parameters)*24);let norm=0;let max_error=0;i=0;
    while i<load64(pt_parameters) {
        let p=vp_at(pt_parameters,i);let t=load64(p+8);let n=load64(t+8);let grad=alloc(n*4);vp_check(device_download(grad,pt_gradient(t),n*4));
        let best=0;let index=0;let j=0;while j<n {let value=pb_read_float(grad+j*4);vc_require(f64_is_finite(value),"nonfinite native gradient");norm=f64_add(norm,f64_mul(value,value));if f64_gt(f64_magnitude(value),f64_magnitude(best)) {best=value;index=j;}j=j+1;}
        vc_require(f64_gt(f64_magnitude(best),vc_number(1,1000000000)),"a trainable tensor received no gradient");
        let word=alloc(4);vp_check(device_download(word,load64(t)+index*4,4));let original=pb_read_float(word);let epsilon=vc_number(1,1000);
        pb_put32(word,pb_f64_to_f32(f64_add(original,epsilon)));let high_value=pb_read_float(word);pt_upload(load64(t)+index*4,word,4);let high=vg_loss(0);
        pb_put32(word,pb_f64_to_f32(f64_sub(original,epsilon)));let low_value=pb_read_float(word);pt_upload(load64(t)+index*4,word,4);let low=vg_loss(0);
        pb_put32(word,pb_f64_to_f32(original));pt_upload(load64(t)+index*4,word,4);let numeric=f64_div(f64_sub(high,low),f64_sub(high_value,low_value));let error=f64_magnitude(f64_sub(numeric,best));max_error=pb_fmax(max_error,error);
        vc_require(f64_lt(error,pb_fmax(vc_number(3,10000),f64_mul(f64_magnitude(best),vc_number(8,100)))),vc_concat("finite-difference gradient mismatch: ",load64(p)));
        store64(maxima+i*24,index);store64(maxima+i*24+8,best);store64(maxima+i*24+16,original);syscall(11,grad,n*4,0,0,0,0);syscall(11,word,4,0,0,0,0);i=i+1;
    }
    norm=f64_sqrt(norm);pt_zero_grad();vg_loss(1);let native_norm=pt_step(vc_number(1,10000));vc_require(f64_lt(f64_magnitude(f64_sub(norm,native_norm)),f64_mul(pb_fmax(norm,PB_ONE),vc_number(1,100000))),"native parameter gradient norm mismatch");
    let max_update_error=0;i=0;while i<load64(pt_parameters) {
        let t=load64(vp_at(pt_parameters,i)+8);let index=load64(maxima+i*24);let gradient=load64(maxima+i*24+8);if f64_gt(norm,PB_ONE) {gradient=f64_div(gradient,norm);}
        let expected=f64_sub(load64(maxima+i*24+16),f64_div(f64_mul(vc_number(1,10000),gradient),f64_add(f64_magnitude(gradient),vc_number(1,100000000))));
        let word=alloc(4);vp_check(device_download(word,load64(t)+index*4,4));let error=f64_magnitude(f64_sub(pb_read_float(word),expected));max_update_error=pb_fmax(max_update_error,error);vc_require(f64_lt(error,vc_number(1,1000000)),"native first Adam step mismatch");i=i+1;
    }
    let text=alloc(4096);let b=alloc(32);pl_builder(b,text,4096);pl_text(b,"{\"passed\":true,\"runtime\":\"Flexscript/Pup CUDA\",\"oracle\":\"central finite differences and independent scalar Adam\",\"pythonRequired\":false,\"parameters\":");pl_int(b,count);
    pl_text(b,",\"tensorsChecked\":");pl_int(b,load64(pt_parameters));pl_text(b,",\"actorOutputs\":");pl_int(b,pt_action_width);pl_text(b,",\"sequenceLength\":3,\"batch\":2,\"fullCNNAndGRU\":true,\"phaseConsistencyChecked\":");pj_bool_text(b,vg_phase_consistency);pl_text(b,",\"phaseBalanceChecked\":");pj_bool_text(b,vg_phase_balance);pl_text(b,",\"returnControlWeightChecked\":");pj_bool_text(b,vg_return_weight);pl_text(b,",\"poseAuxiliaryChecked\":");pj_bool_text(b,pt_pose_aux);pl_text(b,",\"contactControlWeightChecked\":");pj_bool_text(b,vg_contact_weight);pl_text(b,",\"feedbackDropChecked\":");pj_bool_text(b,vg_feedback_dropout);pl_text(b,",\"maxGradientAbsError\":");pl_float(b,max_error);pl_text(b,",\"maxAdamAbsError\":");pl_float(b,max_update_error);pl_text(b,",\"initialLoss\":");pl_float(b,original_loss);pl_text(b,"}\n");vc_write(vc_path(output,"result.json"),text,load64(b+8));pl_write(1,text,load64(b+8));return 0;
}

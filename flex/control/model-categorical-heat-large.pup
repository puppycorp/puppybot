images = input("images",[1,3,84,84])
proprio = input("proprio",[1,7])
hidden = input("hidden",[1,256])
c1 = conv2d(images,"encoder.0",32,8,4,0,1)
a1 = max(c1,0.0)
c2 = conv2d(a1,"encoder.2",64,4,2,0,1)
a2 = max(c2,0.0)
c3 = conv2d(a2,"encoder.4",192,3,1,0,1)
a3 = max(c3,0.0)
flat = reshape(a3,[1,9408])
fc_w = tensor("encoder.7.weight_T",[9408,256])
fc_b = tensor("encoder.7.bias",[256])
fc = batch_matmul(flat,fc_w)+fc_b
encoded = max(fc,0.0)
heat = conv2d(a1,"critic.heat",1,1,1,0,1)
heat_flat = reshape(heat,[1,400])
heat_w = tensor("visual.merge.weight_T",[400,256])
heat_b = tensor("visual.merge.bias",[256])
heat_features = batch_matmul(heat_flat,heat_w)+heat_b
augmented = encoded+heat_features
combined = concat(augmented,proprio,1)
ix_w = tensor("memory.weight_ih_T",[263,768])
ix_b = tensor("memory.bias_ih",[768])
ix = batch_matmul(combined,ix_w)+ix_b
hx_w = tensor("memory.weight_hh_T",[256,768])
hx_b = tensor("memory.bias_hh",[768])
hx = batch_matmul(hidden,hx_w)+hx_b
ir = slice(ix,1,0,256)
iz = slice(ix,1,256,512)
inn = slice(ix,1,512,768)
hr = slice(hx,1,0,256)
hz = slice(hx,1,256,512)
hn = slice(hx,1,512,768)
r = sigmoid(ir+hr)
z = sigmoid(iz+hz)
candidate = 2.0*sigmoid(2.0*(inn+r*hn))-1.0
next_hidden = (1.0-z)*candidate+z*hidden
mu_w = tensor("actor7.weight_T",[256,7])
mu_b = tensor("actor7.bias",[7])
logits = batch_matmul(next_hidden,mu_w)+mu_b
output logits,next_hidden

images = input("images",[1,3,84,84])
proprio = input("proprio",[1,7])
hidden = input("hidden",[1,128])
c1 = conv2d(images,"encoder.0",16,8,4,0,1)
a1 = max(c1,0.0)
c2 = conv2d(a1,"encoder.2",32,4,2,0,1)
a2 = max(c2,0.0)
c3 = conv2d(a2,"encoder.4",32,3,1,0,1)
a3 = max(c3,0.0)
flat = reshape(a3,[1,1568])
fc_w = tensor("encoder.7.weight_T",[1568,128])
fc_b = tensor("encoder.7.bias",[128])
fc = batch_matmul(flat,fc_w)+fc_b
encoded = max(fc,0.0)
combined = concat(encoded,proprio,1)
ix_w = tensor("memory.weight_ih_T",[135,384])
ix_b = tensor("memory.bias_ih",[384])
ix = batch_matmul(combined,ix_w)+ix_b
hx_w = tensor("memory.weight_hh_T",[128,384])
hx_b = tensor("memory.bias_hh",[384])
hx = batch_matmul(hidden,hx_w)+hx_b
ir = slice(ix,1,0,128)
iz = slice(ix,1,128,256)
inn = slice(ix,1,256,384)
hr = slice(hx,1,0,128)
hz = slice(hx,1,128,256)
hn = slice(hx,1,256,384)
r = sigmoid(ir+hr)
z = sigmoid(iz+hz)
candidate = 2.0*sigmoid(2.0*(inn+r*hn))-1.0
next_hidden = (1.0-z)*candidate+z*hidden
phase_w = tensor("critic.weight_T",[128,1])
phase_b = tensor("critic.bias",[1])
phase = sigmoid(batch_matmul(next_hidden,phase_w)+phase_b)
search_w = tensor("actor_search.weight_T",[128,7])
search_b = tensor("actor_search.bias",[7])
return_w = tensor("actor_return.weight_T",[128,7])
return_b = tensor("actor_return.bias",[7])
search_logits = batch_matmul(next_hidden,search_w)+search_b
return_logits = batch_matmul(next_hidden,return_w)+return_b
logits = (1.0-phase)*search_logits+phase*return_logits
output logits,next_hidden

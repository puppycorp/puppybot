// Generated by flex/scripts/prepare-dashboard.py; edit ui.css or controls.js.
fn pu_styles() { return ":root{color-scheme:dark;font:15px/1.5 system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;color:#e7eee9;background:#101616;--line:#30403c;--muted:#9bacA4;--accent:#c1e8a7}\n*{box-sizing:border-box}body{margin:0}button,input,select{font:inherit}button,input,select{border:1px solid #465b50;border-radius:8px;background:#24342e;color:inherit;min-height:40px;padding:8px 13px}button{cursor:pointer;font-weight:600}button:hover{background:#344b3c}button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:2px solid var(--accent);outline-offset:3px}button:disabled{opacity:.4;cursor:not-allowed}button.primary{background:var(--accent);border-color:var(--accent);color:#1a2c17}button.danger{color:#ffb9b0;border-color:#805047;background:#432a28}.pressed{background:#b4dc91!important;color:#152712!important;box-shadow:0 0 0 2px #c1e8a7}button[data-hold]{touch-action:none;user-select:none;-webkit-user-select:none}h1,h2,h3,p{margin:0}h1{font-size:30px;letter-spacing:-1px;font-weight:650}h2{font-size:18px}h3{font-size:15px}.muted{color:var(--muted);font-size:13px}.eyebrow{text-transform:uppercase;letter-spacing:1.5px;font-size:10px;color:var(--muted);font-weight:650}.badge{font-size:12px;border:1px solid #4c6556;color:var(--accent);padding:4px 11px;border-radius:20px}.connection{color:var(--muted);font-size:12px}\nheader{position:sticky;top:0;z-index:5;display:flex;align-items:center;gap:24px;padding:17px 32px;background:#131d1bf5;border-bottom:1px solid var(--line);backdrop-filter:blur(12px)}#brand{display:flex;align-items:center;gap:20px}#brand-name{font-size:18px;color:var(--accent)}.header-status{display:flex;align-items:center;gap:16px;margin-left:auto}main{max-width:1460px;margin:auto;padding:32px}.page-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px}.status-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.metric{display:flex;flex-direction:column;gap:4px;padding:16px 20px;background:#1a2622;border:1px solid var(--line);border-radius:12px}.metric strong{font-size:21px;font-weight:600}.metric .muted{overflow-wrap:anywhere}.admission{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:18px 0 26px;padding:0 2px}.admission>p{max-width:730px}.button-row{display:flex;flex-wrap:wrap;gap:8px}.admission .button-row{flex-shrink:0}.control-layout{display:grid;grid-template-columns:290px minmax(0,1fr);gap:20px;align-items:start}.panel{padding:22px;background:#17221f;border:1px solid var(--line);border-radius:14px}.drive-panel>h2:not(:first-child){margin-top:30px}.drive-panel>p{margin-top:8px}.dpad{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin:24px 0}.dpad button{padding:8px 3px;font-size:12px}#drive-forward{grid-column:2}#drive-left{grid-column:1;grid-row:2}#drive-stop{grid-column:2;grid-row:2}#drive-right{grid-column:3;grid-row:2}#drive-back{grid-column:2;grid-row:3}.tcp-buttons{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:14px}.note{margin-top:20px!important}.toolbar{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:20px}.speed-form{display:flex;align-items:center;gap:8px}.speed-form input{width:90px}.joints{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.joint{padding:16px;background:#1c2a25;border:1px solid var(--line);border-radius:10px;min-width:0}.joint-heading{display:flex;align-items:center;gap:8px}.joint-heading strong{margin-left:auto;font-variant-numeric:tabular-nums;font-size:20px}.joint-heading .muted{font-size:11px}.joint p{margin-top:8px}.joint-buttons{display:flex;gap:6px;margin-top:14px}.joint-buttons button{flex:1}.joint-status{font-size:12px;color:var(--accent)}.temperature{font-size:11px}.joint details{font-size:12px}.joint details[open]{border-top:1px solid var(--line);padding-top:12px}details{margin-top:14px}summary{cursor:pointer;color:#c1cec5;font-size:13px;min-height:30px;display:list-item}.small-form{display:grid;grid-template-columns:1fr;gap:5px;margin-top:12px}.small-form input,.small-form select{width:100%;min-width:0}.small-form button{margin-top:5px}.arm-buttons{margin-top:20px}.target-panel{padding-top:18px;border-top:1px solid var(--line);margin-top:20px}.target-form{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:16px}.target-form h3{grid-column:1/-1}.target-form label{grid-row:2;color:var(--muted);font-size:12px}.target-form input{grid-row:3;width:100%;min-width:0}.target-form button{grid-column:span 2}.target-form h3{margin-bottom:5px}footer{margin-top:22px;padding:16px 2px;overflow-wrap:anywhere}footer p{font-size:13px;margin-top:6px}.error{color:#ffb9b0;min-height:20px}\n@media(max-width:1050px){main{padding:24px}.control-layout{grid-template-columns:240px minmax(0,1fr)}.panel{padding:16px}.joints{grid-template-columns:1fr}.admission{align-items:flex-start}.status-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.joint-heading .muted{font-size:12px}}\n@media(max-width:650px){header{padding:12px 16px;gap:12px}#brand-subtitle{display:none}.header-status{gap:8px}.connection{font-size:10px}.badge{padding:3px 7px;font-size:10px}header button{padding:7px 10px}main{padding:22px 14px}h1{font-size:25px}.page-title{align-items:flex-start}#uptime{font-size:11px}.metric{padding:12px}.metric strong{font-size:18px}.metric .muted{font-size:11px}.admission{flex-direction:column;gap:12px}.control-layout{grid-template-columns:1fr}.drive-panel{display:grid;grid-template-columns:1fr 1fr;gap:12px}.drive-panel>h2,.drive-panel>p,.drive-panel>.small-form{grid-column:1/-1}.drive-panel>h2:not(:first-child){margin-top:8px}.dpad{grid-column:1/-1;width:100%;max-width:320px;justify-self:center;margin:4px 0 12px}.tcp-buttons{grid-column:1/-1;margin-top:0;grid-template-columns:repeat(3,1fr)}.toolbar{flex-wrap:wrap}.speed-form{margin-left:auto}.target-form{grid-template-columns:repeat(2,minmax(0,1fr))}.target-form label{grid-row:auto}.target-form input{grid-row:auto}.target-form label,.target-form input{grid-column:1/-1}.target-form button{grid-column:1/-1}}\n.field{display:flex;flex-direction:column;gap:5px;min-width:0}.field label{color:var(--muted);font-size:12px}.field input{width:100%;min-width:0}.target-form .field label,.target-form .field input{grid-row:auto}\n"; }
fn pu_controls_js() { return "// Only press/hold lifecycle lives here. Monolith owns views, forms and SSE.\n(() => {\n  let held = null;\n  let connected = false;\n  let chain = Promise.resolve();\n  const status = () => document.querySelector('[data-mono-status]');\n  const showError = message => document.querySelectorAll('[data-mono-error]').forEach(node => { node.textContent = message; });\n  const token = () => document.querySelector('meta[name=\"monolith-token\"]').content;\n  async function send(action, hold, keepalive = false) {\n    const body = new URLSearchParams({token: token(), action, id: hold.id, lease: hold.lease});\n    const response = await fetch('/action', {method: 'POST', headers: {'Content-Type': 'application/x-www-form-urlencoded', Accept: 'application/json'}, body, keepalive, signal: keepalive ? undefined : AbortSignal.timeout(400)});\n    if (!response.ok) {\n      const result = await response.json();\n      throw new Error(result.error || `Action rejected (${response.status}).`);\n    }\n  }\n  function stop() {\n    const previous = held;\n    held = null;\n    if (!previous) return;\n    clearTimeout(previous.timer);\n    previous.button.classList.remove('pressed');\n    chain = chain.catch(() => {}).then(() => send('release', previous, true)).catch(() => {});\n  }\n  function renew(hold) {\n    if (held !== hold) return;\n    hold.timer = setTimeout(() => {\n      if (held !== hold) return;\n      chain = chain.then(async () => {\n        if (held !== hold) return;\n        await send('renew', hold);\n        renew(hold);\n      }).catch(error => { showError(error.message); stop(); });\n    }, 120);\n  }\n  function start(button) {\n    if (held || !connected || document.hidden || button.disabled) return;\n    if (document.querySelector('#dashboard').dataset.ready !== '1') return;\n    const random = new Uint32Array(1); crypto.getRandomValues(random);\n    const hold = {button, id: button.dataset.hold, lease: String(random[0] || 1)};\n    held = hold;\n    button.classList.add('pressed');\n    showError('');\n    chain = chain.catch(() => {}).then(async () => {\n      if (held !== hold) return;\n      await send('jog', hold);\n      renew(hold);\n    }).catch(error => { showError(error.message); stop(); });\n  }\n  document.addEventListener('pointerdown', event => {\n    const button = event.target.closest('button[data-hold]');\n    if (!button || event.button !== 0) return;\n    event.preventDefault();\n    button.focus();\n    button.setPointerCapture(event.pointerId);\n    start(button);\n  });\n  for (const event of ['pointerup', 'pointercancel', 'lostpointercapture']) document.addEventListener(event, stop);\n  document.addEventListener('keydown', event => {\n    if (event.code === 'Escape') { stop(); document.querySelector('#stop-all').click(); return; }\n    const button = event.target.closest('button[data-hold]');\n    if (button && ['Space', 'Enter'].includes(event.code)) { event.preventDefault(); if (!event.repeat) start(button); }\n  });\n  document.addEventListener('keyup', event => { if (['Space', 'Enter'].includes(event.code)) stop(); });\n  document.addEventListener('click', event => { if (event.target.closest('[data-action]')) stop(); }, true);\n  document.addEventListener('submit', stop, true);\n  document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); });\n  window.addEventListener('blur', stop);\n  window.addEventListener('pagehide', stop);\n  new MutationObserver(() => {\n    connected = status()?.textContent === 'Live';\n    if (!connected || document.querySelector('#dashboard')?.dataset.ready !== '1' || held?.button.disabled) stop();\n  }).observe(document.querySelector('#dashboard'), {subtree: true, childList: true, characterData: true, attributes: true, attributeFilter: ['data-ready', 'disabled']});\n})();\n"; }

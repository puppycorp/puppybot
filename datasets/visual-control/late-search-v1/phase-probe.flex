// Inspect the training-only phase head on an exactly replayed autonomous history.
import "../../../flex/control/verify.flex";
import "../../../flex/control/actions.flex";
fn lp_parameter(data,bytes,name,count) {
    vc_require(bytes>=32 && load64(data)==load64("PUPV0001") && load64(data+8)<=4096 && load64(data+16)==32+load64(data+8)*256 && load64(data+16)<=bytes,"invalid phase probe checkpoint");let found=0;let i=0;
    while i<load64(data+8) {let row=data+32+i*256;if pl_equal(row,name) {vc_require(!found && load64(row+200)==count && load64(row+208)>=0 && load64(row+208)<=bytes-load64(data+16) && count*4<=bytes-load64(data+16)-load64(row+208),"invalid phase parameter");found=data+load64(data+16)+load64(row+208);}i=i+1;}vc_require(found,"missing phase parameter");return found;
}
fn main(argc,argv) {
    vc_init(argc,argv);vc_pixels_init();vc_require(argc==4,"phase-probe POLICY AUTONOMOUS_EPISODE NEW_OUTPUT");let policy=vc_absolute(load64(argv+8));let run=vc_absolute(load64(argv+16));let output=vc_absolute(load64(argv+24));vc_mkdir(output);let meta=vc_json_file(vc_path(policy,"receipt.json"));let sha=vc_string(pj_string_field(meta,"weightsSHA256"));vc_require(pl_equal(vc_file_sha(vc_path(policy,"weights.bin")),sha) && pl_equal(vc_file_sha(vc_path(policy,"policy")),pj_string_field(meta,"binarySHA256")),"phase probe policy hash mismatch");
    let audit=vc_json_file(vc_path(run,"../verified/result.json"));vc_require(pj_boolean(audit,"passed") && !pj_real(audit,"commandReplayMaxAbsError") && pl_equal(pj_string_field(audit,"weightsSHA256"),sha),"phase probe requires an audited autonomous history");
    let data=vc_map(vc_path(policy,"weights.bin"));let bytes=vc_size;let weights=lp_parameter(data,bytes,"critic.weight_T",128);let bias=lp_parameter(data,bytes,"critic.bias",1);
    let args=vc_args();vc_add(args,vc_path(policy,"policy"));vc_add(args,vc_path(policy,"weights.bin"));vc_add(args,sha);vc_add(args,vc_path(policy,"kernels"));vc_add(args,"3");vc_add(args,"--raw");let process=vc_spawn(args,vc_path(output,"policy.log"),0,1);let magic=alloc(8);vc_io(1,load64(process+8),magic,8);vc_require(load64(magic)==load64("VCPRAW01"),"phase probe handshake mismatch");
    let hidden=alloc(512);let input=alloc((21168+7+128)*4);let response=alloc(135*4);let decoded=alloc(8);let initial=vc_json_file(vc_path(run,"initial.json"));let frame=vc_json_int(initial,"totalSteps",0);let phase=vc_json_int(initial,"findReturn","consumedIndex")>=0;va_lines(vc_path(run,"decisions.jsonl"));let row=va_next();let text=alloc(131072);let b=alloc(32);pl_builder(b,text,131072);pl_text(b,"{\"weightsSHA256\":");pj_text(b,sha);pl_text(b,",\"metric\":\"Auxiliary phase-head calibration on exact autonomous replay; not episode performance or a causal intervention\",\"rows\":[");let t=0;
    while row {vc_require(t<512,"phase probe episode exceeds task bound");let rgb=vc_map(vc_path(run,vc_concat("actor-",vc_concat(vc_int(frame),".rgb"))));vc_require(vc_size==21168,"invalid phase probe RGB");let own=vc_map(vc_path(run,vc_concat("actor-",vc_concat(vc_int(frame),".feedback"))));vc_require(vc_size==28 && !pb_u32(own+24),"invalid phase probe feedback");vc_policy_input(rgb,own,hidden,input,0);vc_io(0,load64(process+8),input,(21168+7+128)*4);vc_io(1,load64(process+8),response,135*4);let kind=ca_decode(response,decoded);let action=pj_get(row,"action");vc_require(kind>=0 && pb_u32(decoded)==pb_f64_to_f32(pj_real_node(pj_index(action,0))) && pb_u32(decoded+4)==pb_f64_to_f32(pj_real_node(pj_index(action,1))),"phase probe action differs from autonomous recording");let logit=pb_read_float(bias);let i=0;while i<128 {logit=f64_add(logit,f64_mul(pb_read_float(weights+i*4),pb_read_float(response+28+i*4)));i=i+1;}vc_require(f64_is_finite(logit),"nonfinite phase prediction");let probability=f64_div(PB_ONE,f64_add(PB_ONE,f64_exp(pb_neg(logit))));
        if t {pl_char(b,44);}pl_text(b,"{\"actionIndex\":");pl_int(b,t);pl_text(b,",\"frame\":");pl_int(b,frame);pl_text(b,",\"actualReturning\":");pj_bool_text(b,phase);pl_text(b,",\"predictedReturnProbability\":");pl_float(b,probability);pl_text(b,",\"actionClass\":");pl_int(b,kind);pl_text(b,",\"contact\":");pj_bool_text(b,pb_u32(own+20)!=0);pl_char(b,125);
        vc_copy(hidden,response+28,512);syscall(11,rgb,21168,0,0,0,0);syscall(11,own,28,0,0,0,0);frame=vc_json_int(row,"step",0);phase=vc_json_int(pj_get(row,"state"),"findReturn","consumedIndex")>=0;t=t+1;row=va_next();
    }pl_text(b,"],\"actualCommandsReplayedExactly\":true,\"phaseHeadReadOnly\":true}\n");vc_require(!load64(b+24),"phase probe report overflow");vc_finish(process,15000);vc_write(vc_path(output,"result.json"),text,load64(b+8));return 0;
}

// Keep four audited fitting histories and replace only the failed validation trip.
import "../../../flex/control/dataset.flex";
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==6,"replace-validation DATA RUN REPAIR_DATA REPAIR_RUN OUTPUT");let sources=alloc(16);let lengths=alloc(16);let roots=alloc(16);let hashes=alloc(16);let source=0;let length=0;
    while source<2 {let data=vc_map(load64(argv+8+source*16));let t=load64(data+24);let n=5;let fit=4;if source {n=2;fit=1;}vc_require(vd_row_bytes(data)==56 && load64(data+8)==n && load64(data+16)==fit && t>=1 && t<=512 && vc_size==32+n*t*21224,"invalid replacement source");store64(sources+source*8,data);store64(lengths+source*8,t);store64(roots+source*8,vc_absolute(load64(argv+16+source*16)));store64(hashes+source*8,vc_digest(data,vc_size));length=pb_max(length,t);source=source+1;}
    let output=vc_absolute(load64(argv+40));vc_mkdir(output);let size=32+5*length*21224;let merged=alloc(size);vc_copy(merged,"PVDATA03",8);store64(merged+8,5);store64(merged+16,4);store64(merged+24,length);let text=alloc(4096);let b=alloc(32);pl_builder(b,text,4096);pl_text(b,"{\"preservesFittingHistoriesAndRoles\":true,\"replacesOnlyValidationIndex\":4,\"sourceSHA256\":[");pj_text(b,load64(hashes));pl_char(b,44);pj_text(b,load64(hashes+8));pl_text(b,"],\"records\":[");let i=0;
    while i<5 {source=0;let index=i;if i==4 {source=1;index=1;}let t=load64(lengths+source*8);let from=load64(sources+source*8)+32+index*t*21224;let to=merged+32+i*length*21224;vc_copy(to,from,t*21168);vc_copy(to+length*21168,from+t*21168,t*56);let original=vc_path(load64(roots+source*8),vc_concat("expert-",vc_int(index)));vc_require(!syscall(88,original,vc_path(output,vc_concat("expert-",vc_int(i))),0,0,0,0),"cannot link replacement history");if i {pl_char(b,44);}pl_text(b,"{\"index\":");pl_int(b,i);pl_text(b,",\"source\":");pl_int(b,source);pl_text(b,",\"sourceIndex\":");pl_int(b,index);pl_text(b,",\"fit\":");pj_bool_text(b,i<4);pl_char(b,125);i=i+1;}
    vc_write(vc_path(output,"data.bin"),merged,size);pl_text(b,"],\"episodes\":5,\"fitTrajectories\":4,\"sequenceLength\":");pl_int(b,length);pl_text(b,",\"dataSHA256\":");pj_text(b,vc_digest(merged,size));pl_text(b,"}\n");vc_require(!load64(b+24),"replacement receipt overflow");vc_write(vc_path(output,"report.json"),text,load64(b+8));return 0;
}

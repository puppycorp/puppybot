// Offline peak heatmap scores on candidate-positive and post-consumption frames.
import "../../../flex/control/training.flex";
import "../../../flex/control/target-supervision.flex";
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==7 || (argc==8 && pl_equal(load64(argv+56),"--heat-actor")),"presence WEIGHTS SHA KERNELS DATA TARGETS NEW_OUTPUT [--heat-actor]");let weights=vc_absolute(load64(argv+8));let sha=load64(argv+16);let kernels=vc_absolute(load64(argv+24));let data=vc_map(vc_absolute(load64(argv+32)));let bytes=vc_size;let row_bytes=vd_row_bytes(data);vc_require(row_bytes,"invalid presence data");pt_target_open(vc_absolute(load64(argv+40)),data,bytes,row_bytes);let output=vc_absolute(load64(argv+48));vc_mkdir(output);let n=load64(data+8);let fit=load64(data+16);let length=load64(data+24);vp_init(kernels,2,0);vp_checkpoint_open(weights,sha);pt_action_width=7;pt_event_aux=1;pt_heat_aux=1;if argc==8 {pt_heat_actor=1;}pt_model(1,1);let input=alloc(21168*4);let own=alloc(28);let prediction=alloc(1600);let counters=alloc(2*4*8);let sums=alloc(2*8);let e=fit;
    while e<n {let base=data+32+e*length*(21168+row_bytes);let t=0;while t<length {let source=base+length*21168+t*row_bytes;let label=pt_target_data+32+(e*length+t)*12;let positive=pb_u32(label+8);let after=0;if t && vd_valid_word(source,row_bytes) && pb_u32(source+36) {let previous=source-row_bytes;after=vd_valid_word(previous,row_bytes) && pb_u32(previous+36);}if positive || after {vc_require(!positive || !after,"candidate and post-consumption masks overlap");let group=0;if after {group=1;}let frame=base+t*21168;let i=0;while i<21168 {pb_put32(input+i*4,pb_f64_to_f32(vc_number(load8(frame+i),255)));i=i+1;}pt_upload(load64(pt_images),input,21168*4);pt_upload(load64(pt_proprio),own,28);vp_execute();vp_read_tensor(vp_at(pt_target_predictions,0),prediction);let max=pb_read_float(prediction);i=0;while i<400 {let value=pb_read_float(prediction+i*4);vc_require(f64_is_finite(value),"nonfinite presence score");max=pb_fmax(max,value);i=i+1;}let c=counters+group*32;store64(c,load64(c)+1);if f64_gt(max,0) {store64(c+8,load64(c+8)+1);}if f64_gt(max,PB_ONE) {store64(c+16,load64(c+16)+1);}if f64_gt(max,f64_from_i64(2)) {store64(c+24,load64(c+24)+1);}store64(sums+group*8,f64_add(load64(sums+group*8),max));}t=t+1;}e=e+1;}
    let text=alloc(2048);let b=alloc(32);pl_builder(b,text,2048);pl_text(b,"{\"weightsSHA256\":");pj_text(b,sha);pl_text(b,",\"metric\":\"Offline maximum heatmap logit on heuristic candidate positives and post-consumption frames; not a calibrated detector or episode score\",\"rows\":[");let g=0;while g<2 {if g {pl_char(b,44);}let c=counters+g*32;let count=load64(c);vc_require(count>0,"empty presence split");pl_text(b,"{\"group\":");if g {pj_text(b,"post-consumption");}else {pj_text(b,"candidate-positive");}pl_text(b,",\"frames\":");pl_int(b,count);pl_text(b,",\"maxAboveZero\":");pl_int(b,load64(c+8));pl_text(b,",\"maxAboveOne\":");pl_int(b,load64(c+16));pl_text(b,",\"maxAboveTwo\":");pl_int(b,load64(c+24));pl_text(b,",\"meanMaxLogit\":");pl_float(b,f64_div(load64(sums+g*8),f64_from_i64(count)));pl_char(b,125);g=g+1;}pl_text(b,"]}\n");vc_require(!load64(b+24),"presence output overflow");vc_write(vc_path(output,"result.json"),text,load64(b+8));return 0;
}

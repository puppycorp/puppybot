// Offline top-cell heatmap localization on candidate-labeled frames only.
import "../../../flex/control/training.flex";
import "../../../flex/control/target-supervision.flex";
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==7,"heat-readout WEIGHTS SHA KERNELS DATA TARGETS NEW_OUTPUT");let weights=vc_absolute(load64(argv+8));let sha=load64(argv+16);let kernels=vc_absolute(load64(argv+24));let data=vc_map(vc_absolute(load64(argv+32)));let bytes=vc_size;let row_bytes=vd_row_bytes(data);vc_require(row_bytes,"invalid heat readout data");pt_target_open(vc_absolute(load64(argv+40)),data,bytes,row_bytes);let output=vc_absolute(load64(argv+48));vc_mkdir(output);let n=load64(data+8);let fit=load64(data+16);let length=load64(data+24);
    let means=alloc(16);let fit_count=0;let e=0;while e<fit {let t=0;while t<length {let label=pt_target_data+32+(e*length+t)*12;if pb_u32(label+8) {store64(means,f64_add(load64(means),pb_read_float(label)));store64(means+8,f64_add(load64(means+8),pb_read_float(label+4)));fit_count=fit_count+1;}t=t+1;}e=e+1;}vc_require(fit_count>0,"empty heat readout fitting labels");store64(means,f64_div(load64(means),f64_from_i64(fit_count)));store64(means+8,f64_div(load64(means+8),f64_from_i64(fit_count)));
    vp_init(kernels,2,0);vp_checkpoint_open(weights,sha);pt_action_width=7;pt_event_aux=1;pt_heat_aux=1;pt_model(1,1);let input=alloc(21168*4);let proprio=alloc(28);let prediction=alloc(1600);let counts=alloc(2*8);let errors=alloc(2*4*8);let near=alloc(2*8);e=0;
    while e<n {let group=0;if e>=fit {group=1;}let base=data+32+e*length*(21168+row_bytes);let t=0;while t<length {let label=pt_target_data+32+(e*length+t)*12;if pb_u32(label+8) {let frame=base+t*21168;let i=0;while i<21168 {pb_put32(input+i*4,pb_f64_to_f32(vc_number(load8(frame+i),255)));i=i+1;}pt_upload(load64(pt_images),input,21168*4);pt_upload(load64(pt_proprio),proprio,28);vp_execute();vp_read_tensor(vp_at(pt_target_predictions,0),prediction);let best=0;let maximum=pb_read_float(prediction);i=0;while i<400 {let value=pb_read_float(prediction+i*4);vc_require(f64_is_finite(value),"nonfinite heatmap prediction");if f64_gt(value,maximum) {maximum=value;best=i;}i=i+1;}let predicted=alloc(16);store64(predicted,f64_add(f64_from_i64((best%20)*4),vc_number(7,2)));store64(predicted+8,f64_add(f64_from_i64((best/20)*4),vc_number(7,2)));let radius=0;i=0;while i<2 {let expected=f64_mul(f64_add(pb_read_float(label+i*4),PB_ONE),f64_from_i64(42));let difference=f64_sub(load64(predicted+i*8),expected);let naive=f64_sub(f64_mul(f64_add(load64(means+i*8),PB_ONE),f64_from_i64(42)),expected);radius=f64_add(radius,f64_mul(difference,difference));let at=errors+(group*4+i)*8;store64(at,f64_add(load64(at),f64_magnitude(difference)));at=errors+(group*4+2+i)*8;store64(at,f64_add(load64(at),f64_magnitude(naive)));i=i+1;}if f64_le(radius,f64_from_i64(64)) {store64(near+group*8,load64(near+group*8)+1);}syscall(11,predicted,16,0,0,0,0);store64(counts+group*8,load64(counts+group*8)+1);}t=t+1;}e=e+1;}
    let text=alloc(4096);let b=alloc(32);pl_builder(b,text,4096);pl_text(b,"{\"weightsSHA256\":");pj_text(b,sha);pl_text(b,",\"metric\":\"Offline heatmap top-cell error on heuristic candidate labels; not autonomous task success\",\"actorInputsUnchanged\":true,\"rows\":[");let group=0;while group<2 {if group {pl_char(b,44);}let count=load64(counts+group*8);vc_require(count>0,"empty heat readout split");pl_text(b,"{\"split\":");if group {pj_text(b,"validation");}else {pj_text(b,"fitting");}pl_text(b,",\"frames\":");pl_int(b,count);pl_text(b,",\"withinEightPixels\":");pl_int(b,load64(near+group*8));let keys=alloc(32);store64(keys,"meanAbsoluteXPixels");store64(keys+8,"meanAbsoluteYPixels");store64(keys+16,"constantFitMeanXPixels");store64(keys+24,"constantFitMeanYPixels");let i=0;while i<4 {pl_char(b,44);pj_text(b,load64(keys+i*8));pl_char(b,58);pl_float(b,f64_div(load64(errors+(group*4+i)*8),f64_from_i64(count)));i=i+1;}pl_char(b,125);group=group+1;}pl_text(b,"]}\n");vc_require(!load64(b+24),"heat readout result overflow");vc_write(vc_path(output,"result.json"),text,load64(b+8));return 0;
}

import "../../../flex/control/verify.flex";
fn op_relative(pose,origin,out) {
    let dx=f64_sub(load64(pose),load64(origin));let dy=f64_sub(load64(pose+8),load64(origin+8));let c=f64_cos(load64(origin+16));let s=f64_sin(load64(origin+16));let yaw=pb_wrap_pi(f64_sub(load64(pose+16),load64(origin+16)));
    let x=f64_div(f64_add(f64_mul(c,dx),f64_mul(s,dy)),f64_from_i64(8));let y=f64_div(f64_sub(f64_mul(c,dy),f64_mul(s,dx)),f64_from_i64(8));vc_require(f64_le(f64_magnitude(x),PB_ONE) && f64_le(f64_magnitude(y),PB_ONE),"relative pose exceeds fixed eight-metre normalization");pb_put32(out,pb_f64_to_f32(x));pb_put32(out+4,pb_f64_to_f32(y));pb_put32(out+8,pb_f64_to_f32(f64_sin(yaw)));pb_put32(out+12,pb_f64_to_f32(f64_cos(yaw)));pb_put32(out+16,0x3f800000);return 0;
}
fn op_inverse_check(label,pose,origin) {
    let x=f64_mul(pb_read_float(label),f64_from_i64(8));let y=f64_mul(pb_read_float(label+4),f64_from_i64(8));let c=f64_cos(load64(origin+16));let s=f64_sin(load64(origin+16));let world_x=f64_add(load64(origin),f64_sub(f64_mul(c,x),f64_mul(s,y)));let world_y=f64_add(load64(origin+8),f64_add(f64_mul(s,x),f64_mul(c,y)));let sine=pb_read_float(label+8);let cosine=pb_read_float(label+12);let heading=pb_wrap_pi(f64_add(load64(origin+16),f64_atan2(sine,cosine)));let tolerance=vc_number(1,100000);
    vc_require(f64_lt(f64_hypot(f64_sub(world_x,load64(pose)),f64_sub(world_y,load64(pose+8))),tolerance) && f64_lt(f64_magnitude(pb_wrap_pi(f64_sub(heading,load64(pose+16)))),tolerance) && f64_lt(f64_magnitude(f64_sub(f64_add(f64_mul(sine,sine),f64_mul(cosine,cosine)),PB_ONE)),tolerance),"pose target does not match its pre-action physical trace frame");return 0;
}
fn op_self_test() {
    let origin=alloc(24);let pose=alloc(24);let row=alloc(20);store64(origin,f64_from_i64(10));store64(origin+8,f64_from_i64(20));store64(origin+16,0x3ff921fb54442d18);store64(pose,f64_from_i64(9));store64(pose+8,f64_from_i64(22));store64(pose+16,0x400921fb54442d18);op_relative(pose,origin,row);let epsilon=vc_number(1,1000000);vc_require(f64_lt(f64_magnitude(f64_sub(pb_read_float(row),vc_number(1,4))),epsilon) && f64_lt(f64_magnitude(f64_sub(pb_read_float(row+4),vc_number(1,8))),epsilon) && f64_lt(f64_magnitude(f64_sub(pb_read_float(row+8),PB_ONE)),epsilon) && f64_lt(f64_magnitude(pb_read_float(row+12)),epsilon),"known ninety-degree relative transform failed");op_inverse_check(row,pose,origin);op_relative(origin,origin,row);vc_require(!pb_u32(row) && !pb_u32(row+4) && !pb_u32(row+8) && pb_u32(row+12)==0x3f800000,"initial relative pose is not identity");return 0;
}
fn op_prepare(path,runs,output) {
    let data=vc_map(path);let bytes=vc_size;let n=load64(data+8);let fit=load64(data+16);let length=load64(data+24);vc_require(vd_row_bytes(data)==56 && n==172 && fit==136 && length==354 && bytes==32+n*length*21224 && pl_equal(vc_digest(data,bytes),"05032e0eb2a4a98a7f0146db66195792b2c22fe3bda3138039e9c721bc69b284"),"pose targets require the exact admitted172 corpus");vc_mkdir(output);let target_bytes=32+n*length*20;let targets=alloc(target_bytes);vc_copy(targets,"PVPOSE01",8);store64(targets+8,n);store64(targets+16,fit);store64(targets+24,length);let origin=alloc(24);let pose=alloc(24);let compare=ffi_symbol(ffi_open("libc.so.6"),"memcmp");vc_require(compare,"memcmp unavailable");let frames=0;let episode=0;
    while episode<n {let run=vc_path(runs,vc_concat("expert-",vc_int(episode)));let initial=vc_json_file(vc_path(run,"initial.json"));ve_pose_read(initial,origin);vc_copy(pose,origin,24);let frame=vc_json_int(initial,"totalSteps",0);let base=data+32+episode*length*21224;let t=0;let passed=0;va_lines(vc_path(run,"decisions.jsonl"));
        while t<length && vd_valid_word(base+length*21168+t*56,56) {let row=base+length*21168+t*56;vc_require(!pb_u32(row+24),"pose preparation encountered actor event hint");let stem=vc_concat("actor-",vc_int(frame));let rgb=vc_map(vc_path(run,vc_concat(stem,".rgb")));vc_require(vc_size==21168 && !ffi_call(compare,rgb,base+t*21168,21168,0,0,0),"pose target RGB frame is misaligned");syscall(11,rgb,21168,0,0,0,0);let own=vc_map(vc_path(run,vc_concat(stem,".feedback")));vc_require(vc_size==28 && !ffi_call(compare,own,row,28,0,0,0),"pose target own-feedback frame is misaligned");syscall(11,own,28,0,0,0,0);op_relative(pose,origin,targets+32+(episode*length+t)*20);
            let command=va_next();vc_require(command && vc_json_int(command,"step",0)==frame+10,"pose input has no matching ten-tick recorded command");let state=pj_get(command,"state");ve_pose_read(state,pose);frame=vc_json_int(command,"step",0);passed=pj_boolean(pj_get(state,"case"),"passed");t=t+1;frames=frames+1;
        }vc_require(t>0 && passed && !va_next(),"pose target history is incomplete or has unmatched commands");let at=t;while at<length {vc_require(!vd_valid_word(base+length*21168+at*56,56),"pose source has nontrailing valid frames");at=at+1;}syscall(11,va_data,va_length,0,0,0,0);episode=episode+1;
    }vc_write(vc_path(output,"targets.bin"),targets,target_bytes);let text=alloc(2048);let b=alloc(32);pl_builder(b,text,2048);pl_text(b,"{\"prepared\":true,\"runtime\":\"Flexscript\",\"pythonRequired\":false,\"sourceDataSHA256\":");pj_text(b,vc_digest(data,bytes));pl_text(b,",\"targetsSHA256\":");pj_text(b,vc_digest(targets,target_bytes));pl_text(b,",\"episodes\":172,\"fittingHistories\":136,\"validationHistories\":36,\"sequenceLength\":354,\"preActionFrames\":");pl_int(b,frames);pl_text(b,",\"normalizationMetres\":8,\"actorInputsUnchanged\":true}\n");vc_require(!load64(b+24),"pose target receipt overflow");vc_write(vc_path(output,"report.json"),text,load64(b+8));return 0;
}
fn op_verify(path,runs,target_path,output) {
    let data=vc_map(path);let bytes=vc_size;let n=load64(data+8);let fit=load64(data+16);let length=load64(data+24);vc_require(vd_row_bytes(data)==56 && n==172 && fit==136 && length==354 && bytes==32+n*length*21224 && pl_equal(vc_digest(data,bytes),"05032e0eb2a4a98a7f0146db66195792b2c22fe3bda3138039e9c721bc69b284"),"pose verifier requires admitted172 data");let targets=vc_map(target_path);let target_bytes=vc_size;vc_require(target_bytes==32+n*length*20 && load64(targets)==load64("PVPOSE01") && load64(targets+8)==n && load64(targets+16)==fit && load64(targets+24)==length,"pose target dimensions or fit-validation roles differ");let origin=alloc(24);let pose=alloc(24);let frames=0;let increments=0;let episode=0;
    while episode<n {let run=vc_path(runs,vc_concat("expert-",vc_int(episode)));let initial=vc_json_file(vc_path(run,"initial.json"));ve_pose_read(initial,origin);let first=vc_json_int(initial,"step",0);let base=data+32+episode*length*21224;let labels=targets+32+episode*length*20;let t=0;
        while t<length {let valid=vd_valid_word(base+length*21168+t*56,56);vc_require(pb_u32(labels+t*20+16)==valid,"pose target valid mask differs from source");if !valid {let j=0;while j<20 {vc_require(!load8(labels+t*20+j),"pose target padding is not zero");j=j+1;}}t=t+1;}
        va_command_intervals(run);increments=increments+va_physics(run);va_lines(vc_path(run,"trace.jsonl"));let state=va_next();t=0;
        while state {let step=vc_json_int(state,"step",0);if t<length && vd_valid_word(base+length*21168+t*56,56) && step==first+t*10 {ve_pose_read(state,pose);op_inverse_check(labels+t*20,pose,origin);t=t+1;frames=frames+1;}state=va_next();}
        vc_require(t>0 && (t==length || !vd_valid_word(base+length*21168+t*56,56)),"physical trace omitted a pose target frame");syscall(11,va_data,va_length,0,0,0,0);episode=episode+1;
    }let text=alloc(2048);let b=alloc(32);pl_builder(b,text,2048);pl_text(b,"{\"passed\":true,\"runtime\":\"Flexscript\",\"pythonRequired\":false,\"targetsSHA256\":");pj_text(b,vc_digest(targets,target_bytes));pl_text(b,",\"sourceDataSHA256\":");pj_text(b,vc_digest(data,bytes));pl_text(b,",\"episodes\":172,\"preActionFramesChecked\":");pl_int(b,frames);pl_text(b,",\"physicalMotionIncrementsChecked\":");pl_int(b,increments);pl_text(b,",\"inverseTransformAndYawChecked\":true,\"initialOriginPerEpisode\":true,\"rolesAndPaddingPreserved\":true,\"actorInputsUnchanged\":true}\n");vc_require(!load64(b+24),"pose verification receipt overflow");vc_write(output,text,load64(b+8));return 0;
}
fn main(argc,argv) {
    vc_init(argc,argv);op_self_test();vc_require(argc==5 || argc==6,"targets prepare DATA RUNS OUTPUT, or targets verify DATA RUNS TARGETS OUTPUT_JSON");let mode=load64(argv+8);if pl_equal(mode,"prepare") && argc==5 {return op_prepare(vc_absolute(load64(argv+16)),vc_absolute(load64(argv+24)),vc_absolute(load64(argv+32)));}if pl_equal(mode,"verify") && argc==6 {return op_verify(vc_absolute(load64(argv+16)),vc_absolute(load64(argv+24)),vc_absolute(load64(argv+32)),vc_absolute(load64(argv+40)));}vc_require(0,"invalid pose target command");return 2;
}

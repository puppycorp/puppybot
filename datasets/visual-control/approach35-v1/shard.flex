// Disjoint native audit shards preserve both bytes and original split roles.
import "../../../flex/control/dataset.flex";
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==4,"shard DATA RUN_ROOT NEW_OUTPUT");let data=vc_map(load64(argv+8));let bytes=vc_size;let length=load64(data+24);vc_require(vd_row_bytes(data)==56 && load64(data+8)==128 && load64(data+16)==96 && length>=1 && length<=300 && bytes==32+128*length*21224,"invalid master dimensions");let run=vc_absolute(load64(argv+16));let output=vc_absolute(load64(argv+24));vc_mkdir(output);let stride=length*21224;let seen=alloc(128);pb_zero(seen,128);let text=alloc(32768);let b=alloc(32);pl_builder(b,text,32768);pl_text(b,"{\"episodes\":128,\"fittingEpisodes\":96,\"shards\":4,\"sourceSHA256\":");pj_text(b,vc_digest(data,bytes));pl_text(b,",\"allRowsCopiedByteExactly\":true,\"splitRolesPreserved\":true,\"records\":[");let worker=0;let count=0;
    while worker<4 {let root=vc_path(output,vc_int(worker));vc_mkdir(root);let size=32+32*stride;let shard=alloc(size);vc_copy(shard,data,32);store64(shard+8,32);store64(shard+16,24);let i=0;
        while i<32 {let original=worker*24+i;if i>=24 {original=96+worker*8+i-24;}vc_require(original>=0 && original<128 && !load8(seen+original) && (i<24)==(original<96),"audit shards lost a scene or changed its role");store8(seen+original,1);let from=data+32+original*stride;let to=shard+32+i*stride;vc_copy(to,from,stride);vc_require(pl_equal(vc_digest(from,stride),vc_digest(to,stride)),"audit shard row copy differs");
            let target=alloc(4096);let n=syscall(89,vc_path(run,vc_concat("expert-",vc_int(original))),target,4095,0,0,0);vc_require(n>0 && n<4096,"cannot resolve original recording link");store8(target+n,0);vc_require(!syscall(88,target,vc_path(root,vc_concat("expert-",vc_int(i))),0,0,0,0),"cannot link audit recording");
            if count {pl_text(b,",");}pl_text(b,"{\"shard\":");pl_int(b,worker);pl_text(b,",\"index\":");pl_int(b,i);pl_text(b,",\"datasetIndex\":");pl_int(b,original);pl_text(b,",\"fit\":");pj_bool_text(b,original<96);pl_text(b,"}");count=count+1;i=i+1;
        }vc_write(vc_path(root,"data.bin"),shard,size);syscall(11,shard,size,0,0,0,0);worker=worker+1;
    }vc_require(count==128,"audit shards omitted an original history");pl_text(b,"]}\n");vc_require(!load64(b+24),"shard receipt overflow");vc_write(vc_path(output,"report.json"),text,load64(b+8));return 0;
}

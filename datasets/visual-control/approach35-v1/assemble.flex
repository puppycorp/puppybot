// Select one physically completed history for every original scene identity.
// A recovery can replace a failed trajectory, never its original split role.
import "../../../flex/control/dataset.flex";
global da_sources=0;
global da_source_count=0;
fn da_source(path) {
    let i=0;while i<da_source_count {let source=da_sources+i*32;if pl_equal(load64(source),path) {return source;}i=i+1;}
    vc_require(da_source_count<64,"too many dataset sources");let data=vc_map(path);let bytes=vc_size;let n=load64(data+8);let length=load64(data+24);vc_require(vd_row_bytes(data)==56 && n>=2 && n<=256 && load64(data+16)>=1 && load64(data+16)<n && length>=1 && length<=300 && bytes==32+n*length*21224,"invalid recovery source dimensions");
    let source=da_sources+da_source_count*32;store64(source,path);store64(source+8,data);store64(source+16,bytes);store64(source+24,vc_digest(data,bytes));da_source_count=da_source_count+1;return source;
}
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==4,"assemble ARTIFACT_ROOT SELECTION_JSONL NEW_OUTPUT");let root=vc_absolute(load64(argv+8));let selection=vc_map(load64(argv+16));let selection_bytes=vc_size;let at=0;let line=alloc(8192);let records=alloc(128*80);let i=0;
    // Stream provenance: the bounded JSON parser is for one record at a time.
    while at<selection_bytes {let start=at;while at<selection_bytes && load8(selection+at)!=10 {at=at+1;}let size=at-start;if at<selection_bytes {at=at+1;}vc_require(i<128 && size>0 && size<8192,"invalid selection record count or size");vc_copy(line,selection+start,size);store8(line+size,0);let row=pj_parse(line,size);vc_require(row,pj_message);
        let record=records+i*80;vc_require(vc_json_int(row,"datasetIndex",0)==i && pj_boolean(row,"fit")== (i<96),"assembly changed split ordering");store64(record,vc_string(pj_string_field(row,"sourceData")));store64(record+8,vc_string(pj_string_field(row,"sourceRun")));store64(record+16,vc_json_int(row,"sourceIndex",0));store64(record+24,vc_json_int(row,"layout",0));store64(record+32,vc_json_int(row,"scene",0));store64(record+64,pj_boolean(row,"repaired"));if pj_get(row,"auditReceipt") {store64(record+72,vc_string(pj_string_field(row,"auditReceipt")));}i=i+1;
    }vc_require(i==128,"assembly must preserve all128 scenes");syscall(11,selection,selection_bytes,0,0,0,0);
    da_sources=alloc(64*32);let length=0;let steps=0;let student=0;let repaired=0;let audited=0;let verified_commands=0;let verified_increments=0;let seen=alloc(128);pb_zero(seen,128);i=0;
    while i<128 {let record=records+i*80;let source=da_source(load64(record));let data=load64(source+8);let index=load64(record+16);let layout=load64(record+24);let scene=load64(record+32);vc_require(index>=0 && index<load64(data+8) && layout>=0 && layout<8 && scene>=0 && scene<16 && (layout<6)==(i<96) && !load8(seen+layout*16+scene),"duplicate or misplaced scene identity");store8(seen+layout*16+scene,1);
        let run=vc_path(load64(record+8),vc_concat("expert-",vc_int(index)));let expected=vc_path(vc_path(vc_path(root,"scenes"),vc_int(layout)),vc_int(scene));vc_require(pl_equal(vc_file_sha(vc_path(expected,"case.json")),vc_file_sha(vc_path(run,"scene/case.json"))) && pl_equal(vc_file_sha(vc_path(expected,"environment.bin")),vc_file_sha(vc_path(run,"scene/environment.bin"))),"assembly substituted another physical scene");
        let result=vc_json_file(vc_path(run,"result.json"));vc_require(pj_boolean(result,"success"),"assembly attempted to admit a failed trajectory");let meta=vc_json_file(vc_path(run,"supervision.json"));vc_require(pj_boolean(meta,"denseOracleLabels") && !vc_json_int(meta,"burninActions",0) && pl_equal(pj_string_field(meta,"studentWeightsSHA256"),"1a7033fd0607ddbf2137fb082d5cf9a56b2e9d0fe485fc51bdb77725f91ce7f2"),"recovery changed label format or student checkpoint");let rollin=vc_json_int(meta,"studentActions",0);student=student+rollin;
        let t=load64(data+24);let base=data+32+index*t*21224;let count=0;while count<t && pb_u32(base+t*21168+count*56+44) {let row=base+t*21168+count*56;vc_require(pb_u32(row+44)==0x3f800000 && pb_u32(row+40)==0x3f800000 && !pb_u32(row+24),"invalid dense validity, supervision or reserved feedback");count=count+1;}vc_require(count>=1,"empty recovery history");
        if load64(record+72) {let receipt=vc_json_file(load64(record+72));vc_require(pj_boolean(receipt,"passed") && vc_json_int(receipt,"episodes",0)==1 && vc_json_int(receipt,"datasetEpisodes",0)==load64(data+8) && vc_json_int(receipt,"firstEpisode",0)==index && pl_equal(pj_string_field(receipt,"dataSHA256"),load64(source+24)),"audit receipt does not cover this exact source episode");
            vc_require(vc_json_int(receipt,"commands",0)==count && vc_json_int(receipt,"supervisedSteps",0)==count && vc_json_int(receipt,"studentRollinCommandsReplayed",0)==rollin && f64_eq(vc_json_real(receipt,"studentRollinMaxAbsError",0),0) && pj_boolean(receipt,"denseOracleLabels") && pj_boolean(receipt,"datasetInputsMatchActualRGBAndOwnFeedback") && pj_boolean(receipt,"executedCommandsMatchRecordings") && pj_boolean(receipt,"preActionAlignmentChecked") && pj_boolean(receipt,"zeroPaddingChecked") && pj_boolean(receipt,"taskEventHintAbsent"),"source audit is incomplete or differs from selected history");audited=audited+1;verified_commands=verified_commands+count;verified_increments=verified_increments+vc_json_int(receipt,"physicalMotionIncrements",0);
        }store64(record+40,source);store64(record+48,count);store64(record+56,run);length=pb_max(length,count);steps=steps+count;repaired=repaired+load64(record+64);i=i+1;
    }
    let size=32+128*length*21224;vc_require(size<=1073741824,"aggregate exceeds native reader capacity");let output=vc_absolute(load64(argv+24));vc_mkdir(output);let data=alloc(size);vc_copy(data,"PVDATA03",8);store64(data+8,128);store64(data+16,96);store64(data+24,length);let text=alloc(131072);let b=alloc(32);pl_builder(b,text,131072);pl_text(b,"{\"episodes\":128,\"fitTrajectories\":96,\"sequenceLength\":");pl_int(b,length);pl_text(b,",\"validActions\":");pl_int(b,steps);pl_text(b,",\"studentRollinActions\":");pl_int(b,student);pl_text(b,",\"repairedTrajectories\":");pl_int(b,repaired);pl_text(b,",\"verifiedHistories\":");pl_int(b,audited);pl_text(b,",\"verifiedCommands\":");pl_int(b,verified_commands);pl_text(b,",\"verifiedPhysicalMotionIncrements\":");pl_int(b,verified_increments);pl_text(b,",\"allSelectedHistoriesHaveAudits\":");pj_bool_text(b,audited==128);pl_text(b,",\"allOriginalSceneIdentitiesPreserved\":true,\"failedAttemptsRetained\":true,\"maximumBrickDistanceM\":0.35,\"sources\":[");i=0;
    while i<da_source_count {let source=da_sources+i*32;if i {pl_text(b,",");}pl_text(b,"{\"data\":");pj_text(b,load64(source));pl_text(b,",\"SHA256\":");pj_text(b,load64(source+24));pl_text(b,"}");i=i+1;}pl_text(b,"],\"records\":[");i=0;
    while i<128 {let record=records+i*80;let source=load64(record+40);let from_data=load64(source+8);let t=load64(from_data+24);let count=load64(record+48);let from=from_data+32+load64(record+16)*t*21224;let to=data+32+i*length*21224;vc_copy(to,from,count*21168);vc_copy(to+length*21168,from+t*21168,count*56);vc_require(!syscall(88,load64(record+56),vc_path(output,vc_concat("expert-",vc_int(i))),0,0,0,0),"cannot link selected history");
        if i {pl_text(b,",");}pl_text(b,"{\"index\":");pl_int(b,i);pl_text(b,",\"fit\":");pj_bool_text(b,i<96);pl_text(b,",\"layout\":");pl_int(b,load64(record+24));pl_text(b,",\"scene\":");pl_int(b,load64(record+32));pl_text(b,",\"sourceRun\":");pj_text(b,load64(record+8));pl_text(b,",\"sourceIndex\":");pl_int(b,load64(record+16));pl_text(b,",\"repaired\":");pj_bool_text(b,load64(record+64));if load64(record+72) {pl_text(b,",\"auditReceipt\":");pj_text(b,load64(record+72));}pl_text(b,"}");i=i+1;
    }vc_write(vc_path(output,"data.bin"),data,size);pl_text(b,"],\"dataSHA256\":");pj_text(b,vc_digest(data,size));pl_text(b,"}\n");vc_require(!load64(b+24),"assembly receipt overflow");vc_write(vc_path(output,"report.json"),text,load64(b+8));return 0;
}

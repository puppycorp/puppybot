// Aggregate successive on-policy datasets, preserving every history and split.
import "../../../flex/control/dataset.flex";
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==6,"merge-dense DATA_A RUN_A DATA_B RUN_B OUTPUT");let sources=alloc(16);let roots=alloc(16);let hashes=alloc(16);let n=0;let fit=0;let length=0;let source=0;
    while source<2 {let data=vc_map(load64(argv+8+source*16));let t=load64(data+24);let count=load64(data+8);let training=load64(data+16);vc_require(vd_row_bytes(data)==56 && count>=2 && training>=1 && training<count && t>=1 && t<=512 && vc_size==32+count*t*21224,"invalid dense source dataset");store64(sources+source*8,data);store64(roots+source*8,vc_absolute(load64(argv+16+source*16)));store64(hashes+source*8,vc_digest(data,vc_size));n=n+count;fit=fit+training;length=pb_max(length,t);source=source+1;}
    let size=32+n*length*21224;vc_require(n<=256 && size<=VC_MAX_FILE_BYTES,"dense aggregate exceeds limits");let merged=alloc(size);vc_copy(merged,"PVDATA03",8);store64(merged+8,n);store64(merged+16,fit);store64(merged+24,length);let output=vc_absolute(load64(argv+40));vc_mkdir(output);let text=alloc(65536);let b=alloc(32);pl_builder(b,text,65536);pl_text(b,"{\"runtime\":\"Flexscript\",\"pythonRequired\":false,\"preservesFitValidationSplits\":true,\"sourceSHA256\":[");pj_text(b,load64(hashes));pl_text(b,",");pj_text(b,load64(hashes+8));pl_text(b,"],\"records\":[");
    let split=0;let target=0;while split<2 {source=0;while source<2 {let data=load64(sources+source*8);let t=load64(data+24);let i=0;let end=load64(data+16);if split {i=end;end=load64(data+8);}
        while i<end {let from=data+32+i*t*21224;let to=merged+32+target*length*21224;vc_copy(to,from,t*21168);vc_copy(to+length*21168,from+t*21168,t*56);let original=vc_path(load64(roots+source*8),vc_concat("expert-",vc_int(i)));let alias=vc_path(output,vc_concat("expert-",vc_int(target)));vc_require(!syscall(88,original,alias,0,0,0,0),"cannot link source episode");
            if target {pl_text(b,",");}pl_text(b,"{\"index\":");pl_int(b,target);pl_text(b,",\"source\":");pl_int(b,source);pl_text(b,",\"sourceIndex\":");pl_int(b,i);pl_text(b,",\"fit\":");pj_bool_text(b,!split);pl_text(b,"}");target=target+1;i=i+1;
        }source=source+1;}split=split+1;}
    vc_require(target==n,"missing aggregate trajectories");vc_write(vc_path(output,"data.bin"),merged,size);pl_text(b,"],\"episodes\":");pl_int(b,n);pl_text(b,",\"fitTrajectories\":");pl_int(b,fit);pl_text(b,",\"sequenceLength\":");pl_int(b,length);pl_text(b,",\"dataSHA256\":");pj_text(b,vc_digest(merged,size));pl_text(b,"}\n");vc_require(!load64(b+24),"aggregate receipt exceeded capacity");vc_write(vc_path(output,"report.json"),text,load64(b+8));return 0;
}

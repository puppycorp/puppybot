    }
    vc_require(records==4829 && seen_fit==3864 && seen_val==965,"target candidate totals differ from accepted survey");vc_write(vc_path(output,"targets.bin"),labels,size);let text=alloc(4096);let b=alloc(32);pl_builder(b,text,4096);pl_text(b,"{\"passed\":true,\"runtime\":\"Flexscript\",\"pythonRequired\":false,\"sourceDataSHA256\":\"05032e0eb2a4a98a7f0146db66195792b2c22fe3bda3138039e9c721bc69b284\",\"candidateManifestSHA256\":\"fe68a25604f6dac3146e3113d5c2a1e5cf81b74c0e1519127f6b6001248169ca\",\"targetsSHA256\":");pj_text(b,vc_digest(labels,size));pl_text(b,",\"episodes\":172,\"fittingHistories\":136,\"validationHistories\":36,\"sequenceLength\":354,\"fittingCandidates\":3864,\"validationCandidates\":965,\"projectionAndPixelsIndependentlyRechecked\":true,\"visibilityHeuristicNotProvenSegmentation\":true,\"actorInputsUnchanged\":true}\n");vc_require(!load64(b+24),"target label receipt overflow");vc_write(vc_path(output,"receipt.json"),text,load64(b+8));return 0;
}

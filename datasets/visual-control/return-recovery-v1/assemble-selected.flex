        store64(r,vc_string(pj_string_field(row,"sourceData")));store64(r+8,vc_string(pj_string_field(row,"sourceRun")));store64(r+16,vc_json_int(row,"episodeIndex",0));store64(r+24,vc_json_int(row,"worker",0));store64(r+32,vc_json_int(row,"catalogIndex",0));store64(r+40,vc_string(pj_string_field(row,"auditReceipt")));i=i+1;
    }vc_require(i==32,"selection must preserve all32 correction scenes");syscall(11,selection,bytes,0,0,0,0);rr_sources=alloc(64*32);let seen=alloc(32);let length=0;let steps=0;let student=0;i=0;
    while i<32 {let r=records+i*96;let worker=load64(r+24);let original=load64(r+32);vc_require(worker>=0 && worker<4 && original>=0 && original<8 && (original<6)==(i<24) && !load8(seen+worker*8+original),"duplicate or misplaced correction scene");store8(seen+worker*8+original,1);let source=rr_source(load64(r));let data=load64(source+8);let index=load64(r+16);vc_require(index>=0 && index<load64(data+8) && (index<load64(data+16))==(i<24),"selection changed the source history split role");
        let run=vc_path(load64(r+8),vc_concat("expert-",vc_int(index)));let expected=vc_path(vc_path(vc_path(root,"catalogs"),vc_int(worker)),vc_int(original));vc_require(pl_equal(vc_file_sha(vc_path(expected,"case.json")),vc_file_sha(vc_path(run,"scene/case.json"))) && pl_equal(vc_file_sha(vc_path(expected,"environment.bin")),vc_file_sha(vc_path(run,"scene/environment.bin"))),"selection substituted another physical scene");
        let result=vc_json_file(vc_path(run,"result.json"));vc_require(pj_boolean(result,"success"),"selection attempted to admit a failed history");let meta=vc_json_file(vc_path(run,"supervision.json"));vc_require(pj_boolean(meta,"denseOracleLabels") && !vc_json_int(meta,"burninActions",0) && pl_equal(pj_string_field(meta,"studentWeightsSHA256"),"8aeffe83f433ebf53d03974a99058caa65f78a2f592b128214df7857befceaf5") && pj_boolean(meta,"studentBeginsAfterConsumption")== (worker<2),"selection changed the student or correction mode");let rollin=vc_json_int(meta,"studentActions",0);let warmup=vc_json_int(meta,"studentStartAction",0);let t=load64(data+24);let base=data+32+index*t*21224;let count=0;
        while count<t && pb_u32(base+t*21168+count*56+44) {let row=base+t*21168+count*56;vc_require(pb_u32(row+44)==0x3f800000 && pb_u32(row+40)==0x3f800000 && !pb_u32(row+24),"invalid dense input or supervision mask");count=count+1;}vc_require(count>=1 && rollin>=1 && rollin<=count && warmup>=0 && warmup+rollin<=count,"invalid correction history length");
        let audit=vc_json_file(load64(r+40));let first=vc_json_int(audit,"firstEpisode",0);let audited=vc_json_int(audit,"episodes",0);let commands=vc_json_int(audit,"commands",0);let replayed=vc_json_int(audit,"studentRollinCommandsReplayed",0);vc_require(pj_boolean(audit,"passed") && vc_json_int(audit,"datasetEpisodes",0)==load64(data+8) && first>=0 && audited>=1 && first+audited<=load64(data+8) && index>=first && index<first+audited && pl_equal(pj_string_field(audit,"dataSHA256"),load64(source+24)),"audit does not cover the selected source SHA and episode");
        vc_require(commands>=count && vc_json_int(audit,"supervisedSteps",0)==commands && replayed>=rollin && f64_eq(vc_json_real(audit,"studentRollinMaxAbsError",0),0) && vc_json_int(audit,"physicalMotionIncrements",0)>=commands*10 && pj_boolean(audit,"denseOracleLabels") && pj_boolean(audit,"datasetInputsMatchActualRGBAndOwnFeedback") && pj_boolean(audit,"executedCommandsMatchRecordings") && pj_boolean(audit,"preActionAlignmentChecked") && pj_boolean(audit,"zeroPaddingChecked") && pj_boolean(audit,"taskEventHintAbsent"),"selected source audit is incomplete");if audited==1 {vc_require(commands==count && replayed==rollin,"single-episode audit differs from its history");}
        store64(r+48,source);store64(r+56,count);store64(r+64,run);store64(r+72,rollin);store64(r+80,warmup);length=pb_max(length,count);steps=steps+count;student=student+rollin;i=i+1;
    }
    let output=vc_absolute(load64(argv+24));vc_mkdir(output);let size=32+32*length*21224;let data=alloc(size);vc_copy(data,"PVDATA03",8);store64(data+8,32);store64(data+16,24);store64(data+24,length);let text=alloc(65536);let b=alloc(32);pl_builder(b,text,65536);pl_text(b,"{\"episodes\":32,\"fitTrajectories\":24,\"allSelectedHistoriesHaveAudits\":true,\"allOriginalSceneIdentitiesPreserved\":true,\"splitRolesPreserved\":true,\"maximumBrickDistanceM\":0.35,\"validActions\":");pl_int(b,steps);pl_text(b,",\"studentRollinCommands\":");pl_int(b,student);pl_text(b,",\"sequenceLength\":");pl_int(b,length);pl_text(b,",\"sources\":[");i=0;
    while i<rr_source_count {let s=rr_sources+i*32;vc_require(pl_equal(vc_digest(load64(s+8),load64(s+16)),load64(s+24)),"correction source changed during assembly");if i {pl_char(b,44);}pl_text(b,"{\"data\":");pj_text(b,load64(s));pl_text(b,",\"SHA256\":");pj_text(b,load64(s+24));pl_char(b,125);i=i+1;}pl_text(b,"],\"records\":[");i=0;
    while i<32 {let r=records+i*96;let source=load64(r+48);let original_data=load64(source+8);let t=load64(original_data+24);let count=load64(r+56);let from=original_data+32+load64(r+16)*t*21224;let to=data+32+i*length*21224;vc_copy(to,from,count*21168);vc_copy(to+length*21168,from+t*21168,count*56);vc_require(!syscall(88,load64(r+64),vc_path(output,vc_concat("expert-",vc_int(i))),0,0,0,0),"cannot link selected recording");
        if i {pl_char(b,44);}pl_text(b,"{\"index\":");pl_int(b,i);pl_text(b,",\"fit\":");pj_bool_text(b,i<24);pl_text(b,",\"worker\":");pl_int(b,load64(r+24));pl_text(b,",\"catalogIndex\":");pl_int(b,load64(r+32));pl_text(b,",\"layout\":");pl_int(b,load64(r+32));pl_text(b,",\"scene\":");pl_int(b,(load64(r+24)*3+load64(r+32)*2)%16);pl_text(b,",\"sourceData\":");pj_text(b,load64(r));pl_text(b,",\"sourceEpisode\":");pl_int(b,load64(r+16));pl_text(b,",\"sourceSHA256\":");pj_text(b,load64(source+24));pl_text(b,",\"auditReceipt\":");pj_text(b,load64(r+40));pl_text(b,",\"auditReceiptSHA256\":");pj_text(b,vc_file_sha(load64(r+40)));pl_text(b,",\"studentCommands\":");pl_int(b,load64(r+72));pl_text(b,",\"studentWarmupActions\":");pl_int(b,load64(r+80));pl_char(b,125);i=i+1;
    }vc_write(vc_path(output,"data.bin"),data,size);pl_text(b,"],\"dataSHA256\":");pj_text(b,vc_digest(data,size));pl_text(b,"}\n");vc_require(!load64(b+24),"selection report overflow");vc_write(vc_path(output,"report.json"),text,load64(b+8));return 0;

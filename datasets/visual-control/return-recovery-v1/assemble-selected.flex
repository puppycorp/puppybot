import "../../../flex/control/dataset.flex";
global rr_sources=0;
global rr_source_count=0;
fn rr_source(path) {
    let i=0;while i<rr_source_count {let source=rr_sources+i*32;if pl_equal(load64(source),path) {return source;}i=i+1;}
    vc_require(rr_source_count<64,"too many correction sources");let data=vc_map(path);let bytes=vc_size;let n=load64(data+8);let fit=load64(data+16);let t=load64(data+24);vc_require(vd_row_bytes(data)==56 && n>=2 && n<=64 && fit>=1 && fit<n && t>=1 && t<=512 && bytes==32+n*t*21224,"invalid correction source");
    let source=rr_sources+rr_source_count*32;store64(source,path);store64(source+8,data);store64(source+16,bytes);store64(source+24,vc_digest(data,bytes));rr_source_count=rr_source_count+1;return source;
}

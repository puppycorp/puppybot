// Preserve an audited base sample without changing original layout split roles.
import "../../../flex/control/dataset.flex";
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==4,"subset BASE_DATA BASE_RUN OUTPUT");let source=vc_map(load64(argv+8));let bytes=vc_size;let t=load64(source+24);vc_require(vd_row_bytes(source)==56 && load64(source+8)==128 && load64(source+16)==96 && t>=1 && t<=512 && bytes==32+128*t*21224,"invalid base corpus");let sha=vc_digest(source,bytes);vc_require(pl_equal(sha,"e45f28097f8f58b00b915b026c921b9013334c3795be205aca0dce2c13c3a148"),"base corpus changed");
    let size=32+64*t*21224;let data=alloc(size);vc_copy(data,source,32);store64(data+8,64);store64(data+16,48);let output=vc_absolute(load64(argv+24));let run=vc_absolute(load64(argv+16));vc_mkdir(output);let text=alloc(16384);let b=alloc(32);pl_builder(b,text,16384);pl_text(b,"{\"episodes\":64,\"fitTrajectories\":48,\"sourceSHA256\":");pj_text(b,sha);pl_text(b,",\"allRowsCopiedByteExactly\":true,\"splitRolesPreserved\":true,\"records\":[");let i=0;
    while i<64 {let original=(i/8)*16+i%8;if i>=48 {original=96+((i-48)/8)*16+(i-48)%8;}vc_require((original<96)==(i<48),"subset changed an original split role");let from=source+32+original*t*21224;let to=data+32+i*t*21224;vc_copy(to,from,t*21224);vc_require(pl_equal(vc_digest(from,t*21224),vc_digest(to,t*21224)),"subset history copy differs");vc_require(!syscall(88,vc_path(run,vc_concat("expert-",vc_int(original))),vc_path(output,vc_concat("expert-",vc_int(i))),0,0,0,0),"cannot link base recording");
        if i {pl_char(b,44);}pl_text(b,"{\"index\":");pl_int(b,i);pl_text(b,",\"sourceIndex\":");pl_int(b,original);pl_text(b,",\"fit\":");pj_bool_text(b,i<48);pl_text(b,"}");i=i+1;
    }vc_write(vc_path(output,"data.bin"),data,size);pl_text(b,"],\"dataSHA256\":");pj_text(b,vc_digest(data,size));pl_text(b,"}\n");vc_require(!load64(b+24),"subset receipt overflow");vc_write(vc_path(output,"report.json"),text,load64(b+8));return 0;
}

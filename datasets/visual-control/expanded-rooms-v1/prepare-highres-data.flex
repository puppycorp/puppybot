// Convert audited RGB histories to an explicitly tagged 128x128 dataset.
import "../../../flex/control/verify.flex";
global rh_fd=0;
fn rh_create(path,size) {
    rh_fd=syscall(2,path,0x800c2,384,0,0,0);vc_require(rh_fd>=0,"cannot create high-resolution temporary data");vc_require(!syscall(77,rh_fd,size,0,0,0,0),"cannot allocate high-resolution output file");let data=syscall(9,0,size,3,1,rh_fd,0);vc_require(data>0,"cannot map high-resolution output file");return data;
}
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==5,"prepare-highres-data DATA RUNS AUDIT NEW_OUTPUT");let path=vc_absolute(load64(argv+8));let runs=vc_absolute(load64(argv+16));let audit_path=vc_absolute(load64(argv+24));let output=vc_absolute(load64(argv+32));let data=vc_map(path);let bytes=vc_size;let n=load64(data+8);let fit=load64(data+16);let length=load64(data+24);vc_require(vd_row_bytes(data)==56 && n>=2 && n<=256 && fit>=1 && fit<n && length>=1 && length<=512 && bytes==32+n*length*21224,"invalid source demonstration dimensions");let size=32+n*length*(49152+56);vc_require(size<=8589934592,"128x128 dataset exceeds the 8 GiB limit");let sha=vc_digest(data,bytes);let audit=vc_json_file(audit_path);vc_require(pj_boolean(audit,"passed") && pj_boolean(audit,"datasetInputsMatchActualRGBAndOwnFeedback") && pj_boolean(audit,"executedCommandsMatchRecordings") && pj_boolean(audit,"denseOracleLabels") && pj_boolean(audit,"preActionAlignmentChecked") && pj_boolean(audit,"zeroPaddingChecked") && pj_boolean(audit,"taskEventHintAbsent") && vc_json_int(audit,"firstEpisode",0)==0 && vc_json_int(audit,"episodes",0)==n && vc_json_int(audit,"datasetEpisodes",0)==n && f64_eq(pj_real(audit,"studentRollinMaxAbsError"),0) && pl_equal(pj_string_field(audit,"dataSHA256"),sha),"source data does not match its complete replay audit");
    vc_mkdir(output);let temporary=vc_path(output,"data.partial");let target=rh_create(temporary,size);vc_copy(target,"PVDAT128",8);store64(target+8,n);store64(target+16,fit);store64(target+24,length);let raw=alloc(640*480*3);let old_image=alloc(21168);let compare=ffi_symbol(ffi_open("libc.so.6"),"memcmp");vc_require(compare,"memcmp unavailable");let total=0;let episode=0;
    while episode<n {let run=vc_path(runs,vc_concat("expert-",vc_int(episode)));let initial=vc_json_file(vc_path(run,"initial.json"));let frame=vc_json_int(initial,"totalSteps",0);let source=data+32+episode*length*21224;let dest=target+32+episode*length*(49152+56);let t=0;va_lines(vc_path(run,"decisions.jsonl"));
        while t<length && vd_valid_word(source+length*21168+t*56,56) {let values=source+length*21168+t*56;vc_require(!pb_u32(values+24),"source contains a task-event hint");let png=vc_path(vc_path(run,"sensor"),vc_concat(vc_concat("frame-",vc_int(frame)),".png"));va_png(png,raw);vc_resize(raw,old_image);vc_require(!ffi_call(compare,old_image,source+t*21168,21168,0,0,0),"recorded camera frame differs from audited 84x84 input");vc_resize_to(raw,dest+t*49152,128);vc_copy(dest+length*49152+t*56,values,56);let row=va_next();vc_require(row && vc_json_int(row,"step",0)==frame+10,"source command history is not frame-aligned");let action=pj_get(row,"action");vc_require(pb_u32(values+48)==pb_f64_to_f32(pj_real_node(pj_index(action,0))) && pb_u32(values+52)==pb_f64_to_f32(pj_real_node(pj_index(action,1))),"source executed command differs from recording");frame=vc_json_int(row,"step",0);t=t+1;}
        vc_require(t>0 && !va_next(),"source demonstration history is incomplete");total=total+t;syscall(11,va_data,va_length,0,0,0,0);episode=episode+1;
    }
    vc_require(!syscall(26,target,size,4,0,0,0) && !syscall(74,rh_fd,0,0,0,0,0),"cannot persist high-resolution data");let target_sha=vc_digest(target,size);vc_require(!syscall(11,target,size,0,0,0,0) && !syscall(3,rh_fd,0,0,0,0,0) && !syscall(82,temporary,vc_path(output,"data.bin"),0,0,0,0),"cannot publish high-resolution data");let text=alloc(2048);let b=alloc(32);pl_builder(b,text,2048);pl_text(b,"{\"passed\":true,\"runtime\":\"Flexscript\",\"pythonRequired\":false,\"format\":\"PVDAT128\",\"imageWidth\":128,\"imageHeight\":128,\"episodes\":");pl_int(b,n);pl_text(b,",\"fittingHistories\":");pl_int(b,fit);pl_text(b,",\"validationHistories\":");pl_int(b,n-fit);pl_text(b,",\"sequenceLength\":");pl_int(b,length);pl_text(b,",\"validFrames\":");pl_int(b,total);pl_text(b,",\"sourceDataSHA256\":");pj_text(b,sha);pl_text(b,",\"dataSHA256\":");pj_text(b,target_sha);pl_text(b,",\"fullFieldExactAreaResize\":true,\"original84PixelsRechecked\":true,\"executedCommandsRechecked\":true,\"ownFeedbackAndLabelsPreserved\":true,\"taskEventHintAbsent\":true,\"zeroPadding\":true}\n");vc_require(!load64(b+24),"high-resolution data receipt overflow");vc_write(vc_path(output,"receipt.json"),text,load64(b+8));return 0;
}

// Exploratory subset of audited correction histories. It is not a benchmark
// or a replacement for the full corpus and preserves every selected sequence.
import "../../../flex/control/target-supervision.flex";
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==5,"probe-subset DATA TARGETS RUNS NEW_OUTPUT");let source=vc_map(vc_absolute(load64(argv+8)));let bytes=vc_size;let n=load64(source+8);let fit=load64(source+16);let length=load64(source+24);vc_require(vd_row_bytes(source)==56 && n==202 && fit==160 && length==354 && bytes==32+n*length*21224 && pl_equal(vc_digest(source,bytes),"ad8bf0288486b26d67b89a6baa8908e275386cbe0deaea053a605ba259038c34"),"unexpected admitted source corpus");
    pt_target_open(vc_absolute(load64(argv+16)),source,bytes,56);let target_bytes=32+n*length*12;vc_require(pl_equal(vc_digest(pt_target_data,target_bytes),"47b75b0118230dc5101945f59201980311ba4deae6e63faa7d75f5b6b8d04ae3"),"unexpected admitted target sidecar");let runs=vc_absolute(load64(argv+24));let output=vc_absolute(load64(argv+32));vc_mkdir(output);let target_dir=vc_path(output,"targets");vc_mkdir(target_dir);let selection=alloc(64);store64(selection,136);store64(selection+8,140);store64(selection+16,144);store64(selection+24,148);store64(selection+32,152);store64(selection+40,156);store64(selection+48,196);store64(selection+56,197);
    let data_bytes=32+8*length*21224;let data=alloc(data_bytes);vc_copy(data,"PVDATA03",8);store64(data+8,8);store64(data+16,6);store64(data+24,length);let labels_bytes=32+8*length*12;let labels=alloc(labels_bytes);vc_copy(labels,"PVVIS001",8);store64(labels+8,8);store64(labels+16,6);store64(labels+24,length);let counts=alloc(16);let episode=0;
    while episode<8 {let index=load64(selection+episode*8);vc_require(index<n && (index<fit)==(episode<6),"subset changed source split");vc_copy(data+32+episode*length*21224,source+32+index*length*21224,length*21224);vc_copy(labels+32+episode*length*12,pt_target_data+32+index*length*12,length*12);let t=0;while t<length {if pb_u32(labels+32+(episode*length+t)*12+8) {let group=episode>=6;store64(counts+group*8,load64(counts+group*8)+1);}t=t+1;}let source_run=vc_path(runs,vc_concat("expert-",vc_int(index)));vc_require(!syscall(88,source_run,vc_path(output,vc_concat("expert-",vc_int(episode))),0,0,0,0),"cannot link subset recording");episode=episode+1;}
    vc_require(load64(counts)>0 && load64(counts+8)>0,"subset has no candidate labels in a split");let data_sha=vc_digest(data,data_bytes);let label_sha=vc_digest(labels,labels_bytes);vc_write(vc_path(output,"data.bin"),data,data_bytes);vc_write(vc_path(target_dir,"targets.bin"),labels,labels_bytes);
    let text=alloc(4096);let b=alloc(32);pl_builder(b,text,4096);pl_text(b,"{\"passed\":true,\"sourceDataSHA256\":");pj_text(b,data_sha);pl_text(b,",\"targetsSHA256\":");pj_text(b,label_sha);pl_text(b,",\"episodes\":8,\"fittingHistories\":6,\"validationHistories\":2,\"sequenceLength\":354,\"fittingCandidates\":");pl_int(b,load64(counts));pl_text(b,",\"validationCandidates\":");pl_int(b,load64(counts+8));pl_text(b,",\"projectionAndPixelsIndependentlyRechecked\":true,\"visibilityHeuristicNotProvenSegmentation\":true,\"actorInputsUnchanged\":true}\n");vc_require(!load64(b+24),"subset target receipt overflow");vc_write(vc_path(target_dir,"receipt.json"),text,load64(b+8));
    pl_builder(b,text,4096);pl_text(b,"{\"exploratory\":true,\"selection\":\"six new fitting histories selected after inspecting development failures; two validation histories\",\"sourceDataSHA256\":\"ad8bf0288486b26d67b89a6baa8908e275386cbe0deaea053a605ba259038c34\",\"sourceTargetsSHA256\":\"47b75b0118230dc5101945f59201980311ba4deae6e63faa7d75f5b6b8d04ae3\",\"sourceIndices\":[136,140,144,148,152,156,196,197],\"fittingHistories\":6,\"validationHistories\":2,\"sequenceLength\":354,\"completeSourceSequencesPreserved\":true,\"dataSHA256\":");pj_text(b,data_sha);pl_text(b,",\"targetsSHA256\":");pj_text(b,label_sha);pl_text(b,"}\n");vc_require(!load64(b+24),"subset report overflow");vc_write(vc_path(output,"report.json"),text,load64(b+8));return 0;
}

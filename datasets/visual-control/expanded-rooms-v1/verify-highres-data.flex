// Independently reproduce 128x128 images using separable area integration.
import "../../../flex/control/verify.flex";
fn hv_resize(raw,out,horizontal) {
    let y=0;while y<480 {let x=0;while x<128 {let c=0;while c<3 {let sum=0;let k=0;while k<5 {sum=sum+load8(raw+(y*640+x*5+k)*3+c);k=k+1;}pb_put32(horizontal+((c*480+y)*128+x)*4,sum*128);c=c+1;}x=x+1;}y=y+1;}
    y=0;while y<128 {let x=0;while x<128 {let c=0;while c<3 {let sum=0;let iy=y*480/128;while iy*128<(y+1)*480 {let weight=pb_min((iy+1)*128,(y+1)*480)-pb_max(iy*128,y*480);sum=sum+pb_u32(horizontal+((c*480+iy)*128+x)*4)*weight;iy=iy+1;}let value=sum/307200;let remainder=sum%307200;if remainder>153600 || (remainder==153600 && (value&1)) {value=value+1;}store8(out+(c*128+y)*128+x,value);c=c+1;}x=x+1;}y=y+1;}return 0;
}
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==5,"verify-highres-data SOURCE_DATA RUNS HIGHRES_DIRECTORY OUTPUT_JSON");let source=vc_map(vc_absolute(load64(argv+8)));let source_bytes=vc_size;let n=load64(source+8);let fit=load64(source+16);let length=load64(source+24);vc_require(vd_row_bytes(source)==56 && n>=2 && n<=256 && fit>=1 && fit<n && length>=1 && length<=512 && source_bytes==32+n*length*21224,"invalid source data");let source_sha=vc_digest(source,source_bytes);let directory=vc_absolute(load64(argv+24));let high=vc_map_highres(vc_path(directory,"data.bin"));let high_bytes=vc_size;vc_require(load64(high+8)==n && load64(high+16)==fit && load64(high+24)==length && high_bytes==32+n*length*(49152+56),"invalid high-resolution data dimensions");let high_sha=vc_digest(high,high_bytes);let receipt=vc_json_file(vc_path(directory,"receipt.json"));vc_require(pj_boolean(receipt,"passed") && pj_boolean(receipt,"taskEventHintAbsent") && vc_json_int(receipt,"imageWidth",0)==128 && vc_json_int(receipt,"imageHeight",0)==128 && vc_json_int(receipt,"episodes",0)==n && pl_equal(pj_string_field(receipt,"sourceDataSHA256"),source_sha) && pl_equal(pj_string_field(receipt,"dataSHA256"),high_sha),"high-resolution receipt mismatch");
    let runs=vc_absolute(load64(argv+16));let compare=ffi_symbol(ffi_open("libc.so.6"),"memcmp");vc_require(compare,"memcmp unavailable");let raw=alloc(640*480*3);let reference=alloc(49152);let horizontal=alloc(480*128*3*4);let frames=0;let episode=0;
    while episode<n {let run=vc_path(runs,vc_concat("expert-",vc_int(episode)));let initial=vc_json_file(vc_path(run,"initial.json"));let frame=vc_json_int(initial,"totalSteps",0);let old=source+32+episode*length*21224;let next=high+32+episode*length*(49152+56);let t=0;va_lines(vc_path(run,"decisions.jsonl"));while t<length {let old_values=old+length*21168+t*56;let new_values=next+length*49152+t*56;vc_require(!ffi_call(compare,old_values,new_values,56,0,0,0) && !pb_u32(new_values+24),"feedback or label changed");if vd_valid_word(old_values,56) {let png=vc_path(vc_path(run,"sensor"),vc_concat(vc_concat("frame-",vc_int(frame)),".png"));va_png(png,raw);hv_resize(raw,reference,horizontal);vc_require(!ffi_call(compare,reference,next+t*49152,49152,0,0,0),"128x128 image differs from independent area reference");let row=va_next();vc_require(row && vc_json_int(row,"step",0)==frame+10,"recorded command frame mismatch");frame=vc_json_int(row,"step",0);frames=frames+1;}else {let i=0;while i<49152 {vc_require(!load8(next+t*49152+i),"high-resolution image padding is nonzero");i=i+1;}}t=t+1;}vc_require(!va_next(),"recording contains extra commands");syscall(11,va_data,va_length,0,0,0,0);episode=episode+1;}
    let text=alloc(1024);let b=alloc(32);pl_builder(b,text,1024);pl_text(b,"{\"passed\":true,\"runtime\":\"Flexscript\",\"pythonRequired\":false,\"episodes\":");pl_int(b,n);pl_text(b,",\"framesVerified\":");pl_int(b,frames);pl_text(b,",\"sourceDataSHA256\":");pj_text(b,source_sha);pl_text(b,",\"dataSHA256\":");pj_text(b,high_sha);pl_text(b,",\"independentSeparableAreaReference\":true,\"feedbackAndLabelsIdentical\":true,\"taskEventHintAbsent\":true,\"zeroPaddingChecked\":true}\n");vc_require(!load64(b+24),"high-resolution audit report overflow");vc_write(vc_absolute(load64(argv+32)),text,load64(b+8));return 0;
}

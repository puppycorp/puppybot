// Rebind unchanged image-coordinate labels to independently checked RGB data.
import "../../../flex/control/target-supervision.flex";
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==5,"retarget-highres SOURCE_DATA SOURCE_TARGETS HIGHRES_DIRECTORY OUTPUT");
    let source=vc_map(vc_absolute(load64(argv+8)));let source_bytes=vc_size;let source_sha=vc_digest(source,source_bytes);let targets=vc_absolute(load64(argv+16));let directory=vc_absolute(load64(argv+24));let output=vc_absolute(load64(argv+32));
    vc_require(vd_row_bytes(source)==56,"source must be 84x84 PVDATA03");pt_target_open(targets,source,source_bytes,56);let target_bytes=vc_size;let target_sha=vc_digest(pt_target_data,target_bytes);
    let old=vc_json_file(vc_path(targets,"receipt.json"));let n=load64(source+8);let fit=load64(source+16);let length=load64(source+24);let fit_candidates=vc_json_int(old,"fittingCandidates",0);let val_candidates=vc_json_int(old,"validationCandidates",0);
    let high=vc_map_highres(vc_path(directory,"data.bin"));let high_bytes=vc_size;let high_sha=vc_digest(high,high_bytes);vc_require(load64(high+8)==n && load64(high+16)==fit && load64(high+24)==length && high_bytes==32+n*length*(49152+56),"high-resolution dimensions differ");
    let audit=vc_json_file(vc_path(directory,"independent-audit.json"));vc_require(pj_boolean(audit,"passed") && pj_boolean(audit,"independentSeparableAreaReference") && pj_boolean(audit,"feedbackAndLabelsIdentical") && pj_boolean(audit,"taskEventHintAbsent") && pj_boolean(audit,"zeroPaddingChecked") && vc_json_int(audit,"episodes",0)==n && pl_equal(pj_string_field(audit,"sourceDataSHA256"),source_sha) && pl_equal(pj_string_field(audit,"dataSHA256"),high_sha),"independent high-resolution audit does not match");
    let compare=ffi_symbol(ffi_open("libc.so.6"),"memcmp");vc_require(compare,"memcmp unavailable");let episode=0;while episode<n {let a=source+32+episode*length*21224+length*21168;let b=high+32+episode*length*(49152+56)+length*49152;vc_require(!ffi_call(compare,a,b,length*56,0,0,0),"feedback or labels differ");episode=episode+1;}
    vc_mkdir(output);vc_write(vc_path(output,"targets.bin"),pt_target_data,target_bytes);let text=alloc(2048);let b=alloc(32);pl_builder(b,text,2048);pl_text(b,"{\"passed\":true,\"runtime\":\"Flexscript\",\"pythonRequired\":false,\"sourceDataSHA256\":");pj_text(b,high_sha);pl_text(b,",\"originalDataSHA256\":");pj_text(b,source_sha);pl_text(b,",\"targetsSHA256\":");pj_text(b,target_sha);pl_text(b,",\"episodes\":");pl_int(b,n);pl_text(b,",\"fittingHistories\":");pl_int(b,fit);pl_text(b,",\"validationHistories\":");pl_int(b,n-fit);pl_text(b,",\"sequenceLength\":");pl_int(b,length);pl_text(b,",\"fittingCandidates\":");pl_int(b,fit_candidates);pl_text(b,",\"validationCandidates\":");pl_int(b,val_candidates);pl_text(b,",\"projectionAndPixelsIndependentlyRechecked\":true,\"visibilityHeuristicNotProvenSegmentation\":true,\"actorInputsUnchanged\":true,\"fullFieldResizePreservesCoordinates\":true}\n");vc_require(!load64(b+24),"target receipt overflow");vc_write(vc_path(output,"receipt.json"),text,load64(b+8));pt_target_open_with_image(output,high,high_bytes,56,49152);return 0;
}

// Replay a policy's recurrent state and compare its training-only pose head
// against recorded physical poses. Reference positions never enter the actor.
import "../../../flex/control/verify.flex";
import "../../../flex/control/actions.flex";
import "pose-memory-math.flex";

fn qp_parameter(data,bytes,name,count,rank,first,second) {
    vc_require(bytes>=32 && load64(data)==load64("PUPV0001") && load64(data+8)<=4096 && load64(data+16)==32+load64(data+8)*256 && load64(data+16)<=bytes && load64(data+24)==bytes-load64(data+16),"invalid pose-probe checkpoint");let found=0;let i=0;
    while i<load64(data+8) {let row=data+32+i*256;if pl_equal(row,name) {vc_require(!found && load64(row+192)==rank && load64(row+200)==count && load64(row+216)==first && (rank==1 || load64(row+224)==second) && load64(row+208)>=0 && load64(row+208)<=bytes-load64(data+16) && count*4<=bytes-load64(data+16)-load64(row+208),"invalid pose-readout parameter");found=data+load64(data+16)+load64(row+208);}i=i+1;}vc_require(found,"missing pose-readout parameter");return found;
}
fn qp_mean(builder,total,count) {if count {pl_float(builder,f64_div(total,f64_from_i64(count)));}else {pl_text(builder,"null");}return 0;}
fn main(argc,argv) {
    vc_init(argc,argv);vc_pixels_init();vc_require(argc==4,"pose-memory-probe POLICY AUTONOMOUS_EPISODE NEW_OUTPUT");let policy=vc_absolute(load64(argv+8));let run=vc_absolute(load64(argv+16));let output=vc_absolute(load64(argv+24));vc_mkdir(output);
    let meta=vc_json_file(vc_path(policy,"receipt.json"));let sha=vc_string(pj_string_field(meta,"weightsSHA256"));vc_require(pj_boolean(meta,"memoryPoseAuxiliary") && pj_boolean(meta,"phaseGatedNavigation") && vc_json_int(meta,"memoryWidth",0)==256 && !pj_boolean(meta,"taskFeedback") && pl_equal(vc_file_sha(vc_path(policy,"weights.bin")),sha) && pl_equal(vc_file_sha(vc_path(policy,"policy")),pj_string_field(meta,"binarySHA256")),"pose probe policy hash mismatch");
    let audit=vc_json_file(vc_path(run,"../verified/result.json"));vc_require(pj_boolean(audit,"passed") && !pj_real(audit,"commandReplayMaxAbsError") && pj_boolean(audit,"returnPoseChecked") && pj_boolean(audit,"taskEventHintAbsent") && pl_equal(pj_string_field(audit,"weightsSHA256"),sha),"pose probe requires an audited autonomous history");
    let data=vc_map(vc_path(policy,"weights.bin"));let bytes=vc_size;let weights=qp_parameter(data,bytes,"critic.pose.weight_T",1024,2,256,4);let bias=qp_parameter(data,bytes,"critic.pose.bias",4,1,4,0);
    let args=vc_args();vc_add(args,vc_path(policy,"policy"));vc_add(args,vc_path(policy,"weights.bin"));vc_add(args,sha);vc_add(args,vc_path(policy,"kernels"));vc_add(args,"3");vc_add(args,"--raw");let process=vc_spawn(args,vc_path(output,"policy.log"),0,1);let magic=alloc(8);vc_io(1,load64(process+8),magic,8);vc_require(load64(magic)==load64("VCR25601"),"pose probe handshake mismatch");
    let hidden=alloc(1024);pb_zero(hidden,1024);let input=alloc((21168+7+256)*4);let response=alloc(263*4);let action=alloc(8);let expected_feedback=alloc(28);let expected_rgb=0;let initial=vc_json_file(vc_path(run,"initial.json"));let origin=alloc(24);let pose=alloc(24);ve_pose_read(initial,origin);vc_copy(pose,origin,24);let frame=vc_json_int(initial,"totalSteps",0);let phase=vc_json_int(initial,"findReturn","consumedIndex")>=0;va_lines(vc_path(run,"decisions.jsonl"));let row=va_next();
    let target=alloc(32);let prediction=alloc(16);let errors=alloc(32);let all_error=0;let all_zero=0;let all_heading=0;let all_headings=0;let return_error=0;let return_zero=0;let return_heading=0;let return_headings=0;let returns=0;
    let text=alloc(262144);let b=alloc(32);pl_builder(b,text,262144);pl_text(b,"{\"weightsSHA256\":");pj_text(b,sha);pl_text(b,",\"metric\":\"Offline recurrent pose readout compared with pre-action physical pose\",\"rows\":[");let t=0;
    while row {vc_require(t<512,"pose probe episode exceeds task bound");let rgb=vc_map(vc_path(run,vc_concat("actor-",vc_concat(vc_int(frame),".rgb"))));vc_require(vc_size==21168,"invalid pose probe RGB");let own=vc_map(vc_path(run,vc_concat(vc_concat("actor-",vc_int(frame)),".feedback")));vc_require(vc_size==28 && !pb_u32(own+24),"invalid pose probe feedback");
        if expected_rgb {vc_require(pl_equal(vc_digest(rgb,21168),expected_rgb),"pose probe RGB differs from recorded frame hash");let j=0;while j<28 {vc_require(load8(own+j)==load8(expected_feedback+j),"pose probe feedback differs from recorded feedback");j=j+1;}}
        vc_policy_input_dimensions(rgb,own,hidden,input,0,21168,256);vc_io(0,load64(process+8),input,(21168+7+256)*4);vc_io(1,load64(process+8),response,263*4);
        let kind=ca_decode(response,action);let recorded=pj_get(row,"action");vc_require(kind>=0 && pb_u32(action)==pb_f64_to_f32(pj_real_node(pj_index(recorded,0))) && pb_u32(action+4)==pb_f64_to_f32(pj_real_node(pj_index(recorded,1))),"pose probe action differs from recording");
        let next=response+28;qp_relative_pose(origin,pose,target);qp_predict_pose(weights,bias,next,prediction);qp_errors(target,prediction,errors);let position=load64(errors);let zero=load64(errors+8);let angle=load64(errors+16);let valid=load64(errors+24);
        vc_require(f64_is_finite(position) && f64_is_finite(zero) && f64_is_finite(angle),"nonfinite pose readout error");all_error=f64_add(all_error,position);all_zero=f64_add(all_zero,zero);if valid {all_heading=f64_add(all_heading,angle);all_headings=all_headings+1;}
        if phase {returns=returns+1;return_error=f64_add(return_error,position);return_zero=f64_add(return_zero,zero);if valid {return_heading=f64_add(return_heading,angle);return_headings=return_headings+1;}}
        if t {pl_char(b,44);}pl_text(b,"{\"actionIndex\":");pl_int(b,t);pl_text(b,",\"actualReturning\":");pj_bool_text(b,phase);pl_text(b,",\"actionClass\":");pl_int(b,kind);pl_text(b,",\"positionErrorM\":");pl_float(b,position);pl_text(b,",\"zeroBaselinePositionErrorM\":");pl_float(b,zero);pl_text(b,",\"headingComparable\":");pj_bool_text(b,valid);pl_text(b,",\"headingErrorRad\":");if valid {pl_float(b,angle);}else {pl_text(b,"null");}pl_text(b,",\"predicted\":[");let i=0;while i<4 {if i {pl_char(b,44);}pl_float(b,pb_read_float(prediction+i*4));i=i+1;}pl_text(b,"],\"target\":[");i=0;while i<4 {if i {pl_char(b,44);}pl_float(b,load64(target+i*8));i=i+1;}pl_text(b,"]}");
        let proprio=pj_get(row,"proprio");vc_require(pj_kind(proprio)==3 && pj_count(proprio)==7,"invalid recorded feedback");let j=0;while j<7 {pb_put32(expected_feedback+j*4,pb_f64_to_f32(pj_real_node(pj_index(proprio,j))));j=j+1;}expected_rgb=vc_string(pj_string_field(row,"actorSHA256"));
        vc_copy(hidden,next,1024);syscall(11,rgb,21168,0,0,0,0);syscall(11,own,28,0,0,0,0);frame=vc_json_int(row,"step",0);let state=pj_get(row,"state");ve_pose_read(state,pose);phase=vc_json_int(state,"findReturn","consumedIndex")>=0;t=t+1;row=va_next();
    }
    vc_require(t>0,"pose probe episode is empty");pl_text(b,"],\"frames\":");pl_int(b,t);pl_text(b,",\"returnFrames\":");pl_int(b,returns);pl_text(b,",\"meanPositionErrorM\":");qp_mean(b,all_error,t);pl_text(b,",\"zeroBaselineMeanPositionErrorM\":");qp_mean(b,all_zero,t);pl_text(b,",\"headingComparableFrames\":");pl_int(b,all_headings);pl_text(b,",\"meanHeadingErrorRad\":");qp_mean(b,all_heading,all_headings);pl_text(b,",\"returnMeanPositionErrorM\":");qp_mean(b,return_error,returns);pl_text(b,",\"returnZeroBaselineMeanPositionErrorM\":");qp_mean(b,return_zero,returns);pl_text(b,",\"returnHeadingComparableFrames\":");pl_int(b,return_headings);pl_text(b,",\"returnMeanHeadingErrorRad\":");qp_mean(b,return_heading,return_headings);pl_text(b,",\"actualCommandsReplayedExactly\":true,\"physicalPoseUsedOnlyForAnalysis\":true,\"offlineReadoutOnly\":true,\"actorInputsUnchanged\":true}\n");vc_require(!load64(b+24),"pose probe report overflow");vc_finish(process,15000);vc_write(vc_path(output,"result.json"),text,load64(b+8));return 0;
}

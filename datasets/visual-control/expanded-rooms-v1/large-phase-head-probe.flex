// Reconstruct the two gated heads on a recorded trajectory. The forced-return
// action is an offline counterfactual, not an actor input or rollout.
import "../../../flex/control/verify.flex";
import "../../../flex/control/actions.flex";
fn hp_parameter(data,bytes,name,count) {
    vc_require(bytes>=32 && load64(data)==load64("PUPV0001") && load64(data+8)<=4096 && load64(data+16)==32+load64(data+8)*256 && load64(data+16)<=bytes,"invalid head probe checkpoint");let found=0;let i=0;
    while i<load64(data+8) {let row=data+32+i*256;if pl_equal(row,name) {vc_require(!found && load64(row+200)==count && load64(row+208)>=0 && load64(row+208)<=bytes-load64(data+16) && count*4<=bytes-load64(data+16)-load64(row+208),"invalid head parameter");found=data+load64(data+16)+load64(row+208);}i=i+1;}vc_require(found,"missing head parameter");return found;
}
fn hp_logits(weights,bias,hidden,out) {
    let k=0;while k<7 {let value=pb_read_float(bias+k*4);let i=0;while i<256 {value=f64_add(value,f64_mul(pb_read_float(weights+(i*7+k)*4),pb_read_float(hidden+i*4)));i=i+1;}pb_put32(out+k*4,pb_f64_to_f32(value));k=k+1;}return 0;
}
fn main(argc,argv) {
    vc_init(argc,argv);vc_pixels_init();vc_require(argc==4,"large-phase-head-probe POLICY AUTONOMOUS_EPISODE NEW_OUTPUT");let policy=vc_absolute(load64(argv+8));let run=vc_absolute(load64(argv+16));let output=vc_absolute(load64(argv+24));vc_mkdir(output);
    let meta=vc_json_file(vc_path(policy,"receipt.json"));let sha=vc_string(pj_string_field(meta,"weightsSHA256"));vc_require(pj_boolean(meta,"phaseGatedNavigation") && vc_json_int(meta,"memoryWidth",0)==256 && !pj_boolean(meta,"taskFeedback") && pl_equal(vc_file_sha(vc_path(policy,"weights.bin")),sha) && pl_equal(vc_file_sha(vc_path(policy,"policy")),pj_string_field(meta,"binarySHA256")),"head probe policy hash mismatch");
    let audit=vc_json_file(vc_path(run,"../verified/result.json"));vc_require(pj_boolean(audit,"passed") && !pj_real(audit,"commandReplayMaxAbsError") && pl_equal(pj_string_field(audit,"weightsSHA256"),sha),"head probe requires an audited autonomous history");
    let data=vc_map(vc_path(policy,"weights.bin"));let bytes=vc_size;let gate=hp_parameter(data,bytes,"critic.weight_T",256);let gate_bias=hp_parameter(data,bytes,"critic.bias",1);
    let search=hp_parameter(data,bytes,"actor_search.weight_T",256*7);let search_bias=hp_parameter(data,bytes,"actor_search.bias",7);let returning=hp_parameter(data,bytes,"actor_return.weight_T",256*7);let return_bias=hp_parameter(data,bytes,"actor_return.bias",7);
    let args=vc_args();vc_add(args,vc_path(policy,"policy"));vc_add(args,vc_path(policy,"weights.bin"));vc_add(args,sha);vc_add(args,vc_path(policy,"kernels"));vc_add(args,"3");vc_add(args,"--raw");let process=vc_spawn(args,vc_path(output,"policy.log"),0,1);let magic=alloc(8);vc_io(1,load64(process+8),magic,8);vc_require(load64(magic)==load64("VCR25601"),"head probe handshake mismatch");
    let hidden=alloc(1024);pb_zero(hidden,1024);let input=alloc((21168+7+256)*4);let response=alloc(263*4);let actual_action=alloc(8);let search_action=alloc(8);let return_action=alloc(8);let search_logits=alloc(28);let return_logits=alloc(28);let expected_feedback=alloc(28);let expected_rgb=0;let initial=vc_json_file(vc_path(run,"initial.json"));let frame=vc_json_int(initial,"totalSteps",0);let phase=vc_json_int(initial,"findReturn","consumedIndex")>=0;va_lines(vc_path(run,"decisions.jsonl"));let row=va_next();
    let text=alloc(131072);let b=alloc(32);pl_builder(b,text,131072);pl_text(b,"{\"weightsSHA256\":");pj_text(b,sha);pl_text(b,",\"metric\":\"Offline forced-return-head action on unchanged recorded recurrent state; not a rollout\",\"rows\":[");let t=0;let max_error=0;
    while row {vc_require(t<512,"head probe episode exceeds task bound");let rgb=vc_map(vc_path(run,vc_concat("actor-",vc_concat(vc_int(frame),".rgb"))));vc_require(vc_size==21168,"invalid head probe RGB");
        let own=vc_map(vc_path(run,vc_concat(vc_concat("actor-",vc_int(frame)),".feedback")));vc_require(vc_size==28 && !pb_u32(own+24),"invalid head probe feedback");
        if expected_rgb {vc_require(pl_equal(vc_digest(rgb,21168),expected_rgb),"head probe RGB differs from recorded frame hash");let j=0;while j<28 {vc_require(load8(own+j)==load8(expected_feedback+j),"head probe feedback differs from recorded feedback");j=j+1;}}
        vc_policy_input_dimensions(rgb,own,hidden,input,0,21168,256);vc_io(0,load64(process+8),input,(21168+7+256)*4);vc_io(1,load64(process+8),response,263*4);
        let kind=ca_decode(response,actual_action);let action=pj_get(row,"action");vc_require(kind>=0 && pb_u32(actual_action)==pb_f64_to_f32(pj_real_node(pj_index(action,0))) && pb_u32(actual_action+4)==pb_f64_to_f32(pj_real_node(pj_index(action,1))),"head probe action differs from recording");
        let next=response+28;let logit=pb_read_float(gate_bias);let i=0;while i<256 {logit=f64_add(logit,f64_mul(pb_read_float(gate+i*4),pb_read_float(next+i*4)));i=i+1;}let p=f64_div(PB_ONE,f64_add(PB_ONE,f64_exp(pb_neg(logit))));
        hp_logits(search,search_bias,next,search_logits);hp_logits(returning,return_bias,next,return_logits);let k=0;while k<7 {let mixed=f64_add(f64_mul(f64_sub(PB_ONE,p),pb_read_float(search_logits+k*4)),f64_mul(p,pb_read_float(return_logits+k*4)));let error=f64_magnitude(f64_sub(mixed,pb_read_float(response+k*4)));max_error=pb_fmax(max_error,error);vc_require(f64_lt(error,vc_number(1,10000)),"reconstructed head mixture differs from actor logits");k=k+1;}
        let search_kind=ca_decode(search_logits,search_action);let return_kind=ca_decode(return_logits,return_action);vc_require(search_kind>=0 && return_kind>=0,"invalid counterfactual action");
        if t {pl_char(b,44);}pl_text(b,"{\"actionIndex\":");pl_int(b,t);pl_text(b,",\"actualReturning\":");pj_bool_text(b,phase);pl_text(b,",\"returnWeight\":");pl_float(b,p);pl_text(b,",\"actualClass\":");pl_int(b,kind);pl_text(b,",\"searchClass\":");pl_int(b,search_kind);pl_text(b,",\"forcedReturnClass\":");pl_int(b,return_kind);pl_text(b,",\"forcedReturnChangesAction\":");pj_bool_text(b,return_kind!=kind);pl_char(b,125);
        let proprio=pj_get(row,"proprio");vc_require(pj_kind(proprio)==3 && pj_count(proprio)==7,"invalid recorded feedback");let j=0;while j<7 {pb_put32(expected_feedback+j*4,pb_f64_to_f32(pj_real_node(pj_index(proprio,j))));j=j+1;}expected_rgb=vc_string(pj_string_field(row,"actorSHA256"));
        vc_copy(hidden,next,1024);syscall(11,rgb,21168,0,0,0,0);syscall(11,own,28,0,0,0,0);frame=vc_json_int(row,"step",0);phase=vc_json_int(pj_get(row,"state"),"findReturn","consumedIndex")>=0;t=t+1;row=va_next();
    }
    pl_text(b,"],\"actualCommandsReplayedExactly\":true,\"actorLogitsReconstructed\":true,\"maxLogitAbsError\":");pl_float(b,max_error);pl_text(b,",\"offlineCounterfactualOnly\":true,\"simulatorPhaseUsedOnlyForAnalysis\":true}\n");vc_require(!load64(b+24),"head probe report overflow");vc_finish(process,15000);vc_write(vc_path(output,"result.json"),text,load64(b+8));return 0;
}

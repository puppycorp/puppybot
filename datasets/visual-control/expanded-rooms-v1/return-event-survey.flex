// Compare the brick-consumption image transition with preceding image changes.
import "../../../flex/control/target-supervision.flex";
fn es_difference(a,b) {
    let sum=0;let i=0;while i<21168 {let d=load8(a+i)-load8(b+i);if d<0 {d=0-d;}sum=sum+d;i=i+1;}return sum;
}
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==5,"return-event-survey DATA TARGET_DIRECTORY RUNS OUTPUT");let data=vc_map(vc_absolute(load64(argv+8)));let bytes=vc_size;let n=load64(data+8);let fit=load64(data+16);let length=load64(data+24);vc_require(vd_row_bytes(data)==56 && n==236 && fit==181 && length==354 && bytes==32+n*length*21224,"unexpected return-expanded data dimensions");pt_target_open(vc_absolute(load64(argv+16)),data,bytes,56);let runs=vc_absolute(load64(argv+24));let text=alloc(16384);let b=alloc(32);pl_builder(b,text,16384);pl_text(b,"{\"dataSHA256\":");pj_text(b,vc_digest(data,bytes));pl_text(b,",\"method\":\"Raw pixel change at first post-consumption frame compared with prior search-frame changes; target visibility uses an offline heuristic\",\"actorInputsUnchanged\":true,\"rows\":[");let sample=0;
    while sample<14 {let episode=174+sample;if sample>=7 {episode=229+sample-7;}let base=data+32+episode*length*21224;let run=vc_path(runs,vc_concat("expert-",vc_int(episode)));let meta=vc_json_file(vc_path(run,"supervision.json"));let start=vc_json_int(meta,"studentStartAction",0);vc_require(pj_boolean(meta,"studentBeginsAfterConsumption") && start>=1 && start<length,"return history lacks a valid handoff");let before=alloc(length*8);let count=0;let sum=0;let event=-1;let event_diff=0;let t=1;
        while t<length && event<0 && vd_valid_word(base+length*21168+t*56,56) {let previous=base+length*21168+(t-1)*56;let current=base+length*21168+t*56;vc_require(vd_valid_word(previous,56) && !pb_u32(current+24) && !pb_u32(previous+24),"invalid frame or task hint in return survey");let prior=pb_u32(previous+36);let phase=pb_u32(current+36);vc_require((prior==0 || prior==0x3f800000) && (phase==0 || phase==0x3f800000),"invalid phase label");if !prior && phase {event=t;event_diff=es_difference(base+(t-1)*21168,base+t*21168);}else if !prior && !phase {let d=es_difference(base+(t-1)*21168,base+t*21168);store64(before+count*8,d);sum=sum+d;count=count+1;}t=t+1;}
        vc_require(event==start && count>0,"return handoff is not the first post-consumption frame");let rank=0;let i=0;while i<count {if load64(before+i*8)<=event_diff {rank=rank+1;}i=i+1;}let mask=pb_u32(pt_target_data+32+(episode*length+event-1)*12+8);let scale=f64_from_i64(21168*255);if sample {pl_char(b,44);}pl_text(b,"{\"index\":");pl_int(b,episode);pl_text(b,",\"fit\":");pj_bool_text(b,episode<fit);pl_text(b,",\"eventFrame\":");pl_int(b,event);pl_text(b,",\"priorSearchPairs\":");pl_int(b,count);pl_text(b,",\"priorMeanAbsoluteRGBDifference\":");pl_float(b,f64_div(f64_from_i64(sum),f64_mul(f64_from_i64(count),scale)));pl_text(b,",\"eventAbsoluteRGBDifference\":");pl_float(b,f64_div(f64_from_i64(event_diff),scale));pl_text(b,",\"fractionOfPriorChangesAtMostEventChange\":");pl_float(b,f64_div(f64_from_i64(rank),f64_from_i64(count)));pl_text(b,",\"targetHeuristicMatchedLastSearchFrame\":");pj_bool_text(b,mask!=0);pl_char(b,125);syscall(11,before,length*8,0,0,0,0);sample=sample+1;
    }pl_text(b,"],\"eventHintInputAlwaysZero\":true,\"visibilityHeuristicNotSegmentation\":true,\"notEvidenceOfLearnedRecognition\":true}\n");vc_require(!load64(b+24),"return event survey report overflow");vc_write(vc_absolute(load64(argv+32)),text,load64(b+8));return 0;

// Exact input overlap and raw-pixel nearest first frames, never actor inputs.
import "../../../flex/control/verify.flex";
import "../../../flex/control/actions.flex";
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==6,"initial-view-coverage DATA COVERAGE SCORE BENCHMARK NEW_OUTPUT");let path=vc_absolute(load64(argv+8));let coverage_path=vc_absolute(load64(argv+16));let score_path=vc_absolute(load64(argv+24));let benchmark=vc_absolute(load64(argv+32));let output=vc_absolute(load64(argv+40));vc_mkdir(output);let data=vc_map(path);let bytes=vc_size;let n=load64(data+8);let fit=load64(data+16);let length=load64(data+24);vc_require(vd_row_bytes(data)==56 && n==236 && fit==181 && length==354 && bytes==32+n*length*21224,"unexpected admitted corpus dimensions");let sha=vc_digest(data,bytes);let coverage=vc_json_file(coverage_path);vc_require(pj_boolean(coverage,"passed") && pj_boolean(coverage,"allNewTripsIndependentlyAudited") && pj_boolean(coverage,"existingDataBytePreserved") && pl_equal(pj_string_field(coverage,"dataSHA256"),sha),"corpus coverage receipt differs");let score_sha=vc_file_sha(score_path);let score=vc_json_file(score_path);vc_require(vc_json_int(score,"episodes",0)==32 && vc_json_int(score,"auditedEpisodes",0)==32 && !vc_json_int(score,"auditFailures",0),"development score is not fully audited");let compare=ffi_symbol(ffi_open("libc.so.6"),"memcmp");vc_require(compare,"memcmp unavailable");
    let indices=alloc(64);store64(indices,0);store64(indices+8,1);store64(indices+16,2);store64(indices+24,3);store64(indices+32,16);store64(indices+40,17);store64(indices+48,18);store64(indices+56,19);let text=alloc(32768);let b=alloc(32);pl_builder(b,text,32768);pl_text(b,"{\"scope\":\"Exact current RGB/own-feedback overlaps and raw-pixel nearest first frames; later training memory may differ and pixel similarity is not semantic similarity\",\"dataSHA256\":");pj_text(b,sha);pl_text(b,",\"scoreSHA256\":");pj_text(b,score_sha);pl_text(b,",\"rows\":[");let sample=0;
    while sample<8 {let index=load64(indices+sample*8);let current=vc_json_file(score_path);let item=pj_index(pj_get(current,"rows"),index);vc_require(vc_json_int(item,"caseIndex",0)==index && pj_boolean(item,"recordingCompleted") && pj_boolean(item,"auditPassed"),"case was not audited");let weight=vc_string(pj_string_field(item,"policyWeightsSHA256"));vc_require(!pj_boolean(item,"blackout") && !pj_boolean(item,"taskEventHint"),"development case has altered actor inputs");let root=vc_path(benchmark,vc_int(index));let audit=vc_json_file(vc_path(vc_path(root,"verified"),"result.json"));vc_require(pj_boolean(audit,"passed") && pj_boolean(audit,"taskEventHintAbsent") && f64_eq(pj_real(audit,"commandReplayMaxAbsError"),0) && pl_equal(pj_string_field(audit,"weightsSHA256"),weight),"replay audit failed");let run=vc_path(root,vc_int(9960000+index));let initial=vc_json_file(vc_path(run,"initial.json"));let frame=vc_json_int(initial,"totalSteps",0);vc_require(vc_json_int(initial,"findReturn","consumedIndex")<0,"sample begins after consumption");let stem=vc_concat("actor-",vc_int(frame));let rgb=vc_map(vc_path(run,vc_concat(stem,".rgb")));vc_require(vc_size==21168,"invalid initial image");let image_sha=vc_digest(rgb,21168);let own=vc_map(vc_path(run,vc_concat(stem,".feedback")));vc_require(vc_size==28 && !pb_u32(own+24),"invalid initial feedback");va_lines(vc_path(run,"decisions.jsonl"));let first=va_next();vc_require(first,"empty episode");let action=pj_get(first,"action");let actual=ca_class(pj_real_node(pj_index(action,0)),pj_real_node(pj_index(action,1)));vc_require(actual>=0,"invalid recorded first action");syscall(11,va_data,va_length,0,0,0,0);
        let counts=alloc(4*10*8);let best=alloc(2*24);store64(best,0x7fffffffffffffff);store64(best+24,0x7fffffffffffffff);let episode=0;
        while episode<n {let base=data+32+episode*length*21224;let role=episode>=fit;let t=0;while t<length {let row=base+length*21168+t*56;let valid=vd_valid_word(row,56);if valid {vc_require(valid==0x3f800000 && pb_u32(row+40)==0x3f800000 && !pb_u32(row+24),"invalid source input");let image=base+t*21168;if !t {let total=0;let i=0;while i<21168 {total=total+pb_abs(load8(image+i)-load8(rgb+i));i=i+1;}let slot=best+role*24;if total<load64(slot) {store64(slot,total);store64(slot+8,episode);store64(slot+16,ca_class(pb_read_float(row+28),pb_read_float(row+32)));}}
                if !ffi_call(compare,image,rgb,21168,0,0,0) {let phase=pb_u32(row+36);vc_require(phase==0 || phase==0x3f800000,"invalid source phase");let slot=counts+(role*2+(phase!=0))*80;store64(slot,load64(slot)+1);if !ffi_call(compare,row,own,28,0,0,0) {store64(slot+8,load64(slot+8)+1);if !t {store64(slot+16,load64(slot+16)+1);}let kind=ca_class(pb_read_float(row+28),pb_read_float(row+32));vc_require(kind>=0,"invalid teacher action");store64(slot+(3+kind)*8,load64(slot+(3+kind)*8)+1);}}
            }t=t+1;}episode=episode+1;
        }
        if sample {pl_char(b,44);}pl_text(b,"{\"caseIndex\":");pl_int(b,index);pl_text(b,",\"layoutId\":");pl_int(b,18+index/16);pl_text(b,",\"initialImageSHA256\":");pj_text(b,image_sha);pl_text(b,",\"recordedFirstActionClass\":");pl_int(b,actual);pl_text(b,",\"nearestFirstFrames\":[");let role=0;while role<2 {if role {pl_char(b,44);}let slot=best+role*24;pl_text(b,"{\"split\":");if role {pj_text(b,"validation");}else {pj_text(b,"fit");}pl_text(b,",\"episode\":");pl_int(b,load64(slot+8));pl_text(b,",\"teacherActionClass\":");pl_int(b,load64(slot+16));pl_text(b,",\"meanAbsoluteRGBDifference\":");pl_float(b,vc_number(load64(slot),21168*255));pl_char(b,125);role=role+1;}pl_text(b,"],\"exactMatches\":[");let group=0;while group<4 {if group {pl_char(b,44);}let slot=counts+group*80;pl_text(b,"{\"split\":");if group<2 {pj_text(b,"fit");}else {pj_text(b,"validation");}pl_text(b,",\"phase\":");if group%2 {pj_text(b,"return");}else {pj_text(b,"search");}pl_text(b,",\"image\":");pl_int(b,load64(slot));pl_text(b,",\"imageAndFeedback\":");pl_int(b,load64(slot+8));pl_text(b,",\"sameAtEpisodeStart\":");pl_int(b,load64(slot+16));pl_text(b,",\"teacherActions\":[");let i=0;while i<7 {if i {pl_char(b,44);}pl_int(b,load64(slot+(3+i)*8));i=i+1;}pl_text(b,"]}");group=group+1;}pl_text(b,"]}");syscall(11,rgb,21168,0,0,0,0);syscall(11,own,28,0,0,0,0);sample=sample+1;
    }pl_text(b,"],\"actorInputsUnchanged\":true,\"taskEventHintAbsent\":true,\"nearestMeasureIsNotLearnedFeatureDistance\":true}\n");vc_require(!load64(b+24),"initial coverage report overflow");vc_write(vc_path(output,"result.json"),text,load64(b+8));return 0;
}

// Offline label-quality survey: project simulator target positions onto the
// recorded TCP frame and compare with recorded colour components and actor RGB.
import "../../../flex/control/verify.flex";
fn tv_projection(run,frame,target,out) {
    let old=pj_arena;let used=pj_used;pj_arena=alloc(131072);let name=vc_concat(vc_concat("frame-",vc_int(frame)),".png.camera.json");let meta=vc_json_file(vc_path(vc_path(run,"sensor"),name));vc_require(vc_json_int(meta,"frameId",0)==frame && pl_equal(pj_string_field(meta,"view"),"tcp"),"target survey camera frame mismatch");
    let vectors=alloc(96);va_vector(pj_get(meta,"eyeM"),vectors,3);va_vector(pj_get(meta,"forward"),vectors+24,3);va_vector(pj_get(meta,"right"),vectors+48,3);va_vector(pj_get(meta,"down"),vectors+72,3);let depth=0;let horizontal=0;let vertical=0;let i=0;while i<3 {let d=f64_sub(load64(target+i*8),load64(vectors+i*8));depth=f64_add(depth,f64_mul(d,load64(vectors+24+i*8)));horizontal=f64_add(horizontal,f64_mul(d,load64(vectors+48+i*8)));vertical=f64_add(vertical,f64_mul(d,load64(vectors+72+i*8)));i=i+1;}
    let visible=0;if f64_gt(depth,vc_number(1,100)) {let intrinsics=pj_get(meta,"intrinsics");let x=f64_add(pj_real(intrinsics,"cx"),f64_mul(pj_real(intrinsics,"fx"),f64_div(horizontal,depth)));let y=f64_add(pj_real(intrinsics,"cy"),f64_mul(pj_real(intrinsics,"fy"),f64_div(vertical,depth)));store64(out,x);store64(out+8,y);store64(out+16,depth);visible=f64_ge(x,0) && f64_lt(x,f64_from_i64(640)) && f64_ge(y,0) && f64_lt(y,f64_from_i64(480));}
    syscall(11,vectors,96,0,0,0,0);syscall(11,pj_arena,131072,0,0,0,0);pj_arena=old;pj_used=used;pj_error=0;return visible;
}
fn tv_component(perception,frame,point) {
    if vc_json_int(perception,"frameId",0)!=frame {return 0;}let boxes=pj_get(perception,"detections");let i=0;while i<pj_count(boxes) {let box=pj_get(pj_index(boxes,i),"box");let x=load64(point);let y=load64(point+8);if f64_ge(x,pj_real_node(pj_index(box,0))) && f64_le(x,pj_real_node(pj_index(box,2))) && f64_ge(y,pj_real_node(pj_index(box,1))) && f64_le(y,pj_real_node(pj_index(box,3))) {return 1;}i=i+1;}return 0;
}
fn tv_pixels(rgb,point) {
    let cx=f64_to_i64_trunc(f64_mul(load64(point),vc_number(84,640)));let cy=f64_to_i64_trunc(f64_mul(load64(point+8),vc_number(84,480)));let colour=alloc(3);let n=0;let y=pb_max(0,cy-3);while y<=pb_min(83,cy+3) {let x=pb_max(0,cx-3);while x<=pb_min(83,cx+3) {let c=0;while c<3 {store8(colour+c,load8(rgb+(c*84+y)*84+x));c=c+1;}if va_brick_pixel(colour) {n=n+1;}x=x+1;}y=y+1;}syscall(11,colour,3,0,0,0,0);return n;
}
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==6 || argc==7,"survey DATA RUNS OUTPUT MAX_EPISODES SOURCE_SHA [CANDIDATES_JSONL]");let path=vc_absolute(load64(argv+8));let runs=vc_absolute(load64(argv+16));let output=vc_absolute(load64(argv+24));let maximum=pl_integer(load64(argv+32),pl_size(load64(argv+32)));vc_require(!pl_bad_number && maximum>0,"invalid episode limit");let source_sha=load64(argv+40);vc_require(pl_size(source_sha)==64,"source hash must be SHA256");let data=vc_map(path);let bytes=vc_size;let n=load64(data+8);let fit=load64(data+16);let length=load64(data+24);vc_require(vd_row_bytes(data)==56 && n>=2 && n<=256 && fit>=1 && fit<n && maximum<=n && length>=1 && length<=512 && bytes==32+n*length*21224 && pl_equal(vc_digest(data,bytes),source_sha),"target survey data or hash differs");
    let compare=ffi_symbol(ffi_open("libc.so.6"),"memcmp");vc_require(compare,"memcmp unavailable");let stats=alloc(2*5*8);let point=alloc(24);let target=alloc(24);let records=0;let rb=0;if argc==7 {records=alloc(16777216);rb=alloc(32);pl_builder(rb,records,16777216);}let episode=0;while episode<maximum {let run=vc_path(runs,vc_concat("expert-",vc_int(episode)));let initial=vc_json_file(vc_path(run,"initial.json"));let state=initial;let frame=vc_json_int(initial,"totalSteps",0);va_vector(pj_get(pj_index(pj_get(pj_get(initial,"case"),"objects"),0),"position"),target,3);let base=data+32+episode*length*21224;let group=0;if episode>=fit {group=1;}let g=stats+group*5*8;let t=0;va_lines(vc_path(run,"decisions.jsonl"));
        while t<length && vd_valid_word(base+length*21168+t*56,56) {let source=base+length*21168+t*56;let image=vc_map(vc_path(run,vc_concat("actor-",vc_concat(vc_int(frame),".rgb"))));vc_require(vc_size==21168 && !ffi_call(compare,image,base+t*21168,21168,0,0,0),"target survey image does not match source");store64(g,load64(g)+1);
            if !pb_u32(source+36) {store64(g+8,load64(g+8)+1);if tv_projection(run,frame,target,point) {store64(g+16,load64(g+16)+1);let colour=tv_pixels(image,point);if colour>=2 {store64(g+24,load64(g+24)+1);if tv_component(pj_get(pj_get(state,"case"),"perception"),frame,point) {store64(g+32,load64(g+32)+1);if rb {pl_text(rb,"{\"episode\":");pl_int(rb,episode);pl_text(rb,",\"validation\":");pj_bool_text(rb,group);pl_text(rb,",\"actionIndex\":");pl_int(rb,t);pl_text(rb,",\"frame\":");pl_int(rb,frame);pl_text(rb,",\"sensorX\":");pl_float(rb,load64(point));pl_text(rb,",\"sensorY\":");pl_float(rb,load64(point+8));pl_text(rb,",\"depthM\":");pl_float(rb,load64(point+16));pl_text(rb,",\"saturatedPixels\":");pl_int(rb,colour);pl_text(rb,"}\n");}}}}}
            syscall(11,image,21168,0,0,0,0);let command=va_next();vc_require(command && vc_json_int(command,"step",0)==frame+10,"target survey command alignment mismatch");state=pj_get(command,"state");frame=vc_json_int(command,"step",0);t=t+1;
        }vc_require(t>0 && !va_next(),"target survey history is incomplete");syscall(11,va_data,va_length,0,0,0,0);episode=episode+1;
    }
    let text=alloc(4096);let b=alloc(32);pl_builder(b,text,4096);pl_text(b,"{\"runtime\":\"Flexscript\",\"sourceDataSHA256\":");pj_text(b,source_sha);pl_text(b,",\"episodes\":");pl_int(b,maximum);pl_text(b,",\"actorInputsUnchanged\":true,\"measurement\":\"Projected stationary initial target with fresh camera metadata, local RGB colour threshold and detector-box containment; candidate visibility, not proven segmentation\",\"roles\":[");let k=0;while k<2 {if k {pl_char(b,44);}let g=stats+k*5*8;pl_text(b,"{\"role\":");if k {pj_text(b,"validation");}else {pj_text(b,"fitting");}pl_text(b,",\"allFrames\":");pl_int(b,load64(g));pl_text(b,",\"beforeConsumption\":");pl_int(b,load64(g+8));pl_text(b,",\"projectedInFrame\":");pl_int(b,load64(g+16));pl_text(b,",\"atLeastTwoSaturatedPixelsNearProjection\":");pl_int(b,load64(g+24));pl_text(b,",\"alsoInsideFreshColourDetection\":");pl_int(b,load64(g+32));pl_char(b,125);k=k+1;}pl_text(b,"]}\n");vc_require(!load64(b+24) && (!rb || !load64(rb+24)),"target survey output overflow");vc_write(output,text,load64(b+8));if rb {vc_write(vc_absolute(load64(argv+48)),records,load64(rb+8));}return 0;
}

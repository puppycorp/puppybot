// Check retained fitting and validation label sequences after adding histories.
import "../../../flex/control/host.flex";
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==4,"target-preserve-added OLD_TARGETS EXPANDED_TARGETS OUTPUT");let old=vc_map(vc_absolute(load64(argv+8)));let old_bytes=vc_size;let next=vc_map(vc_absolute(load64(argv+16)));let next_bytes=vc_size;vc_require(old_bytes>=32 && next_bytes>=32,"invalid target header");let old_n=load64(old+8);let old_fit=load64(old+16);let n=load64(next+8);let fit=load64(next+16);let length=load64(old+24);
    vc_require(load64(old)==load64("PVVIS001") && old_n>=2 && old_n<=1024 && old_fit>=1 && old_fit<old_n && length>=1 && length<=512 && old_bytes==32+old_n*length*12,"invalid original target dimensions");
    vc_require(load64(next)==load64("PVVIS001") && n>=old_n && n<=1024 && fit>=old_fit && fit<n && n-fit>=old_n-old_fit && load64(next+24)==length && next_bytes==32+n*length*12,"invalid expanded target dimensions");
    let compare=ffi_symbol(ffi_open("libc.so.6"),"memcmp");vc_require(compare,"memcmp unavailable");let episode=0;while episode<old_n {let target=episode;if episode>=old_fit {target=episode+fit-old_fit;}vc_require(!ffi_call(compare,old+32+episode*length*12,next+32+target*length*12,length*12,0,0,0),"existing target labels changed");episode=episode+1;}
    let text=alloc(1024);let b=alloc(32);pl_builder(b,text,1024);pl_text(b,"{\"passed\":true,\"existingHistoriesPreserved\":");pl_int(b,old_n);pl_text(b,",\"fittingHistories\":");pl_int(b,old_fit);pl_text(b,",\"validationHistories\":");pl_int(b,old_n-old_fit);pl_text(b,",\"expandedHistories\":");pl_int(b,n);pl_text(b,",\"expandedFittingHistories\":");pl_int(b,fit);pl_text(b,",\"sequenceLength\":");pl_int(b,length);pl_text(b,",\"oldTargetSHA256\":");pj_text(b,vc_digest(old,old_bytes));pl_text(b,",\"expandedTargetSHA256\":");pj_text(b,vc_digest(next,next_bytes));pl_text(b,"}\n");vc_require(!load64(b+24),"target preservation report overflow");vc_write(vc_absolute(load64(argv+24)),text,load64(b+8));return 0;
}

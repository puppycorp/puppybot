// Count teacher actions and their actual training loss mass by split and phase.
import "../../../flex/control/dataset.flex";
import "../../../flex/control/actions.flex";
import "../../../flex/control/action-weight.flex";
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==3,"action-balance DATA OUTPUT_JSON");let data=vc_map(vc_absolute(load64(argv+8)));let bytes=vc_size;let n=load64(data+8);let fit=load64(data+16);let length=load64(data+24);vc_require(vd_row_bytes(data)==56 && n>=2 && n<=256 && fit>=1 && fit<n && length>=1 && length<=512 && bytes==32+n*length*21224,"invalid dense training data");let sha=vc_digest(data,bytes);let counts=alloc(4*7*8);let weights=alloc(4*7*8);let transitions=alloc(4*8);let episode=0;
    while episode<n {let base=data+32+episode*length*21224;let t=0;while t<length {let row=base+length*21168+t*56;let valid=vd_valid_word(row,56);let mask=pb_u32(row+40);vc_require((valid==0 || valid==0x3f800000) && (mask==0 || mask==0x3f800000) && (!mask || valid) && !pb_u32(row+24),"invalid actor input or supervision mask");if mask {let phase=pb_u32(row+36);vc_require(phase==0 || phase==0x3f800000,"invalid phase");let speed=pb_read_float(row+32);let previous=pb_read_float(row+4);let action=ca_class(pb_read_float(row+28),speed);vc_require(action>=0,"teacher command is not a categorical action");let group=(episode>=fit)*2+(phase!=0);let index=group*7+action;store64(counts+index*8,load64(counts+index*8)+1);let weight=pt_control_weight(PB_ONE,speed,previous);store64(weights+index*8,f64_add(load64(weights+index*8),weight));if f64_gt(f64_magnitude(f64_sub(speed,previous)),vc_number(1,5)) {store64(transitions+group*8,load64(transitions+group*8)+1);}}t=t+1;}episode=episode+1;}
    let text=alloc(8192);let b=alloc(32);pl_builder(b,text,8192);pl_text(b,"{\"passed\":true,\"scope\":\"teacher labels and loss weights, not student performance\",\"dataSHA256\":");pj_text(b,sha);pl_text(b,",\"episodes\":");pl_int(b,n);pl_text(b,",\"fittingHistories\":");pl_int(b,fit);pl_text(b,",\"validationHistories\":");pl_int(b,n-fit);pl_text(b,",\"actionOrder\":[\"forward-left\",\"forward\",\"forward-right\",\"reverse-left\",\"reverse\",\"reverse-right\",\"stop\"],\"groups\":[");let group=0;
    while group<4 {if group {pl_char(b,44);}pl_text(b,"{\"split\":");if group<2 {pj_text(b,"fit");}else {pj_text(b,"validation");}pl_text(b,",\"phase\":");if group%2 {pj_text(b,"return");}else {pj_text(b,"search");}pl_text(b,",\"transitions\":");pl_int(b,load64(transitions+group*8));pl_text(b,",\"counts\":[");let i=0;while i<7 {if i {pl_char(b,44);}pl_int(b,load64(counts+(group*7+i)*8));i=i+1;}pl_text(b,"],\"lossWeightMass\":[");i=0;while i<7 {if i {pl_char(b,44);}pl_float(b,load64(weights+(group*7+i)*8));i=i+1;}pl_text(b,"]}");group=group+1;}pl_text(b,"]}\n");vc_require(!load64(b+24),"action balance report overflow");vc_write(vc_absolute(load64(argv+16)),text,load64(b+8));return 0;
}

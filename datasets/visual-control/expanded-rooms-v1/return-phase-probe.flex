// Read the auxiliary phase head while replaying recorded recurrent histories.
import "../../../flex/control/verify.flex";
import "../../../flex/control/actions.flex";
fn rp_parameter(data,bytes,name,count) {
    vc_require(bytes>=32 && load64(data)==load64("PUPV0001") && load64(data+8)<=4096 && load64(data+16)==32+load64(data+8)*256 && load64(data+16)<=bytes,"invalid phase probe checkpoint");let found=0;let i=0;
    while i<load64(data+8) {let row=data+32+i*256;if pl_equal(row,name) {vc_require(!found && load64(row+200)==count && load64(row+208)>=0 && load64(row+208)<=bytes-load64(data+16) && count*4<=bytes-load64(data+16)-load64(row+208),"invalid phase parameter");found=data+load64(data+16)+load64(row+208);}i=i+1;}vc_require(found,"missing phase parameter");return found;
}
fn main(argc,argv) {
    vc_init(argc,argv);vc_pixels_init();vc_require(argc==5,"return-phase-probe POLICY MERGED_CORPUS COVERAGE NEW_OUTPUT");let policy=vc_absolute(load64(argv+8));let runs=vc_absolute(load64(argv+16));let coverage_path=vc_absolute(load64(argv+24));let output=vc_absolute(load64(argv+32));vc_mkdir(output);let meta=vc_json_file(vc_path(policy,"receipt.json"));let sha=vc_string(pj_string_field(meta,"weightsSHA256"));vc_require(pl_equal(vc_file_sha(vc_path(policy,"weights.bin")),sha) && pl_equal(vc_file_sha(vc_path(policy,"policy")),pj_string_field(meta,"binarySHA256")) && !pj_boolean(meta,"taskFeedback"),"phase probe policy hash mismatch");let data_sha=vc_file_sha(vc_path(runs,"data.bin"));let coverage=vc_json_file(coverage_path);vc_require(pj_boolean(coverage,"passed") && pj_boolean(coverage,"allNewTripsIndependentlyAudited") && pj_boolean(coverage,"existingDataBytePreserved") && vc_json_int(coverage,"episodes",0)==236 && pl_equal(pj_string_field(coverage,"dataSHA256"),data_sha),"phase probe requires the audited return corpus");
    let checkpoint=vc_map(vc_path(policy,"weights.bin"));let bytes=vc_size;let weights=rp_parameter(checkpoint,bytes,"critic.weight_T",128);let bias=rp_parameter(checkpoint,bytes,"critic.bias",1);let text=alloc(16384);let b=alloc(32);pl_builder(b,text,16384);pl_text(b,"{\"weightsSHA256\":");pj_text(b,sha);pl_text(b,",\"dataSHA256\":");pj_text(b,data_sha);pl_text(b,",\"scope\":\"Training-only phase head on recorded teacher-approach and student-return histories; uncalibrated and not a causal intervention\",\"rows\":[");let sample=0;
    while sample<14 {let episode=174+sample;if sample>=7 {episode=229+sample-7;}let run=vc_path(runs,vc_concat("expert-",vc_int(episode)));let supervision=vc_json_file(vc_path(run,"supervision.json"));let start=vc_json_int(supervision,"studentStartAction",0);let student=vc_json_int(supervision,"studentActions",0);vc_require(pj_boolean(supervision,"studentBeginsAfterConsumption") && pj_boolean(supervision,"denseOracleLabels") && start>=5 && student>=5 && start+student<=354 && pl_equal(pj_string_field(supervision,"studentWeightsSHA256"),sha),"unexpected return supervision");let args=vc_args();vc_add(args,vc_path(policy,"policy"));vc_add(args,vc_path(policy,"weights.bin"));vc_add(args,sha);vc_add(args,vc_path(policy,"kernels"));vc_add(args,"3");vc_add(args,"--raw");let process=vc_spawn(args,vc_path(output,vc_concat("policy-",vc_concat(vc_int(episode),".log"))),0,1);let magic=alloc(8);vc_io(1,load64(process+8),magic,8);vc_require(load64(magic)==load64("VCPRAW01"),"phase probe handshake mismatch");let hidden=alloc(512);pb_zero(hidden,512);let input=alloc((21168+7+128)*4);let response=alloc(135*4);let decoded=alloc(8);let initial=vc_json_file(vc_path(run,"initial.json"));let frame=vc_json_int(initial,"totalSteps",0);va_lines(vc_path(run,"decisions.jsonl"));let row=va_next();let t=0;let before=0;let after=0;let search_above=0;let return_above=0;let search_sum=0;let return_sum=0;let before_sum=0;let after_sum=0;let replayed=0;
        while row && t<start+student {let rgb=vc_map(vc_path(run,vc_concat("actor-",vc_concat(vc_int(frame),".rgb"))));vc_require(vc_size==21168,"invalid phase probe RGB");let own=vc_map(vc_path(run,vc_concat("actor-",vc_concat(vc_int(frame),".feedback"))));vc_require(vc_size==28 && !pb_u32(own+24),"invalid phase probe feedback");vc_policy_input(rgb,own,hidden,input,0);vc_io(0,load64(process+8),input,(21168+7+128)*4);vc_io(1,load64(process+8),response,135*4);let kind=ca_decode(response,decoded);vc_require(kind>=0,"invalid phase probe action");if t>=start {let action=pj_get(row,"action");vc_require(pb_u32(decoded)==pb_f64_to_f32(pj_real_node(pj_index(action,0))) && pb_u32(decoded+4)==pb_f64_to_f32(pj_real_node(pj_index(action,1))),"return-window replay differs");replayed=replayed+1;}let logit=pb_read_float(bias);let i=0;while i<128 {logit=f64_add(logit,f64_mul(pb_read_float(weights+i*4),pb_read_float(response+28+i*4)));i=i+1;}vc_require(f64_is_finite(logit),"nonfinite phase prediction");let probability=f64_div(PB_ONE,f64_add(PB_ONE,f64_exp(pb_neg(logit))));if t<start {search_sum=f64_add(search_sum,probability);if f64_gt(probability,vc_number(1,2)) {search_above=search_above+1;}if t>=start-5 {before_sum=f64_add(before_sum,probability);before=before+1;}}else {return_sum=f64_add(return_sum,probability);if f64_gt(probability,vc_number(1,2)) {return_above=return_above+1;}if t<start+5 {after_sum=f64_add(after_sum,probability);after=after+1;}}vc_copy(hidden,response+28,512);syscall(11,rgb,21168,0,0,0,0);syscall(11,own,28,0,0,0,0);frame=vc_json_int(row,"step",0);t=t+1;row=va_next();
        }vc_require(t==start+student && replayed==student && before==5 && after==5,"phase probe history incomplete");vc_finish(process,15000);if sample {pl_char(b,44);}pl_text(b,"{\"index\":");pl_int(b,episode);pl_text(b,",\"fit\":");pj_bool_text(b,episode<181);pl_text(b,",\"searchFrames\":");pl_int(b,start);pl_text(b,",\"returnFrames\":");pl_int(b,student);pl_text(b,",\"searchAboveHalf\":");pl_int(b,search_above);pl_text(b,",\"returnAboveHalf\":");pl_int(b,return_above);pl_text(b,",\"meanSearchProbability\":");pl_float(b,f64_div(search_sum,f64_from_i64(start)));pl_text(b,",\"meanReturnProbability\":");pl_float(b,f64_div(return_sum,f64_from_i64(student)));pl_text(b,",\"lastFiveSearchMean\":");pl_float(b,f64_div(before_sum,f64_from_i64(5)));pl_text(b,",\"firstFiveReturnMean\":");pl_float(b,f64_div(after_sum,f64_from_i64(5)));pl_text(b,",\"studentCommandsReplayed\":");pl_int(b,replayed);pl_char(b,125);syscall(11,va_data,va_length,0,0,0,0);sample=sample+1;
    }pl_text(b,"],\"allStudentCommandsReplayedExactly\":true,\"actorInputsUnchanged\":true,\"phaseReadoutNotDirectActorInput\":true}\n");vc_require(!load64(b+24),"phase probe report overflow");vc_write(vc_path(output,"result.json"),text,load64(b+8));return 0;
}

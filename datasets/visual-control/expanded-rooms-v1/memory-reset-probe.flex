// Counterfactual recurrent-state reset on the same audited pre-action inputs.
import "../../../flex/control/verify.flex";
import "../../../flex/control/actions.flex";
fn mr_parameter(data,bytes,name,count) {
    vc_require(bytes>=32 && load64(data)==load64("PUPV0001") && load64(data+8)<=4096 && load64(data+16)==32+load64(data+8)*256 && load64(data+16)<=bytes,"invalid checkpoint");let found=0;let i=0;while i<load64(data+8) {let row=data+32+i*256;if pl_equal(row,name) {vc_require(!found && load64(row+200)==count && load64(row+208)<=bytes-load64(data+16) && count*4<=bytes-load64(data+16)-load64(row+208),"invalid readout parameter");found=data+load64(data+16)+load64(row+208);}i=i+1;}vc_require(found,"missing readout parameter");return found;
}
fn mr_phase(output,weights,bias) {
    let logit=pb_read_float(bias);let i=0;while i<128 {logit=f64_add(logit,f64_mul(pb_read_float(weights+i*4),pb_read_float(output+28+i*4)));i=i+1;}vc_require(f64_is_finite(logit),"nonfinite phase readout");return f64_div(PB_ONE,f64_add(PB_ONE,f64_exp(pb_neg(logit))));
}
fn mr_stop_margin(output) {let largest=pb_read_float(output);let i=1;while i<6 {largest=pb_fmax(largest,pb_read_float(output+i*4));i=i+1;}return f64_sub(pb_read_float(output+24),largest);}
fn main(argc,argv) {
    vc_init(argc,argv);vc_pixels_init();vc_require(argc==5,"memory-reset-probe POLICY SCORE BENCHMARK NEW_OUTPUT");let policy=vc_absolute(load64(argv+8));let score_path=vc_absolute(load64(argv+16));let benchmark=vc_absolute(load64(argv+24));let output=vc_absolute(load64(argv+32));vc_mkdir(output);
    let meta=vc_json_file(vc_path(policy,"receipt.json"));let sha=vc_string(pj_string_field(meta,"weightsSHA256"));vc_require(pl_equal(vc_file_sha(vc_path(policy,"weights.bin")),sha) && pl_equal(vc_file_sha(vc_path(policy,"policy")),pj_string_field(meta,"binarySHA256")) && !pj_boolean(meta,"taskFeedback"),"policy hash or actor boundary differs");let kernels=pj_get(meta,"kernels");let child=pj_value(kernels);while child {let name=load64(child+32);vc_require(!pl_starts(name,"/") && !pl_starts(name,"..") && pl_equal(vc_file_sha(vc_path(vc_path(policy,"kernels"),name)),pj_value(child)),"policy kernel hash differs");child=load64(child+24);}vc_require(pj_kind(kernels)==4 && pj_count(kernels)>=5,"missing kernel receipt");let score_sha=vc_file_sha(score_path);let score=vc_json_file(score_path);let score_rows=pj_get(score,"rows");vc_require(vc_json_int(score,"episodes",0)==32 && vc_json_int(score,"auditedEpisodes",0)==32 && vc_json_int(score,"auditFailures",0)==0 && pj_count(score_rows)==32,"probe requires 32 audited episodes");
    let checkpoint=vc_map(vc_path(policy,"weights.bin"));let bytes=vc_size;let weights=mr_parameter(checkpoint,bytes,"critic.weight_T",128);let bias=mr_parameter(checkpoint,bytes,"critic.bias",1);let args=vc_args();vc_add(args,vc_path(policy,"policy"));vc_add(args,vc_path(policy,"weights.bin"));vc_add(args,sha);vc_add(args,vc_path(policy,"kernels"));vc_add(args,"3");vc_add(args,"--raw");let process=vc_spawn(args,vc_path(output,"policy.log"),0,1);let magic=alloc(8);vc_io(1,load64(process+8),magic,8);vc_require(load64(magic)==load64("VCPRAW01"),"unexpected raw policy protocol");
    let text=alloc(16384);let b=alloc(32);pl_builder(b,text,16384);pl_text(b,"{\"weightsSHA256\":");pj_text(b,sha);pl_text(b,",\"scoreSHA256\":");pj_text(b,score_sha);pl_text(b,",\"scope\":\"Memory reset, camera blackout and zero feedback on recorded pre-action inputs; not a closed-loop test or a causal intervention on the auxiliary phase head\",\"rows\":[");let indices=alloc(64);store64(indices,0);store64(indices+8,1);store64(indices+16,2);store64(indices+24,3);store64(indices+32,16);store64(indices+40,17);store64(indices+48,18);store64(indices+56,19);let sample=0;
    let hidden=alloc(512);let zero=alloc(512);let zero_own=alloc(28);pb_zero(zero,512);pb_zero(zero_own,28);let input=alloc((21168+7+128)*4);let actual=alloc(135*4);let reset=alloc(135*4);let blind=alloc(135*4);let no_own=alloc(135*4);let actual_action=alloc(8);let reset_action=alloc(8);let blind_action=alloc(8);let no_own_action=alloc(8);
    while sample<8 {let index=load64(indices+sample*8);let current_score=vc_json_file(score_path);let item=pj_index(pj_get(current_score,"rows"),index);vc_require(vc_json_int(item,"caseIndex",0)==index && pj_boolean(item,"auditPassed") && pj_boolean(item,"recordingCompleted") && pl_equal(pj_string_field(item,"policyWeightsSHA256"),sha),"score case or policy mismatch");let root=vc_path(benchmark,vc_int(index));let verified=vc_json_file(vc_path(vc_path(root,"verified"),"result.json"));vc_require(pj_boolean(verified,"passed") && pj_boolean(verified,"taskEventHintAbsent") && !pj_boolean(verified,"blackout") && f64_eq(pj_real(verified,"commandReplayMaxAbsError"),0) && pl_equal(pj_string_field(verified,"weightsSHA256"),sha),"episode replay audit differs");let run=vc_path(root,vc_int(9960000+index));let initial=vc_json_file(vc_path(run,"initial.json"));let frame=vc_json_int(initial,"totalSteps",0);vc_require(vc_json_int(initial,"findReturn","consumedIndex")<0,"episode starts after brick consumption");pb_zero(hidden,512);va_lines(vc_path(run,"decisions.jsonl"));let row=va_next();let t=0;let factual_stops=0;let reset_stops=0;let reset_moves=0;let reset_stop_from_move=0;let blind_stops=0;let no_own_stops=0;let blind_moves=0;let no_own_moves=0;let factual_above=0;let reset_above=0;let factual_phase=0;let reset_phase=0;let factual_margin=0;let reset_margin=0;
        while row && t<30 {let stem=vc_concat("actor-",vc_int(frame));let rgb=vc_map(vc_path(run,vc_concat(stem,".rgb")));vc_require(vc_size==21168,"invalid recorded camera input");let own=vc_map(vc_path(run,vc_concat(stem,".feedback")));vc_require(vc_size==28 && !pb_u32(own+24),"invalid recorded own feedback");vc_policy_input(rgb,own,hidden,input,0);vc_io(0,load64(process+8),input,(21168+7+128)*4);vc_io(1,load64(process+8),actual,135*4);vc_policy_input(rgb,own,zero,input,0);vc_io(0,load64(process+8),input,(21168+7+128)*4);vc_io(1,load64(process+8),reset,135*4);vc_policy_input(rgb,own,hidden,input,1);vc_io(0,load64(process+8),input,(21168+7+128)*4);vc_io(1,load64(process+8),blind,135*4);vc_policy_input(rgb,zero_own,hidden,input,0);vc_io(0,load64(process+8),input,(21168+7+128)*4);vc_io(1,load64(process+8),no_own,135*4);let actual_kind=ca_decode(actual,actual_action);let reset_kind=ca_decode(reset,reset_action);let blind_kind=ca_decode(blind,blind_action);let no_own_kind=ca_decode(no_own,no_own_action);vc_require(actual_kind>=0 && reset_kind>=0 && blind_kind>=0 && no_own_kind>=0,"invalid model output");let expected=pj_get(row,"action");vc_require(pb_u32(actual_action)==pb_f64_to_f32(pj_real_node(pj_index(expected,0))) && pb_u32(actual_action+4)==pb_f64_to_f32(pj_real_node(pj_index(expected,1))),"recurrent replay differs from recorded action");vc_require(vc_json_int(pj_get(row,"state"),"findReturn","consumedIndex")<0,"sample unexpectedly entered return phase");if actual_kind==6 {factual_stops=factual_stops+1;if reset_kind!=6 {reset_moves=reset_moves+1;}if blind_kind!=6 {blind_moves=blind_moves+1;}if no_own_kind!=6 {no_own_moves=no_own_moves+1;}}else if reset_kind==6 {reset_stop_from_move=reset_stop_from_move+1;}if reset_kind==6 {reset_stops=reset_stops+1;}if blind_kind==6 {blind_stops=blind_stops+1;}if no_own_kind==6 {no_own_stops=no_own_stops+1;}
            let p=mr_phase(actual,weights,bias);let q=mr_phase(reset,weights,bias);factual_phase=f64_add(factual_phase,p);reset_phase=f64_add(reset_phase,q);if f64_gt(p,vc_number(1,2)) {factual_above=factual_above+1;}if f64_gt(q,vc_number(1,2)) {reset_above=reset_above+1;}factual_margin=f64_add(factual_margin,mr_stop_margin(actual));reset_margin=f64_add(reset_margin,mr_stop_margin(reset));vc_copy(hidden,actual+28,512);syscall(11,rgb,21168,0,0,0,0);syscall(11,own,28,0,0,0,0);frame=vc_json_int(row,"step",0);t=t+1;row=va_next();
        }vc_require(t==30,"sample has fewer than 30 actions");syscall(11,va_data,va_length,0,0,0,0);if sample {pl_char(b,44);}pl_text(b,"{\"caseIndex\":");pl_int(b,index);pl_text(b,",\"layoutId\":");pl_int(b,18+index/16);pl_text(b,",\"framesCompared\":");pl_int(b,t);pl_text(b,",\"actualStops\":");pl_int(b,factual_stops);pl_text(b,",\"resetPredictedStops\":");pl_int(b,reset_stops);pl_text(b,",\"actualStopResetPredictsMovement\":");pl_int(b,reset_moves);pl_text(b,",\"actualMoveResetPredictsStop\":");pl_int(b,reset_stop_from_move);pl_text(b,",\"blackoutPredictedStops\":");pl_int(b,blind_stops);pl_text(b,",\"zeroFeedbackPredictedStops\":");pl_int(b,no_own_stops);pl_text(b,",\"actualStopBlackoutPredictsMovement\":");pl_int(b,blind_moves);pl_text(b,",\"actualStopZeroFeedbackPredictsMovement\":");pl_int(b,no_own_moves);pl_text(b,",\"actualPhaseAboveHalf\":");pl_int(b,factual_above);pl_text(b,",\"resetPhaseAboveHalf\":");pl_int(b,reset_above);pl_text(b,",\"meanActualPhaseReadout\":");pl_float(b,f64_div(factual_phase,f64_from_i64(t)));pl_text(b,",\"meanResetPhaseReadout\":");pl_float(b,f64_div(reset_phase,f64_from_i64(t)));pl_text(b,",\"meanActualStopLogitMargin\":");pl_float(b,f64_div(factual_margin,f64_from_i64(t)));pl_text(b,",\"meanResetStopLogitMargin\":");pl_float(b,f64_div(reset_margin,f64_from_i64(t)));pl_char(b,125);sample=sample+1;
    }vc_finish(process,15000);pl_text(b,"],\"actualCommandsReplayedExactly\":true,\"phaseReadoutIsTrainingOnlyAndUncalibrated\":true,\"counterfactualInputsFromRecordedTrajectory\":true,\"counterfactualsNeverExecutedInSimulator\":true,\"zeroFeedbackMayBeOutOfDistribution\":true,\"taskFeedbackAlwaysZero\":true}\n");vc_require(!load64(b+24),"memory probe report overflow");vc_write(vc_path(output,"result.json"),text,load64(b+8));return 0;
}

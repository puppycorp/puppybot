// Extend the first convolution for the experimental 128x128 policy graph.
import "../../../flex/control/host.flex";
fn hc_interpolate(old,channel,y,x) {
    let fy=f64_sub(vc_number(2*y+1,3),vc_number(1,2));let fx=f64_sub(vc_number(2*x+1,3),vc_number(1,2));if f64_lt(fy,0) {fy=0;}if f64_lt(fx,0) {fx=0;}if f64_gt(fy,f64_from_i64(7)) {fy=f64_from_i64(7);}if f64_gt(fx,f64_from_i64(7)) {fx=f64_from_i64(7);}let y0=f64_to_i64_trunc(fy);let x0=f64_to_i64_trunc(fx);let y1=pb_min(y0+1,7);let x1=pb_min(x0+1,7);let wy=f64_sub(fy,f64_from_i64(y0));let wx=f64_sub(fx,f64_from_i64(x0));let a=pb_read_float(old+(channel*64+y0*8+x0)*4);let b=pb_read_float(old+(channel*64+y0*8+x1)*4);let c=pb_read_float(old+(channel*64+y1*8+x0)*4);let d=pb_read_float(old+(channel*64+y1*8+x1)*4);let top=f64_add(f64_mul(f64_sub(PB_ONE,wx),a),f64_mul(wx,b));let bottom=f64_add(f64_mul(f64_sub(PB_ONE,wx),c),f64_mul(wx,d));return f64_mul(f64_add(f64_mul(f64_sub(PB_ONE,wy),top),f64_mul(wy,bottom)),vc_number(4,9));
}
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==3,"upgrade-highres-checkpoint SOURCE_WEIGHTS NEW_OUTPUT");let source=vc_map(vc_absolute(load64(argv+8)));let bytes=vc_size;let n=load64(source+8);let base=load64(source+16);let payload=load64(source+24);vc_require(bytes>=32 && load64(source)==load64("PUPV0001") && n>0 && n<=4096 && base==32+n*256 && payload==bytes-base,"invalid source checkpoint");let size=bytes+(6912-3072)*4;let target=alloc(size);vc_copy(target,source,base);store64(target+24,payload+(6912-3072)*4);let old_offset=0;let new_offset=0;let transformed=0;let i=0;
    while i<n {let old=source+32+i*256;let row=target+32+i*256;let count=load64(old+200);let offset=load64(old+208);vc_require(!load8(old+191) && count>0 && offset==old_offset && offset<=payload && count<=((payload-offset)/4),"invalid or noncontiguous checkpoint tensor");store64(row+208,new_offset);if pl_equal(old,"encoder.0.weight") {vc_require(!transformed && load64(old+192)==4 && count==3072 && load64(old+216)==16 && load64(old+224)==3 && load64(old+232)==8 && load64(old+240)==8,"unexpected source convolution shape");let j=0;while j<count {vc_require(f64_is_finite(pb_read_float(source+base+offset+j*4)),"nonfinite source convolution");j=j+1;}store64(row+200,6912);store64(row+232,12);store64(row+240,12);let channel=0;while channel<48 {let y=0;while y<12 {let x=0;while x<12 {let value=hc_interpolate(source+base+offset,channel,y,x);pb_put32(target+base+new_offset+(channel*144+y*12+x)*4,pb_f64_to_f32(value));x=x+1;}y=y+1;}channel=channel+1;}new_offset=new_offset+6912*4;transformed=1;}else {vc_copy(target+base+new_offset,source+base+offset,count*4);new_offset=new_offset+count*4;}old_offset=old_offset+count*4;i=i+1;}
    vc_require(transformed && old_offset==payload && base+new_offset==size,"checkpoint payload layout mismatch");let output=vc_absolute(load64(argv+16));vc_mkdir(output);vc_write(vc_path(output,"weights.bin"),target,size);let text=alloc(1024);let b=alloc(32);pl_builder(b,text,1024);pl_text(b,"{\"passed\":true,\"runtime\":\"Flexscript\",\"pythonRequired\":false,\"sourceWeightsSHA256\":");pj_text(b,vc_digest(source,bytes));pl_text(b,",\"weightsSHA256\":");pj_text(b,vc_digest(target,size));pl_text(b,",\"oldKernel\":8,\"newKernel\":12,\"method\":\"bilinear interpolation with 4/9 area scaling\",\"otherTensorsCopiedExactly\":true,\"behaviorParityNotClaimed\":true}\n");vc_require(!load64(b+24),"high-resolution checkpoint receipt overflow");vc_write(vc_path(output,"receipt.json"),text,load64(b+8));return 0;
}

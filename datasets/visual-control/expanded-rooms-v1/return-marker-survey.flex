// Compare fresh high-resolution rim marker detections with actor RGB pixels.
import "../../../flex/control/verify.flex";
fn rm_marker_pixel(image,x,y) {
    let plane=84*84;let pixel=y*84+x;let r=load8(image+pixel);let g=load8(image+plane+pixel);let b=load8(image+2*plane+pixel);return r>70 && b>60 && r>g*4 && b>g*4 && b*10>r*7;
}
fn rm_nearby(image,u,v) {
    let cx=f64_to_i64_trunc(f64_mul(u,vc_number(84,640)));let cy=f64_to_i64_trunc(f64_mul(v,vc_number(84,480)));let y=pb_max(0,cy-1);while y<=pb_min(83,cy+1) {let x=pb_max(0,cx-1);while x<=pb_min(83,cx+1) {if rm_marker_pixel(image,x,y) {return 1;}x=x+1;}y=y+1;}return 0;
}
fn rm_contrast(image,u,v) {
    let cx=f64_to_i64_trunc(f64_mul(u,vc_number(84,640)));let cy=f64_to_i64_trunc(f64_mul(v,vc_number(84,480)));let best=0;let plane=84*84;let y=pb_max(0,cy-1);while y<=pb_min(83,cy+1) {let x=pb_max(0,cx-1);while x<=pb_min(83,cx+1) {let pixel=y*84+x;let g=load8(image+plane+pixel);let contrast=pb_min(load8(image+pixel)-g,load8(image+2*plane+pixel)-g);best=pb_max(best,contrast);x=x+1;}y=y+1;}return best;
}
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==4,"return-marker-survey MERGED_CORPUS COVERAGE OUTPUT");let runs=vc_absolute(load64(argv+8));let data=vc_map(vc_path(runs,"data.bin"));let bytes=vc_size;let n=load64(data+8);let fit=load64(data+16);let length=load64(data+24);vc_require(vd_row_bytes(data)==56 && n==236 && fit==181 && length==354 && bytes==32+n*length*21224,"unexpected return-expanded data dimensions");let sha=vc_digest(data,bytes);let coverage=vc_json_file(vc_absolute(load64(argv+16)));vc_require(pj_boolean(coverage,"passed") && pj_boolean(coverage,"allNewTripsIndependentlyAudited") && pl_equal(pj_string_field(coverage,"dataSHA256"),sha),"marker survey requires the audited corpus");let text=alloc(16384);let b=alloc(32);pl_builder(b,text,16384);pl_text(b,"{\"dataSHA256\":");pj_text(b,sha);pl_text(b,",\"method\":\"Fresh high-resolution detector marker coordinates compared with 3x3 neighborhoods in 84x84 actor RGB using the original magenta threshold and red/blue minus green contrast; coincidence may include background and is not segmentation\",\"actorInputsUnchanged\":true,\"rows\":[");let sample=0;
    while sample<14 {let episode=174+sample;if sample>=7 {episode=229+sample-7;}let run=vc_path(runs,vc_concat("expert-",vc_int(episode)));let meta=vc_json_file(vc_path(run,"supervision.json"));let start=vc_json_int(meta,"studentStartAction",0);let student=vc_json_int(meta,"studentActions",0);vc_require(pj_boolean(meta,"studentBeginsAfterConsumption") && start>=1 && student>=1 && start+student<=length,"invalid return window");let state=vc_json_file(vc_path(run,"initial.json"));let base=data+32+episode*length*21224;va_lines(vc_path(run,"decisions.jsonl"));let t=0;let fresh=0;let frames=0;let markers=0;let matched=0;let frames_matched=0;let contrast5=0;let contrast10=0;let contrast20=0;let contrast_frames=0;
        while t<start+student {let values=base+length*21168+t*56;vc_require(vd_valid_word(values,56) && !pb_u32(values+24),"invalid input or task hint in marker survey");if t>=start {frames=frames+1;let vision=pj_get(pj_get(state,"case"),"dockVision");if pj_boolean(vision,"valid") && vc_json_int(vision,"frameId",0)==vc_json_int(state,"totalSteps",0) {fresh=fresh+1;let list=pj_get(vision,"markers");let count=pj_count(list);vc_require(pj_kind(list)==3 && count>=1 && count<=16,"invalid fresh marker list");let any=0;let any_contrast=0;let i=0;while i<count {let pixel=pj_get(pj_index(list,i),"pixel");let u=pj_real_node(pj_index(pixel,0));let v=pj_real_node(pj_index(pixel,1));vc_require(!pj_error && f64_ge(u,0) && f64_lt(u,f64_from_i64(640)) && f64_ge(v,0) && f64_lt(v,f64_from_i64(480)),"marker outside sensor image");markers=markers+1;if rm_nearby(base+t*21168,u,v) {matched=matched+1;any=1;}let contrast=rm_contrast(base+t*21168,u,v);if contrast>=5 {contrast5=contrast5+1;}if contrast>=10 {contrast10=contrast10+1;any_contrast=1;}if contrast>=20 {contrast20=contrast20+1;}i=i+1;}if any {frames_matched=frames_matched+1;}if any_contrast {contrast_frames=contrast_frames+1;}}}let row=va_next();vc_require(row,"marker history truncated");state=pj_get(row,"state");t=t+1;}
        if sample {pl_char(b,44);}pl_text(b,"{\"index\":");pl_int(b,episode);pl_text(b,",\"fit\":");pj_bool_text(b,episode<fit);pl_text(b,",\"studentReturnFrames\":");pl_int(b,frames);pl_text(b,",\"freshDetectorFrames\":");pl_int(b,fresh);pl_text(b,",\"highResolutionMarkers\":");pl_int(b,markers);pl_text(b,",\"markersWithThresholdPixelNearbyInActorRGB\":");pl_int(b,matched);pl_text(b,",\"freshFramesWithThresholdPixel\":");pl_int(b,frames_matched);pl_text(b,",\"markersWithContrastAtLeast5\":");pl_int(b,contrast5);pl_text(b,",\"markersWithContrastAtLeast10\":");pl_int(b,contrast10);pl_text(b,",\"markersWithContrastAtLeast20\":");pl_int(b,contrast20);pl_text(b,",\"freshFramesWithContrastAtLeast10\":");pl_int(b,contrast_frames);pl_char(b,125);syscall(11,va_data,va_length,0,0,0,0);sample=sample+1;
    }pl_text(b,"],\"eventHintInputAlwaysZero\":true,\"notProofOfModelPerception\":true}\n");vc_require(!load64(b+24),"marker survey report overflow");vc_write(vc_absolute(load64(argv+24)),text,load64(b+8));return 0;
}

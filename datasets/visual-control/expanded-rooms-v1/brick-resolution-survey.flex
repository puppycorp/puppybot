// Offline visibility diagnostic. Simulator geometry is used only to locate a
// sample in a recorded image, never as an actor input.
import "../../../flex/control/verify.flex";
fn br_project(path,frame,target,out) {
    let metadata=vc_json_file(path);vc_require(vc_json_int(metadata,"frameId",0)==frame && pl_equal(pj_string_field(metadata,"view"),"tcp"),"camera metadata differs");let vectors=alloc(96);va_vector(pj_get(metadata,"eyeM"),vectors,3);va_vector(pj_get(metadata,"forward"),vectors+24,3);va_vector(pj_get(metadata,"right"),vectors+48,3);va_vector(pj_get(metadata,"down"),vectors+72,3);let depth=0;let horizontal=0;let vertical=0;let i=0;while i<3 {let delta=f64_sub(load64(target+i*8),load64(vectors+i*8));depth=f64_add(depth,f64_mul(delta,load64(vectors+24+i*8)));horizontal=f64_add(horizontal,f64_mul(delta,load64(vectors+48+i*8)));vertical=f64_add(vertical,f64_mul(delta,load64(vectors+72+i*8)));i=i+1;}if f64_le(depth,0) {return 0;}let intrinsics=pj_get(metadata,"intrinsics");let x=f64_add(pj_real(intrinsics,"cx"),f64_mul(pj_real(intrinsics,"fx"),f64_div(horizontal,depth)));let y=f64_add(pj_real(intrinsics,"cy"),f64_mul(pj_real(intrinsics,"fy"),f64_div(vertical,depth)));store64(out,x);store64(out+8,y);return f64_ge(x,0) && f64_lt(x,f64_from_i64(640)) && f64_ge(y,0) && f64_lt(y,f64_from_i64(480));
}
fn br_red(r,g,b) {return r>=45 && r>2*g && r>2*b;}
fn br_count_rgb(rgb,x,y,radius) {let total=0;let iy=pb_max(0,y-radius);while iy<=pb_min(479,y+radius) {let ix=pb_max(0,x-radius);while ix<=pb_min(639,x+radius) {let p=rgb+(iy*640+ix)*3;if br_red(load8(p),load8(p+1),load8(p+2)) {total=total+1;}ix=ix+1;}iy=iy+1;}return total;}
fn br_count_actor(rgb,size,x,y) {let total=0;let plane=size*size;let iy=pb_max(0,y-2);while iy<=pb_min(size-1,y+2) {let ix=pb_max(0,x-2);while ix<=pb_min(size-1,x+2) {let p=iy*size+ix;if br_red(load8(rgb+p),load8(rgb+plane+p),load8(rgb+plane*2+p)) {total=total+1;}ix=ix+1;}iy=iy+1;}return total;}
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==3,"brick-resolution-survey RUN OUTPUT");let run=vc_absolute(load64(argv+8));let output=vc_absolute(load64(argv+16));vc_mkdir(output);let initial=vc_json_file(vc_path(run,"initial.json"));let target=alloc(24);va_vector(pj_get(pj_index(pj_get(pj_get(initial,"case"),"objects"),0),"position"),target,3);let targets=alloc(9*8);let nearest=alloc(9*24);let values=alloc(9*8);store64(values,vc_number(35,10));store64(values+8,vc_number(3,1));store64(values+16,vc_number(25,10));store64(values+24,vc_number(2,1));store64(values+32,vc_number(15,10));store64(values+40,vc_number(1,1));store64(values+48,vc_number(7,10));store64(values+56,vc_number(5,10));store64(values+64,vc_number(35,100));let i=0;while i<9 {store64(nearest+i*24,0x7ff0000000000000);i=i+1;}va_lines(vc_path(run,"decisions.jsonl"));let row=va_next();let count=0;
    while row {let state=pj_get(row,"state");let pose=alloc(24);ve_pose_read(state,pose);let distance=f64_hypot(f64_sub(load64(pose),load64(target)),f64_sub(load64(pose+8),load64(target+8)));let frame=vc_json_int(state,"totalSteps",0);i=0;while i<9 {let error=f64_magnitude(f64_sub(distance,load64(values+i*8)));let slot=nearest+i*24;if f64_lt(error,load64(slot)) {store64(slot,error);store64(slot+8,frame);store64(slot+16,distance);}i=i+1;}count=count+1;let consumed=vc_json_int(state,"findReturn","consumedIndex")>=0;syscall(11,pose,24,0,0,0,0);if consumed {row=0;}else {row=va_next();}}
    vc_require(count>0,"empty recorded search");syscall(11,va_data,va_length,0,0,0,0);let rgb=alloc(640*480*3);let actor=alloc(21168);let resized=alloc(3*168*168);let point=alloc(16);let compare=ffi_symbol(ffi_open("libc.so.6"),"memcmp");vc_require(compare,"memcmp unavailable");let text=alloc(8192);let b=alloc(32);pl_builder(b,text,8192);pl_text(b,"{\"scope\":\"Offline projection and red-pixel heuristic on recorded teacher images; not proven segmentation or learned perception\",\"searchActions\":");pl_int(b,count);pl_text(b,",\"samples\":[");i=0;
    while i<9 {let slot=nearest+i*24;let frame=load64(slot+8);let png=vc_path(vc_path(run,"sensor"),vc_concat(vc_concat("frame-",vc_int(frame)),".png"));va_png(png,rgb);let visible=br_project(vc_concat(png,".camera.json"),frame,target,point);let saved=vc_map(vc_path(run,vc_concat(vc_concat("actor-",vc_int(frame)),".rgb")));vc_require(vc_size==21168,"invalid recorded actor image");vc_resize(rgb,actor);vc_require(!ffi_call(compare,saved,actor,21168,0,0,0),"84x84 actor image differs from sensor resize");syscall(11,saved,21168,0,0,0,0);if !i {vc_write(vc_path(output,"sample0-rgb.raw"),rgb,640*480*3);}if i {pl_char(b,44);}pl_text(b,"{\"requestedDistanceM\":");pl_float(b,load64(values+i*8));pl_text(b,",\"actualDistanceM\":");pl_float(b,load64(slot+16));pl_text(b,",\"frame\":");pl_int(b,frame);pl_text(b,",\"projectedCenterInFrame\":");pj_bool_text(b,visible);pl_text(b,",\"projectionPixel\":");if visible {pl_char(b,91);pl_float(b,load64(point));pl_char(b,44);pl_float(b,load64(point+8));pl_char(b,93);}else {pl_text(b,"null");}pl_text(b,",\"redPixelsNearProjection\":[");let sizes=alloc(24);store64(sizes,84);store64(sizes+8,128);store64(sizes+16,168);let original=0;let x=f64_to_i64_trunc(load64(point));let y=f64_to_i64_trunc(load64(point+8));if visible {original=br_count_rgb(rgb,x,y,10);}pl_int(b,original);let k=0;while k<3 {let size=load64(sizes+k*8);vc_resize_to(rgb,resized,size);if !i {vc_write(vc_path(output,vc_concat(vc_concat("sample0-",vc_int(size)),".rgb")),resized,3*size*size);}let found=0;if visible {found=br_count_actor(resized,size,x*size/640,y*size/480);}pl_char(b,44);pl_int(b,found);k=k+1;}pl_text(b,"]}");i=i+1;}
    pl_text(b,"],\"pixelOrder\":[\"640x480-radius10\",\"84x84-radius2\",\"128x128-radius2\",\"168x168-radius2\"],\"recorded84PixelsChecked\":true,\"geometryTrainingDiagnosticOnly\":true}\n");vc_require(!load64(b+24),"brick resolution report overflow");vc_write(vc_path(output,"result.json"),text,load64(b+8));return 0;
}

// Make a tiny two-history GPU smoke fixture, never a performance dataset.
import "../../../flex/control/target-supervision.flex";
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==4,"large-model-smoke-data DATA TARGETS OUTPUT");let source=vc_map(vc_absolute(load64(argv+8)));let source_bytes=vc_size;let targets=vc_absolute(load64(argv+16));let output=vc_absolute(load64(argv+24));let n=load64(source+8);let fit=load64(source+16);let length=load64(source+24);vc_require(load64(source)==load64("PVDATA03") && n>=2 && fit>=1 && fit<n && length>=8 && source_bytes==32+n*length*(21168+56),"invalid 84x84 source");pt_target_open_with_image(targets,source,source_bytes,56,21168);
    let steps=8;let bytes=32+2*steps*(21168+56);let data=alloc(bytes);vc_copy(data,"PVDATA03",8);store64(data+8,2);store64(data+16,1);store64(data+24,steps);let labels=alloc(32+2*steps*12);vc_copy(labels,"PVVIS001",8);store64(labels+8,2);store64(labels+16,1);store64(labels+24,steps);let counts=alloc(16);let group=0;
    while group<2 {let begin=0;let end=fit;if group {begin=fit;end=n;}let found=0;let episode=begin;
        while episode<end && !found {let base=source+32+episode*length*(21168+56);let t=0;while t+steps<=length && !found {let valid=1;let candidates=0;let i=0;while i<steps {let row=base+length*21168+(t+i)*56;let label=pt_target_data+32+(episode*length+t+i)*12;if !vd_valid_word(row,56) {valid=0;}if pb_u32(label+8) {candidates=candidates+1;}i=i+1;}if valid && candidates {let dest=data+32+group*steps*(21168+56);vc_copy(dest,base+t*21168,steps*21168);vc_copy(dest+steps*21168,base+length*21168+t*56,steps*56);vc_copy(labels+32+group*steps*12,pt_target_data+32+(episode*length+t)*12,steps*12);store64(counts+group*8,candidates);found=1;}t=t+1;}episode=episode+1;}vc_require(found,"no valid eight-frame label window in split");group=group+1;
    }
    vc_mkdir(output);vc_write(vc_path(output,"data.bin"),data,bytes);vc_write(vc_path(output,"targets.bin"),labels,32+2*steps*12);let text=alloc(2048);let b=alloc(32);pl_builder(b,text,2048);pl_text(b,"{\"passed\":true,\"smokeFixtureOnly\":true,\"sourceDataSHA256\":");pj_text(b,vc_digest(data,bytes));pl_text(b,",\"parentDataSHA256\":");pj_text(b,vc_digest(source,source_bytes));pl_text(b,",\"targetsSHA256\":");pj_text(b,vc_digest(labels,32+2*steps*12));pl_text(b,",\"episodes\":2,\"fittingHistories\":1,\"validationHistories\":1,\"sequenceLength\":8,\"fittingCandidates\":");pl_int(b,load64(counts));pl_text(b,",\"validationCandidates\":");pl_int(b,load64(counts+8));pl_text(b,",\"projectionAndPixelsIndependentlyRechecked\":true,\"visibilityHeuristicNotProvenSegmentation\":true,\"actorInputsUnchanged\":true}\n");vc_require(!load64(b+24),"smoke receipt overflow");vc_write(vc_path(output,"receipt.json"),text,load64(b+8));pt_target_open_with_image(output,data,bytes,56,21168);return 0;
}

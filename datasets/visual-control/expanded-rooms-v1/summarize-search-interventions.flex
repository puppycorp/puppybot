// Compare oracle labels and executed actions on audited initial student roll-ins.
// Simulator phase and oracle commands are used only in this offline analysis.
import "../../../flex/control/dataset.flex";
import "../../../flex/control/actions.flex";
fn ss_add(stats,group,field) {let slot=stats+(group*12+field)*8;store64(slot,load64(slot)+1);return 0;}
fn ss_direction(speed) {vc_require(f64_is_finite(speed),"invalid command speed");if f64_gt(speed,0) {return 1;}if f64_lt(speed,0) {return -1;}return 0;}
fn ss_array(builder,stats,group) {pl_char(builder,91);let i=0;while i<12 {if i {pl_char(builder,44);}pl_int(builder,load64(stats+(group*12+i)*8));i=i+1;}pl_char(builder,93);return 0;}
fn ss_matrix(builder,matrix,group) {pl_char(builder,91);let teacher=0;while teacher<7 {if teacher {pl_char(builder,44);}pl_char(builder,91);let student=0;while student<7 {if student {pl_char(builder,44);}pl_int(builder,load64(matrix+(group*49+teacher*7+student)*8));student=student+1;}pl_char(builder,93);teacher=teacher+1;}pl_char(builder,93);return 0;}
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==4,"summarize-search-interventions DATA RUNS AUDIT");let data=vd_map(vc_absolute(load64(argv+8)));let bytes=vc_size;vc_require(bytes>=32 && vd_row_bytes(data)==56,"invalid dense data header");
    let n=load64(data+8);let fit=load64(data+16);let length=load64(data+24);vc_require(n>=2 && n<=vd_episode_limit(data) && fit>=1 && fit<n && length>=1 && length<=512 && bytes==32+n*length*21224,"invalid dense data dimensions");
    let checksum=vc_digest(data,bytes);let audit=vc_json_file(vc_absolute(load64(argv+24)));vc_require(pj_boolean(audit,"passed") && vc_json_int(audit,"episodes",0)==n && vc_json_int(audit,"datasetEpisodes",0)==n && f64_eq(vc_json_real(audit,"studentRollinMaxAbsError",0),0) && pj_boolean(audit,"denseOracleLabels") && pj_boolean(audit,"datasetInputsMatchActualRGBAndOwnFeedback") && pj_boolean(audit,"executedCommandsMatchRecordings") && pj_boolean(audit,"preActionAlignmentChecked") && pj_boolean(audit,"zeroPaddingChecked") && pj_boolean(audit,"taskEventHintAbsent") && pl_equal(pj_string_field(audit,"dataSHA256"),checksum),"audit receipt does not match intervention data");let audited=vc_json_int(audit,"studentRollinCommandsReplayed",0);
    let runs=vc_absolute(load64(argv+16));let stats=alloc(4*12*8);pb_zero(stats,4*12*8);let matrix=alloc(4*49*8);pb_zero(matrix,4*49*8);let total=0;let episode=0;
    while episode<n {let role=0;if episode>=fit {role=2;}let run=vc_path(runs,vc_concat("expert-",vc_int(episode)));let meta=vc_json_file(vc_path(run,"supervision.json"));let start=vc_json_int(meta,"studentStartAction",0);let count=vc_json_int(meta,"studentActions",0);
        vc_require(pj_boolean(meta,"denseOracleLabels") && !pj_boolean(meta,"studentBeginsAfterConsumption") && start==0 && count>=1 && count<=length,"invalid initial student intervention window");let base=data+32+episode*length*21224;let previous_teacher=0;let previous_student=0;let previous_phase=-1;let seen_search=0;let seen_return=0;let i=0;
        while i<count {let row=base+length*21168+i*56;let phase=0;if pb_u32(row+36)==0x3f800000 {phase=1;}else {vc_require(!pb_u32(row+36),"invalid phase label");}vc_require(pb_u32(row+40)==0x3f800000 && pb_u32(row+44)==0x3f800000 && !pb_u32(row+24),"intervention window includes invalid or unmasked frames");let group=role+phase;if !phase && !seen_search {ss_add(stats,group,0);seen_search=1;}if phase && !seen_return {ss_add(stats,group,0);seen_return=1;}
            let teacher=ca_class(pb_read_float(row+28),pb_read_float(row+32));let student=ca_class(pb_read_float(row+48),pb_read_float(row+52));vc_require(teacher>=0 && student>=0,"intervention command is outside action codec");let cell=matrix+(group*49+teacher*7+student)*8;store64(cell,load64(cell)+1);let a=ss_direction(pb_read_float(row+32));let b=ss_direction(pb_read_float(row+52));ss_add(stats,group,1);if teacher!=student {ss_add(stats,group,2);}if a && b && a!=b {ss_add(stats,group,3);}if !a {ss_add(stats,group,4);}if !b {ss_add(stats,group,5);}
            if previous_phase==phase && previous_teacher && a {ss_add(stats,group,6);if previous_teacher!=a {ss_add(stats,group,7);}else {ss_add(stats,group,8);if previous_student && b {ss_add(stats,group,9);if previous_student!=b {ss_add(stats,group,10);}}}}
            if previous_phase==phase && previous_student && b && previous_student!=b {ss_add(stats,group,11);}previous_teacher=a;previous_student=b;previous_phase=phase;i=i+1;
        }total=total+count;episode=episode+1;
    }
    vc_require(total==audited,"student window count differs from replay audit");let text=alloc(8192);let b=alloc(32);pl_builder(b,text,8192);pl_text(b,"{\"passed\":true,\"runtime\":\"Flexscript\",\"dataSHA256\":");pj_text(b,checksum);pl_text(b,",\"studentActions\":");pl_int(b,total);pl_text(b,",\"fieldOrder\":[\"histories\",\"actions\",\"jointActionDisagreements\",\"oppositeMovingDirections\",\"teacherStops\",\"studentStops\",\"teacherMovingPairs\",\"teacherDirectionReversals\",\"stableTeacherPairs\",\"stableTeacherBothStudentMovingPairs\",\"studentReversalsWhenTeacherStable\",\"studentDirectionReversals\"],\"fitSearch\":");ss_array(b,stats,0);pl_text(b,",\"fitReturn\":");ss_array(b,stats,1);pl_text(b,",\"validationSearch\":");ss_array(b,stats,2);pl_text(b,",\"validationReturn\":");ss_array(b,stats,3);pl_text(b,",\"actionClassOrder\":[\"forwardLeft\",\"forwardStraight\",\"forwardRight\",\"reverseLeft\",\"reverseStraight\",\"reverseRight\",\"stop\"],\"matrixRowsTeacherColumnsStudent\":true,\"fitSearchMatrix\":");ss_matrix(b,matrix,0);pl_text(b,",\"fitReturnMatrix\":");ss_matrix(b,matrix,1);pl_text(b,",\"validationSearchMatrix\":");ss_matrix(b,matrix,2);pl_text(b,",\"validationReturnMatrix\":");ss_matrix(b,matrix,3);pl_text(b,",\"oracleTrainingOnly\":true,\"actorInputsUnchanged\":true,\"offlineAnalysisOnly\":true}\n");vc_require(!load64(b+24) && !pl_write(1,text,load64(b+8)),"cannot write intervention summary");return 0;
}

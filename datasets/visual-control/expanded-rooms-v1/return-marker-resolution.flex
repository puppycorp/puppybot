// Compare the same audited camera frames at several full-field resolutions.
import "../../../flex/control/verify.flex";
fn rr_resize(rgb,out,size) {
    let y=0;while y<size {let x=0;while x<size {let c=0;while c<3 {let sum=0;let iy=y*480/size;while iy*size<(y+1)*480 {let wy=pb_min((iy+1)*size,(y+1)*480)-pb_max(iy*size,y*480);let ix=x*640/size;while ix*size<(x+1)*640 {let wx=pb_min((ix+1)*size,(x+1)*640)-pb_max(ix*size,x*640);sum=sum+load8(rgb+(iy*640+ix)*3+c)*wx*wy;ix=ix+1;}iy=iy+1;}let value=sum/307200;let remainder=sum%307200;if remainder>153600 || (remainder==153600 && (value&1)) {value=value+1;}store8(out+(c*size+y)*size+x,value);c=c+1;}x=x+1;}y=y+1;}return 0;
}
fn rr_marker(image,size,u,v) {
    let cx=f64_to_i64_trunc(f64_mul(u,vc_number(size,640)));let cy=f64_to_i64_trunc(f64_mul(v,vc_number(size,480)));let best=0;let strict=0;let plane=size*size;let y=pb_max(0,cy-1);while y<=pb_min(size-1,cy+1) {let x=pb_max(0,cx-1);while x<=pb_min(size-1,cx+1) {let pixel=y*size+x;let r=load8(image+pixel);let g=load8(image+plane+pixel);let blue=load8(image+2*plane+pixel);let contrast=pb_min(r-g,blue-g);best=pb_max(best,contrast);if r>70 && blue>60 && r>g*4 && blue>g*4 && blue*10>r*7 {strict=1;}x=x+1;}y=y+1;}return strict|(best>=5)*2|(best>=10)*4|(best>=20)*8;
}
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==4,"return-marker-resolution MERGED_CORPUS COVERAGE OUTPUT");let runs=vc_absolute(load64(argv+8));let data=vc_map(vc_path(runs,"data.bin"));let bytes=vc_size;let n=load64(data+8);let fit=load64(data+16);let length=load64(data+24);vc_require(vd_row_bytes(data)==56 && n==236 && fit==181 && length==354 && bytes==32+n*length*21224,"unexpected return-expanded data dimensions");let sha=vc_digest(data,bytes);let coverage=vc_json_file(vc_absolute(load64(argv+16)));vc_require(pj_boolean(coverage,"passed") && pj_boolean(coverage,"allNewTripsIndependentlyAudited") && pl_equal(pj_string_field(coverage,"dataSHA256"),sha),"resolution survey requires the audited corpus");let compare=ffi_symbol(ffi_open("libc.so.6"),"memcmp");vc_require(compare,"memcmp unavailable");let raw=alloc(640*480*3);let generic84=alloc(84*84*3);let shared128=alloc(128*128*3);let shared168=alloc(168*168*3);let images=alloc(24);store64(images,alloc(84*84*3));store64(images+8,alloc(128*128*3));store64(images+16,alloc(168*168*3));let sizes=alloc(24);store64(sizes,84);store64(sizes+8,128);store64(sizes+16,168);let counts=alloc(3*5*8);let fresh=0;let markers=0;let sample=0;
    while sample<14 {let episode=174+sample;if sample>=7 {episode=229+sample-7;}let run=vc_path(runs,vc_concat("expert-",vc_int(episode)));let meta=vc_json_file(vc_path(run,"supervision.json"));let start=vc_json_int(meta,"studentStartAction",0);let student=vc_json_int(meta,"studentActions",0);vc_require(pj_boolean(meta,"studentBeginsAfterConsumption") && start>=1 && student>=1 && start+student<=length,"invalid return window");let state=vc_json_file(vc_path(run,"initial.json"));let base=data+32+episode*length*21224;va_lines(vc_path(run,"decisions.jsonl"));let t=0;
        while t<start+student {let values=base+length*21168+t*56;vc_require(vd_valid_word(values,56) && !pb_u32(values+24),"invalid input or task hint in resolution survey");if t>=start {let vision=pj_get(pj_get(state,"case"),"dockVision");let frame=vc_json_int(state,"totalSteps",0);if pj_boolean(vision,"valid") && vc_json_int(vision,"frameId",0)==frame {fresh=fresh+1;let png=vc_path(vc_path(run,"sensor"),vc_concat(vc_concat("frame-",vc_int(frame)),".png"));va_png(png,raw);vc_resize(raw,load64(images));rr_resize(raw,generic84,84);vc_require(!ffi_call(compare,load64(images),base+t*21168,84*84*3,0,0,0) && !ffi_call(compare,generic84,load64(images),84*84*3,0,0,0),"84x84 reference or generic resize differs from audited actor input");rr_resize(raw,load64(images+8),128);rr_resize(raw,load64(images+16),168);vc_resize_to(raw,shared128,128);vc_resize_to(raw,shared168,168);vc_require(!ffi_call(compare,shared128,load64(images+8),128*128*3,0,0,0) && !ffi_call(compare,shared168,load64(images+16),168*168*3,0,0,0),"larger shared resize differs from independent area integration");let list=pj_get(vision,"markers");let count=pj_count(list);vc_require(pj_kind(list)==3 && count>=1 && count<=16,"invalid fresh marker list");let flags=alloc(24);let i=0;while i<count {let pixel=pj_get(pj_index(list,i),"pixel");let u=pj_real_node(pj_index(pixel,0));let v=pj_real_node(pj_index(pixel,1));vc_require(!pj_error && f64_ge(u,0) && f64_lt(u,f64_from_i64(640)) && f64_ge(v,0) && f64_lt(v,f64_from_i64(480)),"marker outside sensor image");markers=markers+1;let resolution=0;while resolution<3 {let value=rr_marker(load64(images+resolution*8),load64(sizes+resolution*8),u,v);let j=0;while j<4 {let at=counts+(resolution*5+j)*8;if value&(1<<j) {store64(at,load64(at)+1);}j=j+1;}if value&4 {store64(flags+resolution*8,1);}resolution=resolution+1;}i=i+1;}let resolution=0;while resolution<3 {if load64(flags+resolution*8) {let at=counts+(resolution*5+4)*8;store64(at,load64(at)+1);}resolution=resolution+1;}syscall(11,flags,24,0,0,0,0);}}let row=va_next();vc_require(row,"resolution history truncated");state=pj_get(row,"state");t=t+1;}
        syscall(11,va_data,va_length,0,0,0,0);sample=sample+1;
    }let text=alloc(4096);let b=alloc(32);pl_builder(b,text,4096);pl_text(b,"{\"dataSHA256\":");pj_text(b,sha);pl_text(b,",\"scope\":\"Offline full-field area resizes on fresh detector locations; thresholds and spatial coincidence do not establish model perception or segmentation\",\"episodes\":14,\"freshDetectorFrames\":");pl_int(b,fresh);pl_text(b,",\"highResolutionMarkers\":");pl_int(b,markers);pl_text(b,",\"actor84MatchedRecordedInputs\":true,\"generic84MatchedReference\":true,\"largerResizesMatchedIndependent\":true,\"actorInputsUnchanged\":true,\"resolutions\":[");let resolution=0;while resolution<3 {if resolution {pl_char(b,44);}let at=counts+resolution*5*8;pl_text(b,"{\"pixels\":");pl_int(b,load64(sizes+resolution*8));pl_text(b,",\"strictMarkerMatches\":");pl_int(b,load64(at));pl_text(b,",\"contrastAtLeast5\":");pl_int(b,load64(at+8));pl_text(b,",\"contrastAtLeast10\":");pl_int(b,load64(at+16));pl_text(b,",\"contrastAtLeast20\":");pl_int(b,load64(at+24));pl_text(b,",\"framesWithContrastAtLeast10\":");pl_int(b,load64(at+32));pl_char(b,125);resolution=resolution+1;}pl_text(b,"]}\n");vc_require(!load64(b+24),"resolution survey report overflow");vc_write(vc_absolute(load64(argv+24)),text,load64(b+8));return 0;
}

// Compare offline oracle and executed commands only within audited student
// return windows. Neither the oracle nor its labels become policy inputs.
import "../../../flex/control/dataset.flex";
import "../../../flex/control/actions.flex";
fn si_add(stats,group,field) {let slot=stats+(group*12+field)*8;store64(slot,load64(slot)+1);return 0;}
fn si_direction(speed) {vc_require(f64_is_finite(speed),"invalid command speed");if f64_gt(speed,0) {return 1;}if f64_lt(speed,0) {return -1;}return 0;}
fn si_array(builder,stats,group) {pl_char(builder,91);let i=0;while i<12 {if i {pl_char(builder,44);}pl_int(builder,load64(stats+(group*12+i)*8));i=i+1;}pl_char(builder,93);return 0;}
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==4,"summarize-return-interventions DATA RUNS AUDIT");let path=vc_absolute(load64(argv+8));let data=vd_map(path);let bytes=vc_size;vc_require(bytes>=32 && vd_row_bytes(data)==56,"invalid dense data header");
    let n=load64(data+8);let fit=load64(data+16);let length=load64(data+24);vc_require(n>=2 && n<=vd_episode_limit(data) && fit>=1 && fit<n && length>=1 && length<=512 && bytes==32+n*length*21224,"invalid dense data dimensions");
    let checksum=vc_digest(data,bytes);let audit=vc_json_file(vc_absolute(load64(argv+24)));vc_require(pj_boolean(audit,"passed") && vc_json_int(audit,"episodes",0)==n && vc_json_int(audit,"datasetEpisodes",0)==n && f64_eq(vc_json_real(audit,"studentRollinMaxAbsError",0),0) && pj_boolean(audit,"denseOracleLabels") && pj_boolean(audit,"datasetInputsMatchActualRGBAndOwnFeedback") && pj_boolean(audit,"executedCommandsMatchRecordings") && pj_boolean(audit,"preActionAlignmentChecked") && pj_boolean(audit,"zeroPaddingChecked") && pj_boolean(audit,"taskEventHintAbsent") && pl_equal(pj_string_field(audit,"dataSHA256"),checksum),"audit receipt does not match intervention data");let audited=vc_json_int(audit,"studentRollinCommandsReplayed",0);
    let runs=vc_absolute(load64(argv+16));let stats=alloc(2*12*8);let total=0;let episode=0;
    while episode<n {let group=0;if episode>=fit {group=1;}let run=vc_path(runs,vc_concat("expert-",vc_int(episode)));let meta=vc_json_file(vc_path(run,"supervision.json"));let start=vc_json_int(meta,"studentStartAction",0);let count=vc_json_int(meta,"studentActions",0);
        vc_require(pj_boolean(meta,"denseOracleLabels") && pj_boolean(meta,"studentBeginsAfterConsumption") && start>=1 && count>=1 && start+count<=length,"invalid return intervention window");let base=data+32+episode*length*21224;let previous_teacher=0;let previous_student=0;let i=0;si_add(stats,group,0);
        while i<count {let row=base+length*21168+(start+i)*56;vc_require(pb_u32(row+36)==0x3f800000 && pb_u32(row+40)==0x3f800000 && pb_u32(row+44)==0x3f800000 && !pb_u32(row+24),"intervention window includes invalid or unmasked frames");let teacher=ca_class(pb_read_float(row+28),pb_read_float(row+32));let student=ca_class(pb_read_float(row+48),pb_read_float(row+52));vc_require(teacher>=0 && student>=0,"intervention command is outside action codec");let a=si_direction(pb_read_float(row+32));let b=si_direction(pb_read_float(row+52));si_add(stats,group,1);if teacher!=student {si_add(stats,group,2);}if a && b && a!=b {si_add(stats,group,3);}if !a {si_add(stats,group,4);}if !b {si_add(stats,group,5);}
            if previous_teacher && a {si_add(stats,group,6);if previous_teacher!=a {si_add(stats,group,7);}else {si_add(stats,group,8);if previous_student && b {si_add(stats,group,9);if previous_student!=b {si_add(stats,group,10);}}}}
            if previous_student && b && previous_student!=b {si_add(stats,group,11);}previous_teacher=a;previous_student=b;i=i+1;
        }total=total+count;episode=episode+1;
    }
    vc_require(total==audited,"student window count differs from replay audit");let text=alloc(4096);let b=alloc(32);pl_builder(b,text,4096);pl_text(b,"{\"passed\":true,\"runtime\":\"Flexscript\",\"dataSHA256\":");pj_text(b,checksum);pl_text(b,",\"studentActions\":");pl_int(b,total);pl_text(b,",\"fieldOrder\":[\"histories\",\"actions\",\"jointActionDisagreements\",\"oppositeMovingDirections\",\"teacherStops\",\"studentStops\",\"teacherMovingPairs\",\"teacherDirectionReversals\",\"stableTeacherPairs\",\"stableTeacherBothStudentMovingPairs\",\"studentReversalsWhenTeacherStable\",\"studentDirectionReversals\"],\"fitting\":");si_array(b,stats,0);pl_text(b,",\"validation\":");si_array(b,stats,1);pl_text(b,",\"oracleTrainingOnly\":true,\"actorInputsUnchanged\":true,\"offlineAnalysisOnly\":true}\n");vc_require(!load64(b+24) && !pl_write(1,text,load64(b+8)),"cannot write intervention summary");return 0;
}

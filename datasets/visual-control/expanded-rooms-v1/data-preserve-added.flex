// Compare every retained dense history after adding fitting and validation trips.
import "../../../flex/control/dataset.flex";
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==4,"data-preserve-added OLD_DATA EXPANDED_DATA OUTPUT");let old=vd_map(vc_absolute(load64(argv+8)));let old_bytes=vc_size;let next=vd_map(vc_absolute(load64(argv+16)));let next_bytes=vc_size;vc_require(old_bytes>=32 && next_bytes>=32,"invalid data header");let old_n=load64(old+8);let old_fit=load64(old+16);let n=load64(next+8);let fit=load64(next+16);let length=load64(old+24);let history_bytes=length*21224;
    vc_require(vd_row_bytes(old)==56 && old_n>=2 && old_n<=vd_episode_limit(old) && old_fit>=1 && old_fit<old_n && length>=1 && length<=512 && old_bytes==32+old_n*history_bytes,"invalid original data dimensions");
    vc_require(vd_row_bytes(next)==56 && n>=old_n && n<=vd_episode_limit(next) && fit>=old_fit && fit<n && n-fit>=old_n-old_fit && load64(next+24)==length && next_bytes==32+n*history_bytes,"invalid expanded data dimensions");
    let compare=ffi_symbol(ffi_open("libc.so.6"),"memcmp");vc_require(compare,"memcmp unavailable");let episode=0;while episode<old_n {let target=episode;if episode>=old_fit {target=episode+fit-old_fit;}vc_require(!ffi_call(compare,old+32+episode*history_bytes,next+32+target*history_bytes,history_bytes,0,0,0),"existing history changed");episode=episode+1;}
    let text=alloc(1024);let b=alloc(32);pl_builder(b,text,1024);pl_text(b,"{\"passed\":true,\"existingHistoriesPreserved\":");pl_int(b,old_n);pl_text(b,",\"fittingHistories\":");pl_int(b,old_fit);pl_text(b,",\"validationHistories\":");pl_int(b,old_n-old_fit);pl_text(b,",\"expandedHistories\":");pl_int(b,n);pl_text(b,",\"expandedFittingHistories\":");pl_int(b,fit);pl_text(b,",\"sequenceLength\":");pl_int(b,length);pl_text(b,",\"oldDataSHA256\":");pj_text(b,vc_digest(old,old_bytes));pl_text(b,",\"expandedDataSHA256\":");pj_text(b,vc_digest(next,next_bytes));pl_text(b,"}\n");vc_require(!load64(b+24),"data preservation report overflow");vc_write(vc_absolute(load64(argv+24)),text,load64(b+8));return 0;
}

// Check retained weights and constant-input response after kernel resizing.
import "../../../flex/control/host.flex";
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==4,"verify-highres-checkpoint SOURCE_WEIGHTS HIGHRES_DIRECTORY OUTPUT_JSON");let old=vc_map(vc_absolute(load64(argv+8)));let old_bytes=vc_size;let n=load64(old+8);let base=load64(old+16);let old_payload=load64(old+24);vc_require(old_bytes>=32 && load64(old)==load64("PUPV0001") && n>0 && n<=4096 && base==32+n*256 && old_payload==old_bytes-base,"invalid source checkpoint");let directory=vc_absolute(load64(argv+16));let next=vc_map(vc_path(directory,"weights.bin"));let next_bytes=vc_size;let next_payload=load64(next+24);vc_require(load64(next)==load64("PUPV0001") && load64(next+8)==n && load64(next+16)==base && next_payload==next_bytes-base && next_bytes==old_bytes+(6912-3072)*4,"invalid high-resolution checkpoint");let old_sha=vc_digest(old,old_bytes);let next_sha=vc_digest(next,next_bytes);let receipt=vc_json_file(vc_path(directory,"receipt.json"));vc_require(pj_boolean(receipt,"passed") && pj_boolean(receipt,"otherTensorsCopiedExactly") && pj_boolean(receipt,"behaviorParityNotClaimed") && pl_equal(pj_string_field(receipt,"sourceWeightsSHA256"),old_sha) && pl_equal(pj_string_field(receipt,"weightsSHA256"),next_sha),"high-resolution checkpoint receipt mismatch");let compare=ffi_symbol(ffi_open("libc.so.6"),"memcmp");vc_require(compare,"memcmp unavailable");let old_offset=0;let next_offset=0;let transformed=0;let max_error=0;let i=0;
    while i<n {let a=old+32+i*256;let b=next+32+i*256;let count=load64(a+200);let next_count=load64(b+200);vc_require(!load8(a+191) && !load8(b+191) && pl_equal(a,b) && count>0 && load64(a+208)==old_offset && load64(b+208)==next_offset && old_offset<=old_payload && count<=(old_payload-old_offset)/4 && next_offset<=next_payload && next_count<=(next_payload-next_offset)/4,"checkpoint tensor directory mismatch");if pl_equal(a,"encoder.0.weight") {vc_require(!transformed && load64(a+192)==4 && load64(b+192)==4 && count==3072 && next_count==6912 && load64(a+216)==16 && load64(a+224)==3 && load64(a+232)==8 && load64(a+240)==8 && load64(b+216)==16 && load64(b+224)==3 && load64(b+232)==12 && load64(b+240)==12,"high-resolution convolution shape mismatch");let channel=0;while channel<48 {let before=0;let after=0;let j=0;while j<64 {before=f64_add(before,pb_read_float(old+base+old_offset+(channel*64+j)*4));j=j+1;}j=0;while j<144 {after=f64_add(after,pb_read_float(next+base+next_offset+(channel*144+j)*4));j=j+1;}let error=f64_magnitude(f64_sub(before,after));max_error=pb_fmax(max_error,error);vc_require(f64_is_finite(error) && f64_lt(error,vc_number(1,100000)),"constant-input convolution response changed");let expected=f64_mul(pb_read_float(old+base+old_offset+channel*64*4),vc_number(4,9));let corner=pb_read_float(next+base+next_offset+channel*144*4);vc_require(f64_lt(f64_magnitude(f64_sub(expected,corner)),vc_number(1,1000000)),"interpolated convolution corner differs");channel=channel+1;}transformed=1;}else {vc_require(count==next_count && !ffi_call(compare,a,b,208,0,0,0) && !ffi_call(compare,a+216,b+216,40,0,0,0) && !ffi_call(compare,old+base+old_offset,next+base+next_offset,count*4,0,0,0),"non-convolution tensor changed");}old_offset=old_offset+count*4;next_offset=next_offset+next_count*4;i=i+1;}
    vc_require(transformed && old_offset==old_payload && next_offset==next_payload,"checkpoint payload mismatch");let text=alloc(1024);let b=alloc(32);pl_builder(b,text,1024);pl_text(b,"{\"passed\":true,\"sourceWeightsSHA256\":");pj_text(b,old_sha);pl_text(b,",\"weightsSHA256\":");pj_text(b,next_sha);pl_text(b,",\"tensors\":");pl_int(b,n);pl_text(b,",\"unchangedTensors\":");pl_int(b,n-1);pl_text(b,",\"constantInputMaxAbsError\":");pl_float(b,max_error);pl_text(b,",\"behaviorParityNotClaimed\":true}\n");vc_require(!load64(b+24),"high-resolution checkpoint audit overflow");vc_write(vc_absolute(load64(argv+24)),text,load64(b+8));return 0;
}

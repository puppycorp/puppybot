// Pack candidate target coordinates as training-only labels. Each coordinate
// is independently recomputed from its recorded camera and target position.
import "../../../flex/control/verify.flex";
fn vt_reference(run,frame,target,out) {
    let old=pj_arena;let used=pj_used;pj_arena=alloc(131072);let name=vc_concat(vc_concat("frame-",vc_int(frame)),".png.camera.json");let meta=vc_json_file(vc_path(vc_path(run,"sensor"),name));vc_require(vc_json_int(meta,"frameId",0)==frame && pl_equal(pj_string_field(meta,"view"),"tcp"),"target label camera frame differs");let basis=alloc(96);va_vector(pj_get(meta,"eyeM"),basis,3);va_vector(pj_get(meta,"forward"),basis+24,3);va_vector(pj_get(meta,"right"),basis+48,3);va_vector(pj_get(meta,"down"),basis+72,3);let z=0;let x=0;let y=0;let i=0;while i<3 {let d=f64_sub(load64(target+i*8),load64(basis+i*8));z=f64_add(z,f64_mul(d,load64(basis+24+i*8)));x=f64_add(x,f64_mul(d,load64(basis+48+i*8)));y=f64_add(y,f64_mul(d,load64(basis+72+i*8)));i=i+1;}vc_require(f64_gt(z,vc_number(1,100)),"target label is behind camera");let intrinsics=pj_get(meta,"intrinsics");store64(out,f64_add(pj_real(intrinsics,"cx"),f64_mul(pj_real(intrinsics,"fx"),f64_div(x,z))));store64(out+8,f64_add(pj_real(intrinsics,"cy"),f64_mul(pj_real(intrinsics,"fy"),f64_div(y,z))));store64(out+16,z);syscall(11,basis,96,0,0,0,0);syscall(11,pj_arena,131072,0,0,0,0);pj_arena=old;pj_used=used;pj_error=0;return 0;
}
fn vt_initial(run,target) {
    let old=pj_arena;let used=pj_used;pj_arena=alloc(131072);let initial=vc_json_file(vc_path(run,"initial.json"));let frame=vc_json_int(initial,"totalSteps",0);va_vector(pj_get(pj_index(pj_get(pj_get(initial,"case"),"objects"),0),"position"),target,3);syscall(11,pj_arena,131072,0,0,0,0);pj_arena=old;pj_used=used;pj_error=0;return frame;
}
fn vt_colour(rgb,x,y) {
    let cx=f64_to_i64_trunc(f64_mul(x,vc_number(84,640)));let cy=f64_to_i64_trunc(f64_mul(y,vc_number(84,480)));let pixel=alloc(3);let n=0;let j=pb_max(0,cy-3);while j<=pb_min(83,cy+3) {let i=pb_max(0,cx-3);while i<=pb_min(83,cx+3) {let c=0;while c<3 {store8(pixel+c,load8(rgb+(c*84+j)*84+i));c=c+1;}if va_brick_pixel(pixel) {n=n+1;}i=i+1;}j=j+1;}syscall(11,pixel,3,0,0,0,0);return n;
}
fn vt_candidate_size(path) {let fd=syscall(2,path,0,0,0,0,0);vc_require(fd>=0,"cannot open target candidates");let size=syscall(8,fd,0,2,0,0,0);syscall(3,fd,0,0,0,0,0);vc_require(size>=0 && size<=VC_MAX_FILE_BYTES,"target candidate file size is invalid");return size;}
fn vt_candidate_sha(path,size) {if size {return vc_file_sha(path);}let empty=alloc(1);let sha=vc_digest(empty,0);syscall(11,empty,1,0,0,0,0);return sha;}
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==8 || (argc==9 && pl_equal(load64(argv+64),"--allow-empty-splits")),"prepare DATA RUNS CANDIDATES SURVEY SOURCE_SHA CANDIDATES_SHA NEW_OUTPUT [--allow-empty-splits]");let allow_empty=argc==9;let data_path=vc_absolute(load64(argv+8));let runs=vc_absolute(load64(argv+16));let candidates=vc_absolute(load64(argv+24));let survey=vc_absolute(load64(argv+32));let source_sha=load64(argv+40);let candidate_sha=load64(argv+48);let output=vc_absolute(load64(argv+56));vc_require(pl_size(source_sha)==64 && pl_size(candidate_sha)==64,"target preparation requires SHA256 values");let data=vc_map(data_path);let bytes=vc_size;let n=load64(data+8);let fit=load64(data+16);let length=load64(data+24);vc_require(vd_row_bytes(data)==56 && n>=2 && n<=256 && fit>=1 && fit<n && length>=1 && length<=512 && bytes==32+n*length*21224 && pl_equal(vc_digest(data,bytes),source_sha),"target source data or hash differs");let candidate_size=vt_candidate_size(candidates);vc_require(pl_equal(vt_candidate_sha(candidates,candidate_size),candidate_sha),"target candidate survey hash differs");let report=vc_json_file(survey);let roles=pj_get(report,"roles");vc_require(vc_json_int(report,"episodes",0)==n && pj_boolean(report,"actorInputsUnchanged") && pl_equal(pj_string_field(report,"sourceDataSHA256"),source_sha) && pj_count(roles)==2 && pl_equal(pj_string_field(pj_index(roles,0),"role"),"fitting") && pl_equal(pj_string_field(pj_index(roles,1),"role"),"validation"),"target survey report differs from source");let expected_fit=vc_json_int(pj_index(roles,0),"alsoInsideFreshColourDetection",0);let expected_val=vc_json_int(pj_index(roles,1),"alsoInsideFreshColourDetection",0);vc_require(expected_fit>=0 && expected_val>=0 && (allow_empty || (expected_fit>0 && expected_val>0)),"target survey split has no candidates");vc_mkdir(output);
    let size=32+n*length*12;let labels=alloc(size);pb_zero(labels,size);vc_copy(labels,"PVVIS001",8);store64(labels+8,n);store64(labels+16,fit);store64(labels+24,length);let target=alloc(24);let point=alloc(24);let compare=ffi_symbol(ffi_open("libc.so.6"),"memcmp");vc_require(compare,"memcmp unavailable");let episode=-1;let first=0;let previous=-1;let seen_fit=0;let seen_val=0;let records=0;let row=0;if candidate_size {va_lines(candidates);row=va_next();}
    while row {let index=vc_json_int(row,"episode",0);let t=vc_json_int(row,"actionIndex",0);let frame=vc_json_int(row,"frame",0);let candidate_x=pj_real(row,"sensorX");let candidate_y=pj_real(row,"sensorY");let candidate_z=pj_real(row,"depthM");let pixels=vc_json_int(row,"saturatedPixels",0);vc_require(index>=0 && index<n && t>=0 && t<length && pixels>=2 && pj_boolean(row,"validation")== (index>=fit),"target candidate role or index invalid");let ordinal=index*length+t;vc_require(ordinal>previous,"target candidate ordering or uniqueness violated");previous=ordinal;let run=vc_path(runs,vc_concat("expert-",vc_int(index)));if index!=episode {episode=index;first=vt_initial(run,target);}vc_require(frame==first+t*10,"target candidate frame misaligned");let base=data+32+index*length*21224;let source=base+length*21168+t*56;vc_require(vd_valid_word(source,56)==0x3f800000 && !pb_u32(source+36) && !pb_u32(source+24),"target candidate references padding or post-consumption frame");vt_reference(run,frame,target,point);let epsilon=vc_number(1,1000000);vc_require(f64_lt(f64_magnitude(f64_sub(candidate_x,load64(point))),epsilon) && f64_lt(f64_magnitude(f64_sub(candidate_y,load64(point+8))),epsilon) && f64_lt(f64_magnitude(f64_sub(candidate_z,load64(point+16))),epsilon),"target candidate differs from physical camera projection");vc_require(f64_ge(candidate_x,0) && f64_lt(candidate_x,f64_from_i64(640)) && f64_ge(candidate_y,0) && f64_lt(candidate_y,f64_from_i64(480)),"target candidate lies outside image");let image=vc_map(vc_path(run,vc_concat("actor-",vc_concat(vc_int(frame),".rgb"))));vc_require(vc_size==21168 && !ffi_call(compare,image,base+t*21168,21168,0,0,0) && vt_colour(image,candidate_x,candidate_y)==pixels,"target candidate does not match source RGB or recorded local colour");syscall(11,image,21168,0,0,0,0);let at=labels+32+ordinal*12;pb_put32(at,pb_f64_to_f32(f64_sub(f64_div(candidate_x,f64_from_i64(320)),PB_ONE)));pb_put32(at+4,pb_f64_to_f32(f64_sub(f64_div(candidate_y,f64_from_i64(240)),PB_ONE)));pb_put32(at+8,0x3f800000);if index<fit {seen_fit=seen_fit+1;}else {seen_val=seen_val+1;}records=records+1;row=va_next();
    }
    vc_require(records==expected_fit+expected_val && seen_fit==expected_fit && seen_val==expected_val,"target candidate totals differ from accepted survey");vc_write(vc_path(output,"targets.bin"),labels,size);let text=alloc(4096);let b=alloc(32);pl_builder(b,text,4096);pl_text(b,"{\"passed\":true,\"runtime\":\"Flexscript\",\"pythonRequired\":false,\"sourceDataSHA256\":");pj_text(b,source_sha);pl_text(b,",\"candidateManifestSHA256\":");pj_text(b,candidate_sha);pl_text(b,",\"targetsSHA256\":");pj_text(b,vc_digest(labels,size));pl_text(b,",\"episodes\":");pl_int(b,n);pl_text(b,",\"fittingHistories\":");pl_int(b,fit);pl_text(b,",\"validationHistories\":");pl_int(b,n-fit);pl_text(b,",\"sequenceLength\":");pl_int(b,length);pl_text(b,",\"fittingCandidates\":");pl_int(b,seen_fit);pl_text(b,",\"validationCandidates\":");pl_int(b,seen_val);if allow_empty {pl_text(b,",\"allowEmptyCandidateSplits\":true");}pl_text(b,",\"projectionAndPixelsIndependentlyRechecked\":true,\"visibilityHeuristicNotProvenSegmentation\":true,\"actorInputsUnchanged\":true}\n");vc_require(!load64(b+24),"target label receipt overflow");vc_write(vc_path(output,"receipt.json"),text,load64(b+8));return 0;
}

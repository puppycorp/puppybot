// Replay an audited episode and change only contact feedback for sampled steps.
import "../../../flex/control/verify.flex";
import "../../../flex/control/actions.flex";
fn main(argc,argv) {
    vc_init(argc,argv);vc_pixels_init();vc_require(argc==4,"contact-intervention POLICY AUTONOMOUS_EPISODE NEW_OUTPUT");let policy=vc_absolute(load64(argv+8));let run=vc_absolute(load64(argv+16));let output=vc_absolute(load64(argv+24));vc_mkdir(output);let meta=vc_json_file(vc_path(policy,"receipt.json"));let sha=vc_string(pj_string_field(meta,"weightsSHA256"));vc_require(pl_equal(vc_file_sha(vc_path(policy,"weights.bin")),sha) && pl_equal(vc_file_sha(vc_path(policy,"policy")),pj_string_field(meta,"binarySHA256")),"policy hash mismatch");
    let audit=vc_json_file(vc_path(run,"../verified/result.json"));vc_require(pj_boolean(audit,"passed") && !pj_real(audit,"commandReplayMaxAbsError") && pl_equal(pj_string_field(audit,"weightsSHA256"),sha),"intervention requires an audited autonomous history");
    let args=vc_args();vc_add(args,vc_path(policy,"policy"));vc_add(args,vc_path(policy,"weights.bin"));vc_add(args,sha);vc_add(args,vc_path(policy,"kernels"));vc_add(args,"3");vc_add(args,"--raw");let process=vc_spawn(args,vc_path(output,"policy.log"),0,1);let magic=alloc(8);vc_io(1,load64(process+8),magic,8);vc_require(load64(magic)==load64("VCPRAW01"),"policy handshake mismatch");
    let hidden=alloc(512);let input=alloc((21168+7+128)*4);let response=alloc(135*4);let alternate=alloc(135*4);let decoded=alloc(8);let other_decoded=alloc(8);let initial=vc_json_file(vc_path(run,"initial.json"));let frame=vc_json_int(initial,"totalSteps",0);va_lines(vc_path(run,"decisions.jsonl"));let row=va_next();let text=alloc(65536);let b=alloc(32);pl_builder(b,text,65536);pl_text(b,"{\"weightsSHA256\":");pj_text(b,sha);pl_text(b,",\"scope\":\"Single-step contact feedback intervention on recorded recurrent states, not a new rollout\",\"samples\":[");let t=0;let contacts=0;let samples=0;let changed=0;
    while row {vc_require(t<512,"episode exceeds task bound");let rgb=vc_map(vc_path(run,vc_concat("actor-",vc_concat(vc_int(frame),".rgb"))));vc_require(vc_size==21168,"invalid RGB");let own=vc_map(vc_path(run,vc_concat("actor-",vc_concat(vc_int(frame),".feedback"))));vc_require(vc_size==28 && !pb_u32(own+24),"invalid feedback");vc_policy_input(rgb,own,hidden,input,0);vc_io(0,load64(process+8),input,(21168+7+128)*4);vc_io(1,load64(process+8),response,135*4);let kind=ca_decode(response,decoded);let action=pj_get(row,"action");vc_require(kind>=0 && pb_u32(decoded)==pb_f64_to_f32(pj_real_node(pj_index(action,0))) && pb_u32(decoded+4)==pb_f64_to_f32(pj_real_node(pj_index(action,1))),"action differs from recording");
        if pb_u32(own+20) {if contacts%10==0 && samples<20 {pb_put32(input+(21168+5)*4,0);vc_io(0,load64(process+8),input,(21168+7+128)*4);vc_io(1,load64(process+8),alternate,135*4);let other=ca_decode(alternate,other_decoded);vc_require(other>=0,"invalid alternate action");let delta=0;let i=0;while i<7 {let difference=f64_magnitude(f64_sub(pb_read_float(response+i*4),pb_read_float(alternate+i*4)));if f64_gt(difference,delta) {delta=difference;}i=i+1;}if kind!=other {changed=changed+1;}if samples {pl_char(b,44);}pl_text(b,"{\"actionIndex\":");pl_int(b,t);pl_text(b,",\"actualClass\":");pl_int(b,kind);pl_text(b,",\"withoutContactClass\":");pl_int(b,other);pl_text(b,",\"maxLogitDifference\":");pl_float(b,delta);pl_char(b,125);samples=samples+1;}contacts=contacts+1;}
        vc_copy(hidden,response+28,512);syscall(11,rgb,21168,0,0,0,0);syscall(11,own,28,0,0,0,0);frame=vc_json_int(row,"step",0);t=t+1;row=va_next();
    }pl_text(b,"],\"replayedActions\":");pl_int(b,t);pl_text(b,",\"contactFrames\":");pl_int(b,contacts);pl_text(b,",\"sampledFrames\":");pl_int(b,samples);pl_text(b,",\"changedActions\":");pl_int(b,changed);pl_text(b,",\"actualCommandsReplayedExactly\":true}\n");vc_require(!load64(b+24),"intervention report overflow");vc_finish(process,15000);vc_write(vc_path(output,"result.json"),text,load64(b+8));return 0;
}

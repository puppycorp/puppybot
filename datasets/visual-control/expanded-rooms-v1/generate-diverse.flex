// Seeded additional training and validation rooms. Layout and role never enter
// the actor; they configure only the simulator and offline teacher.
import "../../../flex/control/scene.flex";
global dv_params=0;
global dv_wide_heading=0;
fn dv_parameters(layout) {
    dv_params=alloc(15*8);vc_rng=(layout*1103515245+1234567)&2147483647;
    store64(dv_params,vc_uniform(vc_number(36,10),vc_number(46,10)));store64(dv_params+8,vc_uniform(vc_number(27,10),vc_number(35,10)));
    store64(dv_params+16,vc_uniform(vc_number(13,10),vc_number(18,10)));store64(dv_params+24,vc_uniform(vc_number(-7,10),vc_number(7,10)));store64(dv_params+32,vc_uniform(vc_number(7,10),vc_number(9,10)));
    store64(dv_params+40,vc_uniform(vc_number(-1,10),vc_number(1,10)));store64(dv_params+48,vc_uniform(vc_number(-1,10),vc_number(1,10)));let heading=vc_uniform(vc_number(-4,10),vc_number(4,10));if dv_wide_heading {heading=f64_mul(heading,f64_div(PB_PI,vc_number(4,10)));}store64(dv_params+56,heading);
    store64(dv_params+64,vc_uniform(vc_number(42,100),vc_number(70,100)));store64(dv_params+72,vc_uniform(vc_number(30,100),vc_number(55,100)));store64(dv_params+80,vc_uniform(vc_number(20,100),vc_number(42,100)));
    store64(dv_params+88,vc_uniform(pb_neg(f64_sub(load64(dv_params),vc_number(85,100))),vc_number(-13,10)));store64(dv_params+96,vc_uniform(pb_neg(f64_sub(load64(dv_params+8),vc_number(85,100))),f64_sub(load64(dv_params+8),vc_number(85,100))));
    store64(dv_params+104,vc_uniform(vc_number(20,100),vc_number(38,100)));store64(dv_params+112,vc_uniform(vc_number(20,100),vc_number(38,100)));return dv_params;
}
fn dv_environment(path,layout) {
    let hx=load64(dv_params);let hy=load64(dv_params+8);vc_boxes=alloc(32*128);vc_box_count=0;
    vc_box("Floor",0,0,vc_number(-16,1000),hx,hy,vc_number(16,1000),load64(dv_params+64),load64(dv_params+72),load64(dv_params+80),0,0);
    vc_wall("Wall.west",pb_neg(hx),0,vc_number(6,100),hy);vc_wall("Wall.east",hx,0,vc_number(6,100),hy);vc_wall("Wall.south",0,pb_neg(hy),hx,vc_number(6,100));vc_wall("Wall.north",0,hy,hx,vc_number(6,100));
    if layout%2 {let x=load64(dv_params+16);let low=f64_sub(load64(dv_params+24),load64(dv_params+32));let high=f64_add(load64(dv_params+24),load64(dv_params+32));
        vc_wall("Wall.partition-a",x,f64_mul(f64_sub(low,hy),vc_number(1,2)),vc_number(6,100),f64_mul(f64_add(low,hy),vc_number(1,2)));
        vc_wall("Wall.partition-b",x,f64_mul(f64_add(high,hy),vc_number(1,2)),vc_number(6,100),f64_mul(f64_sub(hy,high),vc_number(1,2)));}
    vc_box("Obstacle",load64(dv_params+88),load64(dv_params+96),vc_number(30,100),load64(dv_params+104),load64(dv_params+112),vc_number(30,100),vc_number(35,100),vc_number(41,100),vc_number(47,100),1,0);
    let count=vc_box_count-1;let vertices=vc_box_count*36;let bytes=256+count*128+vertices*72;let data=alloc(bytes);pb_zero(data,bytes);vc_copy(data,"PBENV001",8);store64(data+8,count);store64(data+16,vertices);store64(data+24,vertices);store64(data+64,pb_neg(hx));store64(data+72,pb_neg(hy));store64(data+80,hx);store64(data+88,hy);store64(data+96,load64(dv_params+40));store64(data+104,load64(dv_params+48));store64(data+112,load64(dv_params+56));let name=vc_concat("Diverse room ",vc_int(layout));vc_copy(data+128,name,pl_size(name));let full=data+256+count*128;let overview=full+vertices*36;let i=0;
    while i<vc_box_count {let record=vc_boxes+i*128;if i {vc_copy(data+256+(i-1)*128,record,96);}vc_mesh_box(record,full+i*36*36,overview+i*36*36);i=i+1;}
    vc_write(path,data,bytes);syscall(11,data,bytes,0,0,0,0);syscall(11,vc_boxes,32*128,0,0,0,0);return 0;
}
fn dv_layout(path,layout,fit) {
    let hx=load64(dv_params);let hy=load64(dv_params+8);let edge=hx;if layout%2 {edge=load64(dv_params+16);}let text=alloc(4096);let b=alloc(32);pl_builder(b,text,4096);pl_text(b,"{\"generator\":\"diverse-v1\",\"layoutId\":");pl_int(b,layout);pl_text(b,",\"fit\":");pj_bool_text(b,fit);pl_text(b,",\"startRoom\":0,\"rooms\":[[");pl_float(b,pb_neg(hx));pl_char(b,44);pl_float(b,pb_neg(hy));pl_char(b,44);pl_float(b,edge);pl_char(b,44);pl_float(b,hy);pl_char(b,93);
    if layout%2 {pl_text(b,",");pl_char(b,91);pl_float(b,edge);pl_char(b,44);pl_float(b,pb_neg(hy));pl_char(b,44);pl_float(b,hx);pl_char(b,44);pl_float(b,hy);pl_char(b,93);}pl_text(b,"],\"door\":");if layout%2 {pl_char(b,91);pl_float(b,load64(dv_params+16));pl_char(b,44);pl_float(b,load64(dv_params+24));pl_char(b,44);pl_float(b,load64(dv_params+32));pl_char(b,93);}else {pl_text(b,"null");}
    pl_text(b,",\"startPose\":[");pl_float(b,load64(dv_params+40));pl_char(b,44);pl_float(b,load64(dv_params+48));pl_char(b,44);pl_float(b,load64(dv_params+56));pl_text(b,"],\"obstacles\":[[");pl_float(b,load64(dv_params+88));pl_char(b,44);pl_float(b,load64(dv_params+96));pl_char(b,44);pl_float(b,load64(dv_params+104));pl_char(b,44);pl_float(b,load64(dv_params+112));pl_text(b,"]]");if dv_wide_heading {pl_text(b,",\"wideHeading\":true");}pl_text(b,"}\n");vc_require(!load64(b+24),"diverse layout metadata overflow");vc_write(path,text,load64(b+8));return 0;
}
fn dv_case(path,layout,index) {
    let seed=11100000+layout*100+index;vc_case(path,"flex/sim/cases/find-return-house.json",seed,layout%2);let root=vc_json_file(path);let object=pj_index(pj_get(root,"objects"),0);let position=pj_get(object,"position");let xmin=vc_number(165,100);if layout%2 {xmin=f64_add(load64(dv_params+16),vc_number(85,100));}let xmax=f64_sub(load64(dv_params),vc_number(65,100));vc_require(f64_lt(xmin,xmax),"target room has no placement range");vc_set_number(pj_index(position,0),vc_uniform(xmin,xmax));vc_set_number(pj_index(position,1),vc_uniform(pb_neg(f64_sub(load64(dv_params+8),vc_number(65,100))),f64_sub(load64(dv_params+8),vc_number(65,100))));
    let color=pj_get(object,"color");let r=95;let g=22;let blue=22;let hue=index%6;if hue==1 {r=20;g=45;blue=95;}if hue==2 {r=100;g=82;blue=18;}if hue==3 {r=24;g=85;blue=38;}if hue==4 {r=68;g=28;blue=88;}if hue==5 {r=100;g=49;blue=12;}vc_set_number(pj_index(color,0),f64_from_i64(r));vc_set_number(pj_index(color,1),f64_from_i64(g));vc_set_number(pj_index(color,2),f64_from_i64(blue));let size=pj_get(object,"halfSize");vc_set_number(pj_index(size,0),vc_number(18+(index%5)*2,1000));vc_set_number(pj_index(size,1),vc_number(12+(index%3)*2,1000));vc_set_number(pj_get(object,"yawDegrees"),f64_from_i64(-60+(index*17+layout*11)%121));let text=alloc(16384);let b=alloc(32);pl_builder(b,text,16384);pj_emit(b,root);pl_char(b,10);vc_require(!pj_error && !load64(b+24),"diverse case metadata overflow");vc_write(path,text,load64(b+8));return 0;
}
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==5 || argc==6,"generate-diverse NEW_OUTPUT FIRST_LAYOUT END_LAYOUT fit|validation|development|wide-development [--wide-heading]");if argc==6 {vc_require(pl_equal(load64(argv+40),"--wide-heading"),"invalid heading option");dv_wide_heading=1;}let first=pl_integer(load64(argv+16),pl_size(load64(argv+16)));vc_require(!pl_bad_number,"invalid first layout");let end=pl_integer(load64(argv+24),pl_size(load64(argv+24)));vc_require(!pl_bad_number && end>first,"invalid end layout");let role=load64(argv+32);let fit=pl_equal(role,"fit");let validation=pl_equal(role,"validation");let development=pl_equal(role,"development");let wide_development=pl_equal(role,"wide-development");vc_require(fit || validation || development || wide_development,"invalid dataset role");vc_require((fit && first>=26 && end<=126) || (validation && first>=126 && end<=218 && (end<=180 || first>=188)) || (development && !dv_wide_heading && first>=180 && end<=188) || (wide_development && dv_wide_heading && first>=218 && end<=226),"layout IDs must use their disjoint role ranges");let output=vc_absolute(load64(argv+8));vc_mkdir(output);let layout=first;
    while layout<end {dv_parameters(layout);let root=vc_path(output,vc_int(layout));vc_mkdir(root);let environment=vc_path(root,"environment.bin");let metadata=vc_path(root,"layout.json");dv_environment(environment,layout);dv_layout(metadata,layout,fit);let i=0;while i<16 {let scene=vc_path(root,vc_int(i));vc_mkdir(scene);dv_case(vc_path(scene,"case.json"),layout,i);vc_require(!syscall(88,environment,vc_path(scene,"environment.bin"),0,0,0,0) && !syscall(88,metadata,vc_path(scene,"layout.json"),0,0,0,0),"cannot link diverse scene files");i=i+1;}syscall(11,dv_params,15*8,0,0,0,0);layout=layout+1;}pl_print(1,"Generated reproducible diverse rooms.\n");return 0;
}

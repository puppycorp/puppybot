// Count actual action labels and their effective current training-loss weights.
import "../../../flex/control/dataset.flex";
import "../../../flex/control/actions.flex";
import "../../../flex/control/action-weight.flex";
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc==3,"action-survey DATA OUTPUT");let data=vc_map(vc_absolute(load64(argv+8)));let bytes=vc_size;let n=load64(data+8);let fit=load64(data+16);let length=load64(data+24);let row_bytes=vd_row_bytes(data);
    vc_require(row_bytes==56 && n>=2 && n<=256 && fit>=1 && fit<n && length>=1 && length<=512 && bytes==32+n*length*21224,"invalid action survey data");let counts=alloc(2*7*8);let weights=alloc(2*7*8);let phases=alloc(2*2*7*8);let i=0;
    while i<n {let group=0;if i>=fit {group=1;}let base=data+32+i*length*21224;let t=0;while t<length {let row=base+length*21168+t*56;if vd_valid_word(row,56) && pb_u32(row+40) {let speed=pb_read_float(row+32);let previous=pb_read_float(row+4);let kind=ca_class(pb_read_float(row+28),speed);vc_require(kind>=0 && (pb_u32(row+36)==0 || pb_u32(row+36)==0x3f800000),"invalid supervised action or phase");let phase=pb_u32(row+36)!=0;let at=group*7+kind;let weight=f64_to_i64_nearest(pt_control_weight(PB_ONE,speed,previous));store64(counts+at*8,load64(counts+at*8)+1);store64(weights+at*8,load64(weights+at*8)+weight);let pa=group*14+phase*7+kind;store64(phases+pa*8,load64(phases+pa*8)+1);}t=t+1;}i=i+1;}
    let text=alloc(4096);let b=alloc(32);pl_builder(b,text,4096);pl_text(b,"{\"runtime\":\"Flexscript\",\"pythonRequired\":false,\"sourceDataSHA256\":");pj_text(b,vc_digest(data,bytes));pl_text(b,",\"classes\":[\"forward-left\",\"forward\",\"forward-right\",\"reverse-left\",\"reverse\",\"reverse-right\",\"stop\"],\"weighting\":\"stop x5; speed transition x8\",\"splits\":[");let group=0;
    while group<2 {if group {pl_char(b,44);}pl_text(b,"{\"role\":");if group {pj_text(b,"validation");}else {pj_text(b,"fitting");}let field=0;while field<4 {if field==0 {pl_text(b,",\"counts\":[");}else if field==1 {pl_text(b,",\"effectiveWeights\":[");}else if field==2 {pl_text(b,",\"searchCounts\":[");}else {pl_text(b,",\"returnCounts\":[");}let j=0;while j<7 {if j {pl_char(b,44);}let at=group*7+j;let value=load64(counts+at*8);if field==1 {value=load64(weights+at*8);}else if field>=2 {value=load64(phases+(group*14+(field-2)*7+j)*8);}pl_int(b,value);j=j+1;}pl_char(b,93);field=field+1;}pl_char(b,125);group=group+1;}
    pl_text(b,"]}\n");vc_require(!load64(b+24),"action survey output overflow");vc_write(vc_absolute(load64(argv+16)),text,load64(b+8));return 0;
}

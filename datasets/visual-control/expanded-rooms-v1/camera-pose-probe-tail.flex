// Appended to the simulator entry with its application main renamed. This is
// an offline simulated arm survey, not a physical-robot collision test.
fn main(argc,argv) {
    if !pl_init() || argc!=4 {return 2;}h_environment(argc,argv);let pitch=pl_integer(load64(argv+8),pl_size(load64(argv+8)));if pl_bad_number {return 2;}let height=pl_integer(load64(argv+16),pl_size(load64(argv+16)));if pl_bad_number {return 2;}let radial=pl_integer(load64(argv+24),pl_size(load64(argv+24)));if pl_bad_number {return 2;}
    if !ps_model_load("build/flex/sim/puppybot.bin") || !ps_environment_load("build/flex/sim/environments/apartment/apartment.bin") || !ps_environment_spawn("[0,0,0]") {return 3;}
    ps_robot=alloc(8192);ps_system=alloc(2048);ps_config=alloc(448);ps_app=alloc(2048);ps_bus=alloc(16384);ps_plant=alloc(2048);ps_trace=alloc(69632);ps_json=alloc(16384);ps_builder=alloc(32);pb_config_default(ps_config);pb_vset(ps_config+40,2,5);ps_previews=0;ps_camera_mode=2;ps_agent_fd=3;if !ps_reset() {return 4;}
    if !ps_pickup_targets {ps_pickup_targets=alloc(32);}let point=alloc(24);ps_camera_compact_point(point,ps_pose_heading(),ps_number(radial,1000));let reachable=ps_arm_target(point,height,pitch);ps_camera_drive_mode=1;let steps=0;let stable=0;let tick_ok=1;
    while reachable && tick_ok && steps<1500 && stable<15 {if !ps_tick(0) {tick_ok=0;}if gs_reached(ps_plant,ps_pickup_targets) && gs_stopped(ps_plant) {stable=stable+1;}else {stable=0;}steps=steps+1;}
    let settled=reachable && tick_ok && stable>=15;let camera=alloc(96);if settled {ps_local_camera(camera);}let text=alloc(2048);let b=alloc(32);pl_builder(b,text,2048);pl_text(b,"{\"pitchArgumentDeg\":");pl_int(b,pitch);pl_text(b,",\"targetHeightMm\":");pl_int(b,height);pl_text(b,",\"radialMm\":");pl_int(b,radial);pl_text(b,",\"ikReachable\":");pj_bool_text(b,reachable);pl_text(b,",\"settled\":");pj_bool_text(b,settled);pl_text(b,",\"ticks\":");pl_int(b,steps);pl_text(b,",\"physicsFault\":");pl_int(b,load64(ps_physics+192));pl_text(b,",\"eyeAndAxes\":[");let i=0;while i<12 {if i {pl_char(b,44);}pl_float(b,load64(camera+i*8));i=i+1;}pl_text(b,"],\"simulatedOnly\":true}\n");if load64(b+24) {return 5;}pl_write(1,text,load64(b+8));ph_world_close(ps_physics);ps_environment_close();return 0;
}

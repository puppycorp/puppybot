// Preserve independently checked target labels across an audited dense merge.
import "../../../flex/control/target-supervision.flex";
fn mn_zero(data,size,zero,compare) {
    let offset=0;while offset<size {let n=pb_min(4096,size-offset);vc_require(!ffi_call(compare,data+offset,zero,n,0,0,0),"merged dataset padding is not zero");offset=offset+n;}return 0;
}
fn main(argc,argv) {
    vc_init(argc,argv);vc_require(argc>=7 && argc<=35 && !((argc-3)%2),"merge-targets-many MERGED_DIR OUTPUT DATA TARGETS [DATA TARGETS ...]");pj_capacity=1048576;let count=(argc-3)/2;let datasets=alloc(count*8);let targets=alloc(count*8);let counts=alloc(count*8);let fits=alloc(count*8);let lengths=alloc(count*8);let hashes=alloc(count*8);let label_hashes=alloc(count*8);let total=0;let fitting=0;let length=0;let fit_candidates=0;let validation_candidates=0;let source=0;
    while source<count {let path=vc_absolute(load64(argv+(3+source*2)*8));let directory=vc_absolute(load64(argv+(4+source*2)*8));let data=vd_map(path);let bytes=vc_size;vc_require(bytes>=32,"invalid target source header");let n=load64(data+8);let fit=load64(data+16);let steps=load64(data+24);
        vc_require(vd_row_bytes(data)==56 && n>=2 && n<=vd_episode_limit(data) && fit>=1 && fit<n && steps>=1 && steps<=512 && bytes==32+n*steps*21224,"invalid target source data");pt_target_open_for_merge(directory,data,bytes,56);let receipt=vc_json_file(vc_path(directory,"receipt.json"));
        store64(datasets+source*8,data);store64(targets+source*8,pt_target_data);store64(counts+source*8,n);store64(fits+source*8,fit);store64(lengths+source*8,steps);store64(hashes+source*8,vc_digest(data,bytes));store64(label_hashes+source*8,vc_string(pj_string_field(receipt,"targetsSHA256")));
        fit_candidates=fit_candidates+vc_json_int(receipt,"fittingCandidates",0);validation_candidates=validation_candidates+vc_json_int(receipt,"validationCandidates",0);total=total+n;fitting=fitting+fit;length=pb_max(length,steps);source=source+1;
    }
    vc_require(fit_candidates>0 && validation_candidates>0,"aggregate target-position split is empty");
    let directory=vc_absolute(load64(argv+8));let data=vd_map(vc_path(directory,"data.bin"));let bytes=vc_size;vc_require(bytes>=32,"invalid aggregate data header");let n=load64(data+8);let fit=load64(data+16);let report=vc_json_file(vc_path(directory,"report.json"));let records=pj_get(report,"records");let source_hashes=pj_get(report,"sourceSHA256");
    vc_require(vd_row_bytes(data)==56 && n<=vd_episode_limit(data) && n==total && fit==fitting && fit>=1 && fit<n && load64(data+24)==length && bytes==32+n*length*21224 && pj_boolean(report,"preservesFitValidationSplits") && pj_count(records)==n && pj_count(source_hashes)==count && pl_equal(pj_string_field(report,"dataSHA256"),vc_digest(data,bytes)),"aggregate receipt or dimensions differ");source=0;while source<count {vc_require(pl_equal(pj_value(pj_index(source_hashes,source)),load64(hashes+source*8)),"aggregate source hash differs");source=source+1;}
    let compare=ffi_symbol(ffi_open("libc.so.6"),"memcmp");vc_require(compare,"memcmp unavailable");let zero=alloc(4096);let labels=alloc(32+n*length*12);vc_copy(labels,"PVVIS001",8);store64(labels+8,n);store64(labels+16,fit);store64(labels+24,length);let split=0;let target=0;
    while split<2 {source=0;while source<count {let input=load64(datasets+source*8);let input_labels=load64(targets+source*8);let steps=load64(lengths+source*8);let i=0;let end=load64(fits+source*8);if split {i=end;end=load64(counts+source*8);}
        while i<end {let record=pj_index(records,target);vc_require(vc_json_int(record,"index",0)==target && vc_json_int(record,"source",0)==source && vc_json_int(record,"sourceIndex",0)==i && pj_boolean(record,"fit")==!split,"aggregate split mapping differs");let from=input+32+i*steps*21224;let to=data+32+target*length*21224;
            vc_require(!ffi_call(compare,from,to,steps*21168,0,0,0) && !ffi_call(compare,from+steps*21168,to+length*21168,steps*56,0,0,0),"aggregate changed source history");mn_zero(to+steps*21168,(length-steps)*21168,zero,compare);mn_zero(to+length*21168+steps*56,(length-steps)*56,zero,compare);
            vc_copy(labels+32+target*length*12,input_labels+32+i*steps*12,steps*12);target=target+1;i=i+1;
        }source=source+1;}split=split+1;}
    vc_require(target==n && !pj_error,"aggregate target mapping is invalid");let output=vc_absolute(load64(argv+16));vc_mkdir(output);let size=32+n*length*12;vc_write(vc_path(output,"targets.bin"),labels,size);let text=alloc(4096);let b=alloc(32);pl_builder(b,text,4096);
    pl_text(b,"{\"passed\":true,\"runtime\":\"Flexscript\",\"pythonRequired\":false,\"sourceDataSHA256\":");pj_text(b,vc_digest(data,bytes));pl_text(b,",\"targetsSHA256\":");pj_text(b,vc_digest(labels,size));pl_text(b,",\"sourceTargetSHA256\":[");source=0;while source<count {if source {pl_char(b,44);}pj_text(b,load64(label_hashes+source*8));source=source+1;}pl_text(b,"],\"episodes\":");pl_int(b,n);pl_text(b,",\"fittingHistories\":");pl_int(b,fit);pl_text(b,",\"validationHistories\":");pl_int(b,n-fit);pl_text(b,",\"sequenceLength\":");pl_int(b,length);pl_text(b,",\"fittingCandidates\":");pl_int(b,fit_candidates);pl_text(b,",\"validationCandidates\":");pl_int(b,validation_candidates);pl_text(b,",\"mergedDataAndPaddingChecked\":true,\"projectionAndPixelsIndependentlyRechecked\":true,\"visibilityHeuristicNotProvenSegmentation\":true,\"actorInputsUnchanged\":true}\n");
    vc_require(!load64(b+24),"merged target receipt exceeded limit");vc_write(vc_path(output,"receipt.json"),text,load64(b+8));pt_target_open(output,data,bytes,56);return 0;
}

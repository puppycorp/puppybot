// Compare recorded actions with neutralized drive feedback on the same
// recurrent state. The alternate feedback is hypothetical and never actuated.
import "../../../flex/control/verify.flex";
import "../../../flex/control/actions.flex";
fn main(argc,argv) {
    vc_init(argc,argv);vc_pixels_init();vc_require(argc==4,"large-feedback-probe POLICY AUTONOMOUS_EPISODE NEW_OUTPUT");let policy=vc_absolute(load64(argv+8));let run=vc_absolute(load64(argv+16));let output=vc_absolute(load64(argv+24));vc_mkdir(output);
    let meta=vc_json_file(vc_path(policy,"receipt.json"));let sha=vc_string(pj_string_field(meta,"weightsSHA256"));let width=128;if pj_get(meta,"memoryWidth") {width=vc_json_int(meta,"memoryWidth",0);}vc_require(width==256 && !pj_boolean(meta,"taskFeedback") && pl_equal(vc_file_sha(vc_path(policy,"weights.bin")),sha) && pl_equal(vc_file_sha(vc_path(policy,"policy")),pj_string_field(meta,"binarySHA256")),"feedback probe policy hash mismatch");
    let audit=vc_json_file(vc_path(run,"../verified/result.json"));vc_require(pj_boolean(audit,"passed") && !pj_real(audit,"commandReplayMaxAbsError") && pl_equal(pj_string_field(audit,"weightsSHA256"),sha),"feedback probe requires an audited autonomous history");
    let args=vc_args();vc_add(args,vc_path(policy,"policy"));vc_add(args,vc_path(policy,"weights.bin"));vc_add(args,sha);vc_add(args,vc_path(policy,"kernels"));vc_add(args,"3");vc_add(args,"--raw");let process=vc_spawn(args,vc_path(output,"policy.log"),0,1);let magic=alloc(8);vc_io(1,load64(process+8),magic,8);vc_require(load64(magic)==load64("VCR25601"),"feedback probe handshake mismatch");
    let hidden=alloc(1024);pb_zero(hidden,1024);let input=alloc((21168+7+256)*4);let actual=alloc(263*4);let altered=alloc(263*4);let repeated=alloc(263*4);let decoded=alloc(8);let alternative=alloc(8);let expected_feedback=alloc(28);let expected_rgb=0;
    let initial=vc_json_file(vc_path(run,"initial.json"));let frame=vc_json_int(initial,"totalSteps",0);let phase=vc_json_int(initial,"findReturn","consumedIndex")>=0;va_lines(vc_path(run,"decisions.jsonl"));let row=va_next();let text=alloc(131072);let b=alloc(32);pl_builder(b,text,131072);pl_text(b,"{\"weightsSHA256\":");pj_text(b,sha);pl_text(b,",\"metric\":\"Offline neutralized previous drive feedback on unchanged recorded memory; not a rollout\",\"rows\":[");let t=0;
    while row {vc_require(t<512,"feedback probe episode exceeds task bound");let rgb=vc_map(vc_path(run,vc_concat("actor-",vc_concat(vc_int(frame),".rgb"))));vc_require(vc_size==21168,"invalid feedback probe RGB");let own=vc_map(vc_path(run,vc_concat(vc_concat("actor-",vc_int(frame)),".feedback")));vc_require(vc_size==28 && !pb_u32(own+24),"invalid feedback probe own state");
        if expected_rgb {vc_require(pl_equal(vc_digest(rgb,21168),expected_rgb),"feedback probe RGB differs from recorded frame hash");let j=0;while j<28 {vc_require(load8(own+j)==load8(expected_feedback+j),"feedback probe own state differs from recorded feedback");j=j+1;}}
        vc_policy_input_dimensions(rgb,own,hidden,input,0,21168,256);vc_io(0,load64(process+8),input,(21168+7+256)*4);vc_io(1,load64(process+8),actual,263*4);let kind=ca_decode(actual,decoded);let action=pj_get(row,"action");vc_require(kind>=0 && pb_u32(decoded)==pb_f64_to_f32(pj_real_node(pj_index(action,0))) && pb_u32(decoded+4)==pb_f64_to_f32(pj_real_node(pj_index(action,1))),"feedback probe action differs from recording");
        let i=0;while i<5 {pb_put32(input+(21168+i)*4,0);i=i+1;}vc_io(0,load64(process+8),input,(21168+7+256)*4);vc_io(1,load64(process+8),altered,263*4);let alternative_kind=ca_decode(altered,alternative);vc_require(alternative_kind>=0,"invalid alternate action");
        vc_copy(input+21168*4,own,28);vc_io(0,load64(process+8),input,(21168+7+256)*4);vc_io(1,load64(process+8),repeated,263*4);i=0;while i<263*4 {vc_require(load8(actual+i)==load8(repeated+i),"counterfactual changed the raw policy server state");i=i+1;}
        if t {pl_char(b,44);}pl_text(b,"{\"actionIndex\":");pl_int(b,t);pl_text(b,",\"actualReturning\":");pj_bool_text(b,phase);pl_text(b,",\"actualClass\":");pl_int(b,kind);pl_text(b,",\"neutralFeedbackClass\":");pl_int(b,alternative_kind);pl_text(b,",\"neutralFeedbackChangesAction\":");pj_bool_text(b,alternative_kind!=kind);pl_char(b,125);
        let proprio=pj_get(row,"proprio");vc_require(pj_kind(proprio)==3 && pj_count(proprio)==7,"invalid recorded feedback");i=0;while i<7 {pb_put32(expected_feedback+i*4,pb_f64_to_f32(pj_real_node(pj_index(proprio,i))));i=i+1;}expected_rgb=vc_string(pj_string_field(row,"actorSHA256"));
        vc_copy(hidden,actual+28,1024);syscall(11,rgb,21168,0,0,0,0);syscall(11,own,28,0,0,0,0);frame=vc_json_int(row,"step",0);phase=vc_json_int(pj_get(row,"state"),"findReturn","consumedIndex")>=0;t=t+1;row=va_next();
    }
    pl_text(b,"],\"actualCommandsReplayedExactly\":true,\"counterfactualDidNotAlterServerState\":true,\"neutralFeedbackHypothetical\":true,\"offlineCounterfactualOnly\":true,\"simulatorPhaseUsedOnlyForAnalysis\":true}\n");vc_require(!load64(b+24),"feedback probe report overflow");vc_finish(process,15000);vc_write(vc_path(output,"result.json"),text,load64(b+8));return 0;
}

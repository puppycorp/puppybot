// Read one policy decision with an empty recurrent state. This is a local
// diagnostic, not a rollout or a measure of task success.
import "../../../flex/control/verify.flex";
import "../../../flex/control/actions.flex";
fn main(argc,argv) {
    vc_init(argc,argv);vc_pixels_init();vc_require(argc==5,"frame-probe POLICY RGB FEEDBACK NEW_OUTPUT");let policy=vc_absolute(load64(argv+8));let rgb=vc_map(vc_absolute(load64(argv+16)));vc_require(vc_size==21168,"invalid probe RGB");let own=vc_map(vc_absolute(load64(argv+24)));vc_require(vc_size==28 && !pb_u32(own+24),"invalid probe feedback");let output=vc_absolute(load64(argv+32));vc_mkdir(output);
    let receipt=vc_json_file(vc_path(policy,"receipt.json"));let sha=vc_string(pj_string_field(receipt,"weightsSHA256"));vc_require(pl_equal(vc_file_sha(vc_path(policy,"weights.bin")),sha) && pl_equal(vc_file_sha(vc_path(policy,"policy")),pj_string_field(receipt,"binarySHA256")),"probe policy hash mismatch");
    let args=vc_args();vc_add(args,vc_path(policy,"policy"));vc_add(args,vc_path(policy,"weights.bin"));vc_add(args,sha);vc_add(args,vc_path(policy,"kernels"));vc_add(args,"3");vc_add(args,"--raw");let process=vc_spawn(args,vc_path(output,"policy.log"),0,1);let magic=alloc(8);vc_io(1,load64(process+8),magic,8);vc_require(load64(magic)==load64("VCPRAW01"),"invalid raw policy handshake");
    let hidden=alloc(512);pb_zero(hidden,512);let input=alloc((21168+7+128)*4);let response=alloc(135*4);vc_policy_input(rgb,own,hidden,input,0);vc_io(0,load64(process+8),input,(21168+7+128)*4);vc_io(1,load64(process+8),response,135*4);let decoded=alloc(8);let action=ca_decode(response,decoded);vc_require(action>=0,"invalid policy logits");
    let max=pb_read_float(response);let i=1;while i<7 {let value=pb_read_float(response+i*4);vc_require(f64_is_finite(value),"nonfinite policy logit");max=pb_fmax(max,value);i=i+1;}let sum=0;i=0;while i<7 {sum=f64_add(sum,f64_exp(f64_sub(pb_read_float(response+i*4),max)));i=i+1;}
    let text=alloc(4096);let b=alloc(32);pl_builder(b,text,4096);pl_text(b,"{\"weightsSHA256\":");pj_text(b,sha);pl_text(b,",\"rgbSHA256\":");pj_text(b,vc_digest(rgb,21168));pl_text(b,",\"feedbackSHA256\":");pj_text(b,vc_digest(own,28));pl_text(b,",\"zeroRecurrentState\":true,\"actionClass\":");pl_int(b,action);pl_text(b,",\"action\":[");pl_float(b,pb_read_float(decoded));pl_char(b,44);pl_float(b,pb_read_float(decoded+4));pl_text(b,"],\"probabilities\":[");i=0;while i<7 {if i {pl_char(b,44);}pl_float(b,f64_div(f64_exp(f64_sub(pb_read_float(response+i*4),max)),sum));i=i+1;}pl_text(b,"],\"metric\":\"single-frame initial decision; not autonomous performance\"}\n");vc_require(!load64(b+24),"frame probe output overflow");vc_finish(process,15000);vc_write(vc_path(output,"result.json"),text,load64(b+8));return 0;
}
